  if bigButton(X, y - 2, 88, 24, uSt.cz.plateOn and "حدّث" or "أظهر", ACC, "##czplok") then
    uSt.cz.plateOn = true; uSt.czRefresh(); uSt.czSave(); uSt.czBroadcast()
    uSt.cz.status = uSt.czCanvP and "✓ اللوحة ظاهرة — اضبط ارتفاع/بُعد لو ما بانت" or "✗ تعذّر إنشاء اللوحة"
  end
  if uSt.cz.plateOn and bigButton(X, y + 24, 88, 16, "أخفها", rgbm(0.5, 0.3, 0.32, 1), "##czploff") then
    uSt.cz.plateOn = false; uSt.czCanvP = nil; uSt.czBroadcast()
  end
  y = y + 26
  dwRightBox("خلفية", 10, X + W - 46, y + 2, 44, 12, CDm)
  local pb = uSt.czSwatches("##czpbg", X, y, W - 50, c.pBg)
  if pb then c.pBg = pb; uSt.czRefresh(); uSt.czSave(); uSt.czBroadcast() end
  y = y + swH
  dwRightBox("الخط", 10, X + W - 46, y + 2, 44, 12, CDm)
  local pf = uSt.czSwatches("##czpfg", X, y, W - 50, c.pFg)
  if pf then c.pFg = pf; uSt.czRefresh(); uSt.czSave(); uSt.czBroadcast() end
  y = y + swH
  c.po.y = slid("##poy", X + 96, sw3, c.po.y, 0.1, 1.6)
  -- الحد الأدنى ‎-1.9: أقرب من كذا واللوحة تدخل جسم السيارة فتبان «تسبح» وقت الحركة
  c.po.z = slid("##poz", X + 96 + sw3 + 6, sw3, math.min(c.po.z, -1.9), -3.4, -1.9)
  c.po.w = slid("##pow", X + 96 + 2 * (sw3 + 6), sw3, c.po.w, 0.2, 1.4)
