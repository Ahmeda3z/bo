  S.fixURL = function(u)
    u = tostring(u or '')
    if u == '' then return nil end
    if u:find('^//') then return 'https:' .. u end
    if not u:find('://') then
      if u:match('^%x%x%x%x%x%x%x%x') and not u:find('%.') then
        return 'https://avatars.steamstatic.com/' .. u .. '_full.jpg'
      end
      return 'https://' .. u
    end
    return (u:gsub('^http://', 'https://'))
  end

  S.esc = function(s) return tostring(s):gsub('\\','\\\\'):gsub('"','\\"'):gsub('\n',' ') end

  -- Lua ← الصفحة عبر execute فقط. sendAsync يفتح انتظار ردّ، وردّ CSP
  -- التلقائي يجي بمعرّف فاضي فيغرق اللوق بـ "Nothing expected a reply"
  -- ويسدّ القناة، وهذا اللي كان يمنع الكتابة والإرسال.
  -- ترسل على القناتين حتى يصل ack، ثم تثبت على العاملة منهما.
  -- الرقم التسلسلي يمنع الصفحة من معالجة نفس الرسالة مرتين.
  S.seq = 0
  S.tx = function(k, json)
    if not S.br then return end
    S.seq = S.seq + 1
    local payload = tostring(S.seq) .. '|' .. json
    local b = S.br
    if S.chan ~= 'async' then
      pcall(function() b:execute('window.KBRX&&window.KBRX("'..k..'","'..S.esc(payload)..'")') end)
    end
    if S.chan ~= 'exec' then
      pcall(function() b:sendAsync(k, payload, function() end) end)
    end
  end

  -- الخلل القديم كتب نصاً غريباً في stor.rec؛ وهو محفوظ فيبقى بعد التحديث.
  S.fixRec = function()
    local ok = { ["😂"] = 1, ["👑"] = 1, ["🫡"] = 1 }
    for _, k in ipairs({ 'rec1', 'rec2', 'rec3' }) do
      local v = tostring(stor[k] or '')
      if v == '' or #v > 8 or v:find('%a%a%a') then stor[k] = nil end
    end
    if not stor.rec1 or stor.rec1 == '' then stor.rec1 = "😂" end
    if not stor.rec2 or stor.rec2 == '' then stor.rec2 = "👑" end
    if not stor.rec3 or stor.rec3 == '' then stor.rec3 = "🫡" end
  end

  S.lists = function()
    S.fixRec()
    local q, e, g = {}, {}, {}
    for _, p in ipairs(QUICK_PHRASES) do q[#q+1] = '"'..S.esc(p)..'"' end
    for _, x in ipairs(EMOJIS) do e[#e+1] = '"'..S.esc(x)..'"' end
    for _, x in ipairs(uSt.gifLib or {}) do
      g[#g+1] = '{"name":"'..S.esc(x.name)..'","label":"'..S.esc(x.label)
        ..'","url":"'..S.esc(x.url)..'","mp4":"'..S.esc(x.mp4 or x.url)..'"}'
    end
    S.tx('lists', '{"phrases":['..table.concat(q,',')..'],"emojis":['..table.concat(e,',')
      ..'],"recents":["'..S.esc(stor.rec1)..'","'..S.esc(stor.rec2)..'","'..S.esc(stor.rec3)
      ..'"],"gifs":['..table.concat(g,',')..']}')
    S.tx('opacity', tostring(stor.chatOpacity or 0.95))
  end

  S.sync = function()
    for i = 1, #chatLog do
      local m = chatLog[i]
      if not m._kb then
        m._kb = true
        local p = { '"name":"'..S.esc(m.name or "")..'"', '"text":"'..S.esc(m.text or "")..'"',
                    '"srv":'..tostring(m.srv and true or false),
                    '"type":"'..(m.join and "join" or (m.leave and "leave" or "msg"))..'"' }
        if m.gif then
          local g = (type(m.gif)=='table' and (m.gif.mp4 or m.gif.url)) or tostring(m.gif)
          p[#p+1] = '"gif":"'..S.esc(g)..'"'
        end
        if m.color then
          p[#p+1] = string.format('"color":"#%02X%02X%02X"', math.floor(m.color.r*255),
                                  math.floor(m.color.g*255), math.floor(m.color.b*255))
        end
        if m.rawName then
          p[#p+1] = '"rawName":"'..S.esc(m.rawName)..'"'
          pcall(function()
            local ci = carByName(m.rawName)
            if ci then
              local av = S.fixURL(uSt.avInpOf(ci))
              if av then p[#p+1] = '"av":"'..S.esc(av)..'"'
              else
                local c = ac.getCar(ci)
                if c and c.isAIControlled then p[#p+1] = '"bot":true' end
              end
            end
          end)
        end
        S.tx('push', '{'..table.concat(p,',')..'}')
      end
    end
  end

  S.make = function()
    if S.br or S.failed then return S.br end
    local ok, b = pcall(S.WB, { size = vec2(920, 560), backgroundColor = rgbm(0,0,0,0),
      automaticallyRestartOnBackendCrash = true, targetFPS = 30 })
    if not ok or not b then S.failed = true
      return nil end
    S.br, S.born = b, pulseT
    -- المعالجات لا ترجّع أي قيمة: أي قيمة مرجعة تُرسَل كردّ غير متوقَّع.
    -- ⚠️ onReceive يسلّم كائن المتصفح كأول وسيط ويوزّع كل الرسائل على
    -- كل المعالجات. فنسجّل مستقبلاً واحداً، ونلتقط أول وسيط نصّي فيه
    -- الفاصل "|"، ثم نوزّع بأنفسنا. بدون هذا كانت رسائل الجسر تُرسل
    -- للسيرفر كرسائل شات حقيقية.
    local function onAny(...)
      local s
      for i = 1, select('#', ...) do
        local a = select(i, ...)
        if type(a) == 'string' and a:find('|', 1, true) then s = a end
      end
      if not s then return end
      local cmd, d = s:match('^(%a+)|(.*)$')
      if not cmd then return end
      if cmd == 'ready' then
        S.ready = true; S.lists()
      elseif cmd == 'ack' then
        if not S.chan then
          S.chan = S.tried and 'async' or 'exec'
        end
      elseif cmd == 'say' then
        local t = d:gsub('^%s+',''):gsub('%s+$','')
        if t ~= '' then pcall(function() ac.sendChatMessage(t) end); S.defocus = true end
      elseif cmd == 'gif' then
        if d ~= '' then pcall(function() ac.sendChatMessage('[gif:'..d..']') end) end
      elseif cmd == 'emoji' then
        if d ~= '' and d ~= stor.rec1 then
          stor.rec3, stor.rec2, stor.rec1 = stor.rec2, stor.rec1, d; S.lists()
        end
      elseif cmd == 'opacity' then
        local v = tonumber(d)
        if v then stor.chatOpacity = math.max(0.35, math.min(1, v)) end
      elseif cmd == 'typing' then
        local me = 0
        pcall(function() me = ac.getCar(0).sessionID or 0 end)
        pcall(function() S.tEvt({ sid = me, on = (d == '1') and 1 or 0 }) end)
        if d == '1' then S.typers[me] = pulseT else S.typers[me] = nil end
      elseif cmd == 'focus' then
        S.kbOn = (d == '1')
      elseif cmd == 'blur' then
        S.kbOn = false
      elseif cmd == 'spec' then
        local i = tonumber(d)
        if i then pcall(function() ac.focusCar(i) end); uSt.specOn = i end
      elseif cmd == 'blocked' then
        uSt.blkOpen = not uSt.blkOpen
      elseif cmd == 'bell' then
        uSt.notesOpen = not uSt.notesOpen
        if uSt.notesOpen then
          uSt.noteNew = 0
        else
          for q = #uSt.notes, 1, -1 do
            if uSt.notes[q].read then table.remove(uSt.notes, q) end
          end
        end
      elseif cmd == 'prof' then
        local i = tonumber(d)
        if i then uSt.profOpen = { i = i, name = ac.getDriverName(i) or '?' }; S.min = true end
      elseif cmd == 'tp' then
        local i = tonumber(d)
        if i then pcall(function()
          local c = ac.getCar(i)
          if c and c.isConnected then uSt.tpRequest(i) end
        end) end
      end
    end
    pcall(function() b:onReceive('kb', onAny) end)
    pcall(function() b:onReceive(onAny) end)
    pcall(function() b:loadHTML(S.html) end)
    return b
  end

  -- بثّ حالة الكتابة بين اللاعبين. لو السيرفر ما يمرّر رسائل العملاء
  -- فببساطة ما يظهر شي عند الآخرين، ولا يتأثر أي شي غيره.
  S.typers = {}
  S.tEvt = ac.OnlineEvent({ ac.StructItem.key("kb_typing"),
                            sid = ac.StructItem.int32(),
                            on  = ac.StructItem.int32() }, function(sender, msg)
    if not msg then return end
    local me = 0
    pcall(function() me = ac.getCar(0).sessionID or 0 end)
    if msg.on == 1 then S.typers[msg.sid] = pulseT else S.typers[msg.sid] = nil end
  end)

  S.pushTypers = function()
    local out, now = {}, pulseT
    for sid, t in pairs(S.typers) do
      if now - t > 5 then S.typers[sid] = nil
      else
        for i = 0, math.min(ac.getSim().carsCount - 1, 40) do
          local c = ac.getCar(i)
          if c and c.sessionID == sid then
            local n = ac.getDriverName(i)
            if n and n ~= '' then out[#out+1] = '"'..S.esc(n)..'"' end
            break
          end
        end
      end
    end
    local j = table.concat(out, ',')
    if j ~= S.tj then S.tj = j; S.tx('typing', '['..j..']') end
  end

