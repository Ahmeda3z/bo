uSt.npBars = function(x, y, ping, col, a, bw, gp, hmax)
  bw = bw or 5; gp = gp or 3; hmax = hmax or 14
  local bars = 4
  if ping > 200 then bars = 1 elseif ping > 150 then bars = 2 elseif ping > 100 then bars = 3 end
  for i = 1, 4 do
    local bx = x + (i - 1) * (bw + gp)
    local h = hmax * (i / 4)
    ui.drawRectFilled(vec2(bx, y + hmax - h), vec2(bx + bw, y + hmax),
      rgbm(col.r, col.g, col.b, ((i <= bars) and 1.0 or 0.28) * a), 1)
  end
end

