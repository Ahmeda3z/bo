      ui.pushClipRect(vec2(6, ty), vec2(W - 34, H - 5), true) end)
    ui.setCursor(vec2(tx, ty))
    ui.dwriteTextAligned(full, fsz, ui.Alignment.Start, ui.Alignment.Center,
