-- 📊 إحصائياتي — fed by TeamKabosStatsPlugin ($TeamKabos_STATS). Defined as a uSt field on
-- purpose: the menu sits at 199 module locals and 200 is LuaJIT's hard cap.
uSt.drawStats = function(X, Y, W, H)
  sectionTitle("إحصائياتي 📊", X, Y, W)
  local y = Y + 42
  if not uSt.stSec then
    dwRightBox("جاري تحميل إحصائياتك من السيرفر…", 13, X, y, W, 20, CDm)
    dwRightBox("لو تأخرت، اطلع وادخل مرّة ثانية", 12, X, y + 24, W, 18, CDm)
    return
  end
  local sec = uSt.stSec + (pulseT - (uSt.stAt or pulseT))   -- tick locally between server pushes
  local h, m = math.floor(sec / 3600), math.floor((sec % 3600) / 60)
  local lvl = uSt.stLevel or 1
  -- Levels are built from ACTIVE time only (driven at 190+). Don't tick this one locally:
  -- the server decides second by second whether it counted, and guessing here would show
  -- progress the player did not earn.
  local act = uSt.stAct or 0
  local nextAt = lvl * 5 * 3600                              -- a level every 5 active hours
  local prevAt = (lvl - 1) * 5 * 3600
  local prog = math.min(1, math.max(0, (act - prevAt) / math.max(1, nextAt - prevAt)))

  -- total time
  ui.drawRectFilled(vec2(X, y), vec2(X + W, y + 74), rgbm(CC.r, CC.g, CC.b, 0.12), 12)
  ui.drawRect(vec2(X, y), vec2(X + W, y + 74), CC, 12, nil, 1.2)
  dwRightBox("⏱️ مجموع وقتك في TeamKabos", 13, X + 14, y + 8, W - 28, 18, CC)
  dwBox(h .. " ساعة  و " .. m .. " دقيقة", 26, X, y + 30, W, 34, CW)
  y = y + 84

  -- level + progress (taller box so the hint never spills outside it)
  ui.drawRectFilled(vec2(X, y), vec2(X + W, y + 104), rgbm(CY.r, CY.g, CY.b, 0.12), 12)
  ui.drawRect(vec2(X, y), vec2(X + W, y + 104), CY, 12, nil, 1.2)
  dwRightBox("⭐ مستواك", 13, X + 14, y + 8, W - 28, 18, CY)
  dwBox("المستوى " .. lvl, 24, X, y + 28, W, 30, CY)
  -- live "you are earning right now" marker: same rule the server applies
  local spd = (ac.getCar(0) or {}).speedKmh or 0
  if spd >= 190 then
    dwRightBox("● يُحسب لك الآن", 11, X + 14, y + 34, W - 28, 16, CGR)
  end
  -- progress bar with the percentage centred on it
  ui.drawRectFilled(vec2(X + 16, y + 62), vec2(X + W - 16, y + 76), rgbm(0, 0, 0, 0.40), 7)
  ui.drawRectFilled(vec2(X + 16, y + 62), vec2(X + 16 + (W - 32) * prog, y + 76), CY, 7)
  dwBox(math.floor(prog * 100) .. "%", 10, X, y + 62, W, 14, rgbm(0, 0, 0, 0.85))
  -- number first so RTL reads naturally, and its own row (no overlap)
  dwBox("باقي " .. math.floor(math.max(0, nextAt - act) / 60) .. " دقيقة هجوله للمستوى " .. (lvl + 1), 12, X, y + 82, W, 16, CDm)
  y = y + 114

  -- 🔥 الستريك — days in a row you actually drove. Sits above rank because it's the one number
  -- that changes what you do TONIGHT.
  local stk = uSt.stStreak or 0
  local sc = stk > 0 and rgbm(1, 0.45, 0.15, 1) or rgbm(0.45, 0.47, 0.52, 1)
  ui.drawRectFilled(vec2(X, y), vec2(X + W, y + 62), rgbm(sc.r, sc.g, sc.b, 0.13), 10)
  ui.drawRect(vec2(X, y), vec2(X + W, y + 62), rgbm(sc.r, sc.g, sc.b, 0.5), 10, nil, 1.2)
  dwRightBox("🔥 ستريكك", 12, X + 12, y + 6, W - 24, 16, sc)
  if stk > 0 then
    dwBox(stk .. (stk == 1 and " يوم" or " أيام") .. " ورا بعض", 20, X, y + 24, W, 26, CW)
  else
    dwBox("ابدأ ستريكك اليوم", 17, X, y + 24, W, 26, CDm)
  end
  dwRightBox("أطول ستريك لك: " .. (uSt.stBestStreak or 0), 11, X + 12, y + 44, W - 24, 14, CDm)
  dwBox("هجول دقيقتين فوق 190 كل يوم عشان ما ينكسر", 10, X, y + 44, W, 14, CDm)
  y = y + 72

  -- rank
  ui.drawRectFilled(vec2(X, y), vec2(X + W * 0.5 - 5, y + 66), rgbm(CGR.r, CGR.g, CGR.b, 0.12), 10)
  dwRightBox("🏆 ترتيبك", 12, X + 10, y + 8, W * 0.5 - 25, 16, CGR)
  dwBox("#" .. (uSt.stRank or 0) .. " من " .. (uSt.stOf or 0), 18, X, y + 30, W * 0.5 - 5, 24, CW)
  -- best drift
  ui.drawRectFilled(vec2(X + W * 0.5 + 5, y), vec2(X + W, y + 66), rgbm(0.9, 0.4, 0.15, 0.12), 10)
  dwRightBox("🏁 أعلى هجوله", 12, X + W * 0.5 + 15, y + 8, W * 0.5 - 25, 16, rgbm(1, 0.6, 0.25, 1))
  dwBox(tostring(uSt.stBest or 0), 18, X + W * 0.5 + 5, y + 30, W * 0.5 - 5, 24, CW)
  y = y + 78

  dwRightBox("الوقت والنقاط تتجمّع لك عبر كل سيرفرات TeamKabos ✓", 12, X, y, W, 18, CGR)
  dwRightBox("المستوى ما يزيد إلا وأنت فوق 190 كم/س — الوقوف ما يُحسب", 11, X, y + 20, W, 16, CY)
  dwRightBox("كل 5 ساعات هجوله = مستوى · كل 10 مستويات = رانك جديد", 11, X, y + 38, W, 16, CDm)
end

