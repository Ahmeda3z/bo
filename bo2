-- ═══════════════ الرسائل الخاصة + شريط الإهداء + التنبيهات ═══════════════
-- بروتوكول لاعب↔لاعب: $KB_PM:<اسم المستلم>|<اسم المرسل>|<النص>
-- ويصل من الإدارة عبر بلوقن السيرفر بنفس الشكل، فيظهر بنفس الشريط.
uSt.notes    = uSt.notes or {}      -- سجلّ التنبيهات
uSt.noteNew  = uSt.noteNew or 0     -- غير المقروء (النقطة الحمراء)
uSt.bar      = nil                  -- الشريط الظاهر حالياً

uSt.barShow = function(from, text, kind, secs)
  uSt.bar = { from = from or "", text = text or "", kind = kind or "pm",
              t = pulseT, life = secs }        -- life=nil يعني يبقى حتى يُغلق
end

uSt.noteAdd = function(from, text, kind)
  table.insert(uSt.notes, 1, { from = from or "", text = text or "", kind = kind or "pm",
                               t = pulseT, read = false })
  while #uSt.notes > 40 do table.remove(uSt.notes) end
  uSt.noteNew = (uSt.noteNew or 0) + 1
end

-- إرسال رسالة خاصة للاعب
uSt.pmSend = function(toName, text)
  if toName == nil or toName == "" or text == nil or text == "" then return end
  if uSt.isBot(toName) then
    pcall(function() ac.setMessage("تعذّر الإرسال", "هذا بوت ولا يستقبل رسائل", nil, 3) end)
    return
  end
  local me = ac.getDriverName(0) or "?"
  pcall(function() ac.sendChatMessage("$KB_PM:" .. toName .. "|" .. me .. "|" .. text) end)
  pcall(function() ac.setMessage("تم الإرسال", "وصلت رسالتك إلى " .. toName, nil, 3) end)
end

-- شريط الرسالة (بأسلوب شريط الإهداء) — يظهر أعلى الشاشة مع زرّ إغلاق
uSt.drawMsgBar = function(sim)
  local B = uSt.bar
  if not B then return end
  if B.life and (pulseT - B.t) > B.life then uSt.bar = nil; return end

  -- نفس بناء شريط إهداءات Team One: عرض الشاشة، خلفية شبه شفافة، عنوان
  -- صغير أعلى، والنص يمشي أفقياً داخل منطقة مقصوصة.
  local acc = (B.kind == "admin") and rgbm(0.86, 0.18, 0.20, 1) or ACC
  local fsz, tsz = 18, 11
  local H = math.max(44, fsz + tsz + 22)
  local x = 12
  local W = math.max(280, sim.windowWidth - 24)
  -- موضع الشريط: لكل نوع إعداده (0 = أسفل فوق الشعار · 1 = أعلى الشاشة)
  local posKey = (B.kind == "admin") and "barPosPub" or "barPosPm"
  local y
  if uSt.sget(posKey, 0) == 1 then y = 8 else y = math.max(8, sim.windowHeight - H - 150) end

  local title = (B.kind == "admin") and "📢 رسالة الإدارة" or ("✉ رسالة خاصة من " .. tostring(B.from))
  local full = tostring(B.text)

  local tw = 0
  pcall(function() tw = ui.measureDWriteText(full, fsz).x end)
  if tw <= 0 then tw = #full * (fsz * 0.5) end

  local lgs = H - tsz - 12
  local span = W + tw + lgs + 40
  local speed = span / 8                      -- دورة كاملة ≈ ٨ ثوانٍ
  local age = pulseT - B.t
  if not B.life then
    -- الخاص يبقى حتى يُغلق: نُعيد الدورة باستمرار
    age = age % (span / speed)
  end
