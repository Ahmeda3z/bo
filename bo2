-- لوح الراكب: نرسمه بمستوى السيارة نفسه، فيتحرّك ويميل معها
uSt.tzQuad = function(bt, x, y, z, sc, tex)
  if bt == nil or tex == nil then return end
  local w = 0.62 * ((tonumber(sc) or 100) / 100)
  local h = w * 1.75                      -- نسبة جسم الإنسان تقريباً
  pcall(function()
    local p1 = bt:transformPoint(vec3(x + w / 2, y + h / 2, z))
    local p2 = bt:transformPoint(vec3(x - w / 2, y + h / 2, z))
    local p3 = bt:transformPoint(vec3(x - w / 2, y - h / 2, z))
    local p4 = bt:transformPoint(vec3(x + w / 2, y - h / 2, z))
    if render.setBlendMode and render.BlendMode then
      pcall(function() render.setBlendMode(render.BlendMode.AlphaBlend) end)
    end
    render.quad(p1, p2, p3, p4, rgbm(2.2, 2.2, 2.2, 1), tex)
  end)
end

uSt.tzSend = function()
  uSt.tzSentAt = pulseT
  local on = (uSt.sget("tzOn", false) == true)
  local x, y, z, ya, pi2, ro, sc, ch = uSt.tzMine()
  pcall(function()
    ac.sendChatMessage(string.format("$KB_TZ:%s|%.3f|%.3f|%.3f|%.1f|%.1f|%.1f|%d|%d",
      on and "1" or "0", x, y, z, ya, pi2, ro, math.floor(sc), ch))
  end)
end

-- الرسم ثلاثي الأبعاد: راكبي وركّاب الآخرين
uSt.tzDraw3D = function()
  local sim = ac.getSim()
  if not sim then return end
  if uSt.sget("tzOn", false) == true then
    local me = ac.getCar(0)
    if me and me.bodyTransform then
      local x, y, z, _, _, _, sc, ch = uSt.tzMine()
      uSt.tzQuad(me.bodyTransform, x, y, z, sc, uSt.tzTex(ch))
    end
  end
  for ci, d in pairs(uSt.tzPeers) do
    if d ~= nil and d.on then
      local c = ac.getCar(ci)
      if c and c.bodyTransform and c.isConnected then
        uSt.tzQuad(c.bodyTransform, d.x, d.y, d.z, d.sc, uSt.tzTex(d.ch or 1))
      end
    end
  end
end

