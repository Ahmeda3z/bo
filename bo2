-- ═══ الحظر (بأقل أثر ممكن) ═══
-- لا حلقات كل إطار، ولا مساس باللافتات ولا بالخريطة ولا بأوضاع اللعب.
uSt.isBot = function(nm, i)
  local n = nm
  if n == nil and i ~= nil then pcall(function() n = ac.getDriverName(i) end) end
  if n == nil or n == "" then return false end
  return tostring(n):match("^TeamKabos") ~= nil
end
-- تطبيق الحظر في آخر لحظة قبل الرسم: نظام الأوضاع يُعيد إظهار السيارات
-- بعد تحديثنا، فكان إخفاؤنا يُلغى قبل أن يصل الإطار إلى الشاشة.
uSt.blkLoad = function()
  if uSt.blk ~= nil then return uSt.blk end
  uSt.blk = {}
  pcall(function()
    for nm in tostring(stor.blockList or ""):gmatch("[^\n]+") do
      if nm ~= "" then uSt.blk[nm] = true end
    end
  end)
  return uSt.blk
end
uSt.blkSave = function()
  local t = {}
  for nm, v in pairs(uSt.blkLoad()) do if v then t[#t + 1] = nm end end
  pcall(function() stor.blockList = table.concat(t, "\n") end)
end
-- من حظرني (يصلني ببثّه). الإخفاء متبادل تماماً كوضع اللعب.
uSt.blkBy = uSt.blkBy or {}
-- الشبح المتبادل: نعطّل التصادم مع كل محظور (ومع من حظرني) على جهازي،
-- وهو يفعل المثل على جهازه لأن الحظر متبادل. النتيجة: لا أحد يؤثّر على الآخر.
uSt.blkPhys = function(sim)
  -- فحص لمرّة واحدة: هل تعطيل التصادم مدعوم في نسخة CSP هذي أصلاً؟
  if uSt.blkPhysChk == nil then
    uSt.blkPhysChk = (physics ~= nil and physics.disableCarCollisions ~= nil)
    if not uSt.blkPhysChk then
      pcall(function()
        ac.setMessage("الحظر", "نسخة CSP عندك لا تدعم تعطيل التصادم", nil, 8)
      end)
    end
  end
  if not uSt.blkPhysChk then return end
  if not sim then return end
  uSt.blkGhosted = uSt.blkGhosted or {}
  local near = false
  for i = 1, (sim.carsCount or 1) - 1 do
    local nm = nil
    pcall(function() nm = ac.getDriverName(i) end)
    local want = (nm ~= nil) and uSt.blkEff(nm) or false
    if want ~= (uSt.blkGhosted[i] == true) then
      uSt.blkGhosted[i] = want or nil
      pcall(function() physics.disableCarCollisions(i, want) end)
    end
    -- تعطيل التصادم مع لاعب بعينه لا يعمل في هذي النسخة، والذي يعمل هو تعطيل
    -- تصادم سيارتك أنت (وهو عام). لذلك نفعّله فقط حين يقترب المحظور فعلاً:
    -- ١٥ متراً — أي في اللحظة التي يمكن أن يصدمك فيها لا قبلها.
    if want then
      local me = ac.getCar(0)
      local c2 = ac.getCar(i)
      if me ~= nil and c2 ~= nil and me.position ~= nil and c2.position ~= nil then
        local dx = me.position.x - c2.position.x
        local dy = me.position.y - c2.position.y
        local dz = me.position.z - c2.position.z
        if (dx * dx + dy * dy + dz * dz) < 225 then near = true end
      end
    end
  end
  -- نعيد فرضه كل ثانية حتى لا يُلغيه أي نظام آخر (الانتقال أو التصليح)
  if near ~= (uSt.blkSelfGhost == true) or (near and (pulseT - (uSt.blkGhostAt or 0)) > 1) then
    uSt.blkSelfGhost = near
    uSt.blkGhostAt = pulseT
    pcall(function() physics.disableCarCollisions(0, near) end)
  end
end

uSt.blkSend = function(target, on)
  local me = nil
  pcall(function() me = ac.getDriverName(0) end)
  if me == nil or target == nil then return end
  pcall(function()
    ac.sendChatMessage("$KB_BLK:" .. tostring(me) .. "|" .. tostring(target) .. "|" .. (on and "1" or "0"))
  end)
end
-- إعادة بثّ دورية ليعرفها من دخل بعدي
uSt.blkResend = function()
  if (pulseT - (uSt.blkSentAt or -99)) < 12 then return end
  uSt.blkSentAt = pulseT
  local b = uSt.blkLoad()
  if next(b) == nil then return end
  for nm, v in pairs(b) do if v then uSt.blkSend(nm, true) end end
end
uSt.isBlocked = function(nm)
  if nm == nil or nm == "" then return false end
  return uSt.blkLoad()[tostring(nm)] == true
end
-- الحظر صار من السيرفر، فالفحص واحد. (كان اسمان: blkEff للمتبادل، وقد أُلغي.)
uSt.blkEff = function(nm)
  if nm == nil or nm == "" then return false end
  local k = tostring(nm)
  if uSt.blkLoad()[k] == true then return true end
  return uSt.blkBy[k] == true
end
uSt.blkToggle = function(nm)
  if nm == nil or nm == "" or uSt.isBot(nm) then return end
  local b = uSt.blkLoad()
  local now = not b[tostring(nm)]
  b[tostring(nm)] = now or nil
  uSt.blkSave()
  uSt.blkSend(nm, now)          -- ليخفيني هو أيضاً: الإخفاء متبادل
  uSt.visTick = 0               -- طبّق فوراً عبر نظام الأوضاع
  pcall(function() uSt.applyVisibility() end)
end

