  -- إعادة تهيئة المتصفح (بدل السقوط للشات القديم)
  S.retry = function()
    -- إنشاء متصفح جديد يترك القديم للجامع فتطبع اللعبة "WebBrowser got GCed".
    -- الشات يعمل، فلا داعي لإعادة التهيئة إطلاقاً.
    do return end
    -- كل إعادة تهيئة تتلف المتصفح فتطبع اللعبة "WebBrowser was properly disposed".
    -- لذلك: مهلة أطول بين المحاولات، وعدد محدود منها، فلا يتكرّر السطر في اللوق.
    if (S.retryN or 0) >= 3 then return end
    if (pulseT - (S.retryAt or 0)) < 25 then return end
    S.retryAt = pulseT
    S.retryN = (S.retryN or 0) + 1
    S.br, S.failed, S.ready, S.born = nil, false, false, 0
    S.chan, S.tried, S.sized, S.warmed, S.shown = nil, false, false, false, 0
  end

  -- الشات الجديد فقط: لا نرجع أبداً للشات القديم — إن تعثّر نعيد التحميل
  uSt.chat.active = function()
    -- لا نُعيد التهيئة إلا عند تعثّر حقيقي، وبعد مهلة كافية للتحميل
    if S.failed then S.retry() end
    if S.born > 0 and (pulseT - S.born) > 30 and not S.ready then S.retry() end
    return true
  end

