-- ═══════════════ لوحة الاسم (رسم ذاتي — يلغي أي لوحة قديمة) ═══════════════
-- لا نستعمل ui.onDriverNameTag إطلاقاً: بدلاً منه نخفي لافتات اللعبة للاعبين
-- الحقيقيين (وهي القناة التي يرسم فيها سكربت اللوحة القديم) ثم نرسم لوحتنا
-- بإسقاط ثلاثي الأبعاد خاص بنا. هكذا تختفي اللوحة القديمة من جذورها.
-- ملاحظة: كل شيء داخل دوال uSt.* (بدون متغيّرات محليّة جديدة في المستوى الأعلى).
-- إسقاط ثلاثي الأبعاد (منسوخ حرفياً من Team One: ui.projectPoint ← مصفوفات ← render.projectPoint)
uSt.npProject = function(sim, wp)
  -- ١) ui.projectPoint: ما تستعمله تطبيقات CSP الرسمية. يأخذ كاميرا اللعبة
  --    تلقائياً ويعيد بكسلات الشاشة مباشرة.
  if uSt.npProjMode ~= 2 and uSt.npProjMode ~= 3 and ui.projectPoint ~= nil then
    local o = nil
    pcall(function() o = ui.projectPoint(wp) end)
    if o ~= nil and o.x ~= nil and o.x == o.x then   -- o.x == o.x يستبعد NaN
      uSt.npProjMode = 1
      return o, true
    end
    if uSt.npProjMode == nil then uSt.npProjMode = 2 end
  end
  -- ٢) مصفوفات كاميرا اللعبة (نسبة ٠..١)
  if uSt.npProjMode ~= 3 and mat4x4 ~= nil and mat4x4.look ~= nil then
    local out = nil
    pcall(function()
      local cp = ac.getCameraPosition and ac.getCameraPosition() or sim.cameraPosition
      local cf = ac.getCameraForward and ac.getCameraForward() or sim.cameraLook
      local cu = ac.getCameraUp and ac.getCameraUp() or vec3(0, 1, 0)
      if cp == nil or cf == nil then return end
      local fov = tonumber(sim.cameraFOV) or tonumber(sim.fov) or 56
      local sw = sim.windowWidth or 1920
      local sh = sim.windowHeight or 1080
      local view = mat4x4.look(cp, cf, cu)
      local proj = mat4x4.perspective(math.rad(fov), sw / math.max(1, sh), 0.5, 30000)
      local o2 = view:mul(proj):transform(vec4(wp.x, wp.y, wp.z, 1))
      if o2.w and o2.w > 0.0001 then out = vec2(o2.x, -o2.y) / o2.w / 2 + 0.5 end
    end)
    if out ~= nil then
      uSt.npProjMode = 2
      return out, false
    end
    if uSt.npProjMode == 2 then uSt.npProjMode = 3 end
  end
  -- ٣) القديمة
  if render ~= nil and render.projectPoint ~= nil then
    local o3 = nil
    pcall(function()
      if render.ProjectFace ~= nil then o3 = render.projectPoint(wp, render.ProjectFace.Center)
      else o3 = render.projectPoint(wp) end
    end)
    if o3 ~= nil then return o3, false end
  end
  return nil, false
end

