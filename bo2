local _carDir = ''
local _carSkins = {}
local _currentSkin = ''
local _originalSkin = ''
uSt.skinInit = function()
  if uSt.skinInitDone then return end
  local id = nil
  pcall(function() id = ac.getCarID(0) end)
  if id == nil or tostring(id) == '' then return end          -- لسّه ما جهزت: نعيد لاحقاً
  local ok = pcall(function()
    _carDir = ac.getFolder(ac.FolderID.ContentCars) .. '/' .. tostring(id)
    _currentSkin = ac.getCarSkinID(0) or ''
    _originalSkin = _currentSkin
    _carSkins = {}
    io.scanDir(_carDir .. '/skins', '*', function(fileName)
      table.insert(_carSkins, { name = fileName })
    end)
  end)
  if ok then uSt.skinInitDone = true end
end
pcall(uSt.skinInit)

-- Build a COMPLETE file map for the skin folder and apply that. Nothing is filtered out:
-- the earlier version skipped preview/json/ini AND preferred CSP's folder-based applySkin,
-- which on many mod skins only mapped part of the textures — so the car kept showing its
-- base colour underneath and the skin looked wrong ("غير واقعي").
local function applySkinDir(carNode, dir)
  local files = io.scanDir(dir, '*')
  if not files or #files == 0 then return end
  local map = {}
  for i = 1, #files do map[files[i]] = dir .. '/' .. files[i] end
  if next(map) ~= nil then carNode:applySkin(map) end
end

local function doApplySkin(skinName, carIndex)
  local theCar = ac.getCar(carIndex or 0)
  if not theCar then return end
  local carName = ac.getCarID(carIndex or 0)
  local carNode = ac.findNodes('carRoot:' .. theCar.index)
  local dir = ac.getFolder(ac.FolderID.ContentCars) .. '/' .. carName .. '/skins/' .. skinName
  -- طريقة Team One: نُصفّر ثم نطبّق المجلد مباشرة (CSP يربط كل الخامات صح
  -- فيطلع اللون الحقيقي)، وإن فشلت نرجع لخريطة الملفات اليدوية.
  carNode:resetSkin()
  if not pcall(function() carNode:applySkin(dir) end) then
    applySkinDir(carNode, dir)
  end
end

local _syncSkin = ac.OnlineEvent({
  skin = ac.StructItem.string(100),
  oldSkin = ac.StructItem.string(0),
}, function(sender, data)
  if sender == nil or sender.index == 0 then return end   -- never re-apply our own broadcast
  doApplySkin(data.skin, sender.index)
end)

