uSt.ringFx = function(cx, cy, r, acc, alpha)
  alpha = alpha or 1
  local hot = rgbm(math.min(1, acc.r * 1.35 + 0.18), math.min(1, acc.g * 1.35 + 0.18), math.min(1, acc.b * 1.35 + 0.18), 1)
  ui.drawCircle(vec2(cx, cy), r, rgbm(acc.r, acc.g, acc.b, 0.28 * alpha), 56, 1.6)
  local seg, total = 22, 60
  local head = (pulseT * 0.22) % 1
  for k = 0, seg do
    local frac = k / seg
    local a = (head * total - k) * (math.pi * 2 / total)
    local kk = math.sin((1 - frac) * math.pi * 0.5)
    if kk > 0.03 then
      local a2 = a + (math.pi * 2 / total)
      local p1 = vec2(cx + math.cos(a) * r, cy + math.sin(a) * r)
      local p2 = vec2(cx + math.cos(a2) * r, cy + math.sin(a2) * r)
      ui.drawLine(p1, p2, rgbm(acc.r, acc.g, acc.b, 0.30 * kk * alpha), 6)
      ui.drawLine(p1, p2, rgbm(acc.r, acc.g, acc.b, 0.90 * kk * alpha), 2.6)
      ui.drawLine(p1, p2, rgbm(hot.r, hot.g, hot.b, 0.95 * kk * alpha), 1.2)
    end
  end
end

