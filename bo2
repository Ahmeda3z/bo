    pcall(function() ui.drawImage(flagURL, vec2(x, cyM - FLH / 2), vec2(x + FLW, cyM + FLH / 2), rgbm(1, 1, 1, a)) end)
    ui.drawRect(vec2(x, cyM - FLH / 2), vec2(x + FLW, cyM + FLH / 2), rgbm(1, 1, 1, 0.22 * a), 2, nil, 1)
    x = x + FLW + GAP
  end
