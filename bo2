uSt.admFlash = function(t) uSt.adminMsg = t; uSt.adminMsgAt = pulseT end

-- حدث الإدارة: نرسل أوامر للسيرفر، ونستقبل ردّه (sender == nil يعني السيرفر/البلقن)
uSt.admEvt = ac.OnlineEvent({
  ac.StructItem.key('KB_ADM'),
  cmd = ac.StructItem.string(480),
}, function(sender, data)
  if sender ~= nil then return end
  local m = tostring(data.cmd or "")
  if m == "OK" then
    uSt.adminAuthed = true; uSt.admFlash("تم تسجيل الدخول ✓")
  elseif m == "NO" then
    uSt.adminAuthed = false; uSt.admFlash("كلمة المرور غير صحيحة")
  elseif m:sub(1, 4) == "MSG:" then
    uSt.admFlash(m:sub(5))
  end
end)
uSt.admSend = function(cmd)
  pcall(function() uSt.admEvt({ cmd = cmd }) end)
end

-- طلب اسم اللوحة من البلوقن عند التحميل، ويعيد المحاولة حتى يصل (يحل مشكلة فوات البثّ)
uSt.brandReqAt = 0
uSt.brandReqTries = 0
uSt.requestBrand = function()
  if uSt.brandGot then return end
  if uSt.brandReqTries >= 10 then return end
  if pulseT < uSt.brandReqAt then return end
  uSt.brandReqAt = pulseT + 1.0
  uSt.brandReqTries = uSt.brandReqTries + 1
  pcall(function() uSt.admEvt({ cmd = "GETBRAND" }) end)
end

