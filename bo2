-- ═══════════════ شريط الحافة (بأسلوب Team One) ═══════════════
-- يظهر لمّا تقرّب الماوس من حافة الشاشة المختارة (يسار/أعلى/أسفل).
-- الضغط على أيقونة يفتح نفس أقسام قائمتك، والقائمة ترسو بجانب الشريط.
uSt.railT = uSt.railT or 0
uSt.drawRail = function(sim)
  local LY = tonumber(uSt.sget("menuLayout", 1)) or 1
  if LY ~= 2 and LY ~= 3 then uSt.railT = 0; return end
  if rulesOpen or uSt.setOpen or uSt.adminOpen then return end
  local sw, sh = sim.windowWidth, sim.windowHeight
  local mp = ui.mousePos()
  if not mp then return end

  local RW = 64
  -- الشريط يمتد على الحافة كاملة
  local near
  if LY == 2 then near = (mp.x <= RW + 8) else near = (mp.y <= RW + 8) end
  if menuOpen then near = true end
  if (pulseT - (uSt.railPinT or -99)) < 5 then near = true end
  uSt.railT = uSt.railT + ((near and 1 or 0) - uSt.railT) * 0.18
  if uSt.railT < 0.02 then return end
  local sl = uSt.railT

  local x, y, w, h
  if LY == 2 then
    w, h = RW, sh
    x, y = -RW + RW * sl, 0
  else
    w, h = sw, RW
    x, y = 0, -RW + RW * sl
  end
  local vert = (LY == 2)

  -- عناصر الشريط: الأقسام + الملف + الشكوى + الإعدادات
  local items = {}
  for k = 1, #TABS do items[#items + 1] = { kind = "tab", t = TABS[k] } end
  items[#items + 1] = { kind = "prof", label = "بطاقتي" }
  if pulseT > 30 then items[#items + 1] = { kind = "rep", label = "شكوى" } end
  items[#items + 1] = { kind = "set", label = "الإعدادات" }

  local ICON = 28
  local n = #items
  local run = (vert and h or w) - 56          -- مساحة بعد الشعار
  local GAP = math.max(4, math.min(12, math.floor(run / math.max(1, n)) - ICON))
  local total = n * ICON + (n - 1) * GAP
  local start0 = (vert and h or w) * 0.5 - total * 0.5
  if start0 < 56 then start0 = 56 end

  uSt.railTip = nil
  ui.transparentWindow("kbRail", vec2(math.floor(x), math.floor(y)), vec2(w, h), true, true, function()
    ui.drawRectFilled(vec2(0, 0), vec2(w, h), rgbm(0.05, 0.06, 0.09, (uSt.sget("menuOpacity", 0.95) or 0.95) * sl), 0)
    if vert then ui.drawLine(vec2(w - 0.5, 0), vec2(w - 0.5, h), rgbm(ACC.r, ACC.g, ACC.b, 0.55 * sl), 1.6)
    else ui.drawLine(vec2(0, h - 0.5), vec2(w, h - 0.5), rgbm(ACC.r, ACC.g, ACC.b, 0.55 * sl), 1.6) end

    -- الشعار في بداية الشريط
    do
      local lx = vert and (w - 42) * 0.5 or 10
      local ly2 = vert and 10 or (h - 42) * 0.5
      if LOGO_TEX then pcall(function() ui.drawImage(LOGO_TEX, vec2(lx, ly2), vec2(lx + 42, ly2 + 42), rgbm(1, 1, 1, sl)) end) end
    end

    local pos = start0
    for k = 1, n do
      local it = items[k]
      local bx = vert and (w - ICON) * 0.5 or pos
      local by = vert and pos or (h - ICON) * 0.5
      ui.setCursor(vec2(bx, by))
      local cl = ui.invisibleButton("##rail" .. k, vec2(ICON, ICON))
      local hov = ui.itemHovered()
      local on = (it.kind == "tab" and activeTab == it.t.id and menuOpen)
      if on or hov then
        ui.drawRectFilled(vec2(bx - 5, by - 5), vec2(bx + ICON + 5, by + ICON + 5),
          on and rgbm(ACC.r, ACC.g, ACC.b, 0.85 * sl) or rgbm(1, 1, 1, 0.10 * sl), 8)
      end
      local col = on and DK or (hov and CW or rgbm(CDm.r, CDm.g, CDm.b, sl))
      if it.kind == "tab" then
        navIcon(it.t.id, bx + 2, by + 2, ICON - 4, col)
      elseif it.kind == "prof" then
        local av = uSt.avInpOf and uSt.avInpOf(0) or nil
        local r = ICON * 0.5
        if av then
          if ui.drawImageRounded then pcall(ui.drawImageRounded, av, vec2(bx, by), vec2(bx + ICON, by + ICON), r)
          else pcall(ui.drawImage, av, vec2(bx, by), vec2(bx + ICON, by + ICON)) end
        elseif LOGO_TEX then pcall(function() ui.drawImage(LOGO_TEX, vec2(bx, by), vec2(bx + ICON, by + ICON)) end) end
        ui.drawCircle(vec2(bx + r, by + r), r, rgbm(ACC.r, ACC.g, ACC.b, (hov and 1 or 0.6) * sl), 20, 1.4)
      elseif it.kind == "rep" then
        ui.drawLine(vec2(bx + ICON * 0.30, by + ICON * 0.16), vec2(bx + ICON * 0.30, by + ICON * 0.84), hov and CW or rgbm(0.92, 0.34, 0.36, sl), 2)
        ui.drawRectFilled(vec2(bx + ICON * 0.30, by + ICON * 0.18), vec2(bx + ICON * 0.76, by + ICON * 0.46), rgbm(0.9, 0.3, 0.3, sl), 2)
      else
        local gx, gy, gr = bx + ICON * 0.5, by + ICON * 0.5, ICON * 0.28
        ui.drawCircle(vec2(gx, gy), gr * 0.55, col, 14, 1.6)
        for q = 0, 7 do
          local an = q * math.pi / 4 + pulseT * 0.6
          ui.drawLine(vec2(gx + math.cos(an) * gr * 0.75, gy + math.sin(an) * gr * 0.75),
                      vec2(gx + math.cos(an) * gr * 1.15, gy + math.sin(an) * gr * 1.15), col, 1.7)
        end
      end
      if hov then
        uSt.railTip = { txt = (it.kind == "tab") and it.t.label or it.label,
                        x = vert and (x + w + 10) or (x + bx + ICON * 0.5),
                        y = vert and (y + by) or (y + h + 8), vert = vert }
      end
      if cl then
        if it.kind == "tab" then
          if menuOpen and activeTab == it.t.id then menuOpen = false
          else activeTab = it.t.id; menuOpen = true end
        elseif it.kind == "prof" then
          uSt.profOpen = { i = 0, name = ac.getDriverName(0) }; menuOpen = false
        elseif it.kind == "rep" then
          reportOpen = true; menuOpen = false
        else
          uSt.setOpen = true; menuOpen = false
        end
      end
      pos = pos + ICON + GAP
    end
  end)

  -- التلميح في نافذة مستقلّة حتى لا يُقصّ داخل الشريط
  local T = uSt.railTip
  if T then
    local tw = 20 + #T.txt * 7
    local tx = T.vert and T.x or (T.x - tw * 0.5)
    local ty = T.y
    tx = math.max(2, math.min(tx, sw - tw - 2))
    ty = math.max(2, math.min(ty, sh - 28))
    ui.transparentWindow("kbRailTip", vec2(math.floor(tx), math.floor(ty)), vec2(tw, 26), true, false, function()
      ui.drawRectFilled(vec2(0, 0), vec2(tw, 26), rgbm(0.05, 0.06, 0.09, 0.97), 6)
      ui.drawRect(vec2(0.5, 0.5), vec2(tw - 0.5, 25.5), rgbm(ACC.r, ACC.g, ACC.b, 0.6), 6, nil, 1)
      dwBox(T.txt, 12, 0, 4, tw, 18, CW)
    end)
  end
end

