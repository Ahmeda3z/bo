    uSt.tzTick = pulseT
    if (pulseT - (uSt.tzSentAt or -99)) > 20 then pcall(uSt.tzSend) end
  end
  pcall(function() uSt.blkPhys(ac.getSim()) end)
          -- تحميل قائمة الحظر مبكراً (مخزّنة، رخيصة)
  -- إعادة بثّ حساباتي كل ٢٠ ثانية ليراها من دخل بعدي
  if pulseT > 5 and (pulseT - (uSt.acctSentAt or -99)) > 20 then
    uSt.acctSentAt = pulseT
    if uSt.myAccts ~= nil and #uSt.myAccts > 0 then pcall(uSt.acctBroadcast) end
  end
  -- بثّ إعداد الانتقال: بعد الدخول ثم كل ٦ ثوانٍ (رخيص ويُبقي الجميع محدَّثين)
  if pulseT > 4 and (pulseT - (uSt.permSentAt or -99)) > 6 then pcall(uSt.sendPerm) end
  if not uSt.skinInitDone then pcall(uSt.skinInit) end
  if not uSt.perfInit then uSt.perfInit = true; applyPerfMode(stor.perfMode) end
  if uSt.requestBrand then uSt.requestBrand() end
  if stor.perfMode then
    uSt.perfTick = uSt.perfTick - dt
    if uSt.perfTick <= 0 then uSt.perfTick = 0.5; perfApplyPerCar(true) end
  end
  if stor.extraKeep then
    uSt.extraTick = uSt.extraTick - dt
    if uSt.extraTick <= 0 then
      uSt.extraTick = 0.7
      for i, v in pairs(extraDesired) do pcall(function() ac.setExtraSwitch(i, v) end) end
    end
  end
  if not uSt.timeApplied and pulseT > 2 then
    uSt.timeApplied = true
    if trackTimeShift() ~= 0 then sendTime() end
  end
  if math.abs(grp - 1.0) > 0.001 then
    uSt.gripTick = uSt.gripTick - dt
    if uSt.gripTick <= 0 then uSt.gripTick = 0.8; applyGrip() end
  end
  if tmr.r > 0 then tmr.r = tmr.r - dt end
  if ghostOn then ghostT = ghostT - dt; if ghostT <= 0 then ghostEnd() end end
  if boostTimer > 0 then boostTimer = boostTimer - dt end
  if uSt.sboost and uSt.sboost > 0 then
    uSt.sboost = uSt.sboost - dt
    local bc = ac.getCar(0)
    if bc then
      local bf = vec3(bc.look.x, 0, bc.look.z)
      if bf:length() > 1e-3 then
        bf = bf:normalize()
        local cur = bc.speedKmh or 0
        local tgt = math.min(stor.boostTarget, BOOST_TARGET)
        if cur < tgt then
          physics.setCarVelocity(0, bf * (math.min(tgt, cur + stor.boostAccel * dt) / 3.6))
        else
          uSt.sboost = 0
        end
      end
    end
  end
  pulseT = pulseT + dt
  if uSt.selfWelcome then pcall(uSt.selfWelcome) end   -- ترحيب اللاعب بنفسه
  -- لوحة المفاتيح أولاً: أي خطأ تحتها ما يقدر يقتل القائمة
  inputCheck()
  -- 🚦 وضع السرعة معزول داخل pcall
  pcall(function()
    if uSt.speedMode == 1 then
      local sc = ac.getCar(0)
      if sc and sc.isConnected then
        local kmh = sc.speedKmh or 0
        if kmh > uSt.SPEED_CAP then
          physics.setCarVelocity(0, sc.velocity * (uSt.SPEED_CAP / kmh))
        end
      end
    end
    local blkAny = false
    pcall(function()
      blkAny = (next(uSt.blkLoad()) ~= nil) or (uSt.blkBy ~= nil and next(uSt.blkBy) ~= nil)
    end)
    if uSt.speedMode ~= nil or blkAny then
      uSt.modeBcast = uSt.modeBcast - dt
      if uSt.modeBcast <= 0 then
        uSt.modeBcast = (pulseT < 30) and 2 or 4
        uSt.sendMode()
      end
      uSt.visTick = uSt.visTick - dt
      if uSt.visTick <= 0 then
        uSt.visTick = 1
        uSt.applyVisibility()
      end
      uSt.enforceHidden()
    end

  end)
  -- مصافحة مجدولة: أبثّ تعديلاتي ردّاً على بثّ لاعب آخر
  if uSt.czHandshakeAt and pulseT >= uSt.czHandshakeAt then
    uSt.czHandshakeAt = nil
    pcall(uSt.czBroadcast)
  end
  if uSt.czPump then pcall(uSt.czPump) end   -- طابور الإرسال: سطر كل ثانية
  -- إعادة بث تعديلات السيارة كل 20 ثانية للداخلين الجدد
  local anyBp = false
  pcall(function()
    local L = uSt.czCfg().bpl
    for k = 1, 3 do if L[k] and L[k].t ~= "" then anyBp = true end end
  end)
  if (uSt.cz.plateOn or uSt.cz.glassOn or anyBp) and (pulseT - (uSt.czLastBc or -99)) > 10 then
    pcall(uSt.czBroadcast)
  end
  driftUpdate(dt)
  rewindUpdate(dt)
  -- إعادة تطبيق السكن حتى يكتمل تحميل نسيجه
  if uSt.skinRetryName and pulseT < (uSt.skinRetryUntil or 0) then
    if pulseT >= (uSt.skinRetryAt or 0) then
      uSt.skinRetryAt = pulseT + 0.35
      pcall(doApplySkin, uSt.skinRetryName, 0)
    end
  elseif uSt.skinRetryName then
    uSt.skinRetryName = nil
  end
  -- بعد إعادة الاتصال بسيارة جديدة: رجّعه لمكانه الذي حفظناه
  if stor.swapPend then
    local age = os.time() - (tonumber(stor.swapAt) or 0)
    -- ننتظر لحظة حتى تُنشأ السيارة الجديدة (سواء بإعادة اتصال أو تبديل فوري)
    if age >= 2 and age <= 120 then
      local me7 = ac.getCar(0)
      if me7 and me7.position then
        stor.swapPend = false
        pcall(function()
          physics.setCarVelocity(0, vec3(0, 0, 0))
          physics.setCarPosition(0,
            vec3(stor.swapX or 0, (stor.swapY or 0) + 0.4, stor.swapZ or 0),
            vec3(stor.swapDX or 0, 0, stor.swapDZ or 1))
          ghostStart(3)
        end)
        pcall(function() ac.setMessage("رجّعناك لمكانك", "بسيارتك الجديدة — استمتع", nil, 4) end)
      end
    elseif age > 120 then
      stor.swapPend = false
    end
  end
  if swapTransition.active then
    swapTransition.t = swapTransition.t + dt
    if swapTransition.t >= 0.25 then
      swapTransition.active = false
      pcall(function() ac.reconnectTo({ carID = swapTransition.carID }) end)
    end
  end
end

