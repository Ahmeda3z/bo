local function inputCheck()
  local sim = ac.getSim()
  local busy = ui.anyItemFocused() or ui.anyItemActive()
  if sim.isPaused then return end
  if ui.keyboardButtonPressed(ui.KeyIndex.M, false) and not busy then
    -- M: يقفل الإعدادات إن كانت مفتوحة، ثم يفتح الشكل المختار.
    -- في وضع الشريط: M يُظهر/يُخفي الشريط فقط (ولا يفتح آخر قسم).
    local LYm = tonumber(uSt.sget("menuLayout", 1)) or 1
    if uSt.setOpen then
      uSt.setOpen = false
      if LYm == 1 then menuOpen = true else uSt.railPinT = pulseT; menuOpen = false end
    elseif LYm == 1 then
      menuOpen = not menuOpen
    else
      if menuOpen then
        menuOpen = false; uSt.railPinT = pulseT
      elseif (pulseT - (uSt.railPinT or -99)) < 5 then
        uSt.railPinT = -99            -- ضغطة ثانية: إخفاء فوري
      else
        uSt.railPinT = pulseT         -- إظهار فوري لمدة ٥ ثوانٍ
      end
    end
  end
  if ui.keyboardButtonPressed(ui.KeyIndex.T, false) and not busy then menuOpen = true; activeTab = 1 end
  if ui.keyboardButtonPressed(ui.KeyIndex.B, false) and not busy then doBoost() end
  if ui.keyboardButtonPressed(ui.KeyIndex.V, false) and not busy then repairCar() end
  if ui.keyboardButtonPressed(ui.KeyIndex.C, false) and not busy then
    chatBarOpen = not chatBarOpen
    if chatBarOpen then
      chatBarJustOpened = true; uSt.chatBarIdle = pulseT; uSt.chatMin = false
      uSt.chatPinned = true    -- فُتح بـ C: يبقى ظاهر لين يتفاعل معه ويبعد الماوس
    end
  end
  if ui.keyboardButtonPressed(ui.KeyIndex.X, false) and not busy then
    pcall(function() physics.teleportCarTo(0, ac.SpawnSet.Pits) end)
    ghostStart(3)
  end
  if ui.keyboardButtonPressed(ui.KeyIndex.P, false) and not busy then uSt.spotsOpen = not uSt.spotsOpen end
end

