-- Some tracks ship no/incorrect track_params, so their sky renders ~12h off the clock.
-- Per-track correction (12h is symmetric mod 24h) so the menu time matches the sun. The menu is
-- shared fleet-wide, so this keys off the track: correct tracks (e.g. Server 1) get 0, off ones +12h.
local TRACK_TIME_SHIFT = {
  -- time is now corrected SERVER-SIDE via data_track_params.ini (KSA coords) + ForceServerTrackParams,
  -- so no per-track menu shift is needed. Kept as a hook in case a track ever needs a manual nudge.
}
-- تصحيح لمرّة واحدة: كان المفتاح مفعّلاً افتراضياً فيقلب الوقت ١٢ ساعة
-- (الظهر يطلع ليلاً). نُطفئه مرّة واحدة لمن كان مخزّناً عنده، ويبقى الخيار
-- في الإعدادات لمن يحتاجه فعلاً.
pcall(function()
  if uSt.sget("tf12fix", false) ~= true then
    uSt.sset("timeFlip12", false)
    uSt.sset("tf12fix", true)
  end
end)

local function trackTimeShift()
  local s = 0
  pcall(function() s = TRACK_TIME_SHIFT[ac.getTrackID()] or 0 end)
  -- بعض الحلبات سماؤها معكوسة ١٢ ساعة عن الساعة (ليل يطلع نهار).
  -- المفتاح في الإعدادات → الشاشة يصحّحها.
  if uSt.sget("timeFlip12", false) == true then s = s + 43200 end
  return s
end
local function sendTime()
  local sec = (math.floor(timeHour * 3600) + trackTimeShift()) % 86400
  pcall(function() SetTime({ mode = 'set', seconds = tostring(sec) }) end)
  timeSynced = false
end
local function syncTime()
  pcall(function() SetTime({ mode = 'sync', seconds = '0' }) end)
  timeSynced = true
end

