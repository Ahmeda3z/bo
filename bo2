uSt.gifDraw = function(g, p1, p2, col)
  col = col or rgbm(1, 1, 1, 1)
  local p = uSt.gifPlayers[g.name]
  if p == nil and g.mp4 then
    local ok, made = pcall(ui.MediaPlayer, g.mp4)
    if ok and made then
      pcall(function() made:setLooping(true) end)
      pcall(function() made:setVolume(0) end)
      pcall(function() made:play() end)
      p = made
    else p = false end
    uSt.gifPlayers[g.name] = p
  end
  if p and pcall(ui.drawImage, p, p1, p2, col) then return end
  uSt.gifPlayers[g.name] = false
  pcall(ui.drawImage, g.url, p1, p2, col)
end

ac.onChatMessage(function(message, carIdx)
  local msg = tostring(message)
  -- ── إذن الانتقال: طلب/ردّ بين اللاعبين ──
  do
      -- حسابات اللاعبين: sid~حساب|حساب…
    local asid, alist = msg:match("^%$TeamKabos_ACCT:(%d+)~(.*)$")
    if asid then
      local sid = tonumber(asid)
      if sid ~= nil then
        local t = {}
        for one in tostring(alist):gmatch("[^|]+") do t[#t + 1] = one end
        uSt.acctRemote[sid] = t
      end
      return true
    end
    -- تركيب تعزيز: إعدادات مجسّم لاعب آخر
    local tzs = msg:match("^%$KB_TZ:(.*)$")
    if tzs ~= nil then
      if carIdx ~= nil and carIdx >= 0 then
        local on, x, y, z, ya, pi2, ro, sc, ch =
          tzs:match("^([01])|([%-%d%.]+)|([%-%d%.]+)|([%-%d%.]+)|([%-%d%.]+)|([%-%d%.]+)|([%-%d%.]+)|(%d+)|(%d+)$")
        if on ~= nil then
          local d = uSt.tzPeers[carIdx] or {}
          d.on = (on == "1")
          d.x, d.y, d.z = tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0
          d.yaw, d.pitch, d.roll = tonumber(ya) or 0, tonumber(pi2) or 0, tonumber(ro) or 0
          d.sc = tonumber(sc) or 100
          d.ch = math.max(1, math.min(#uSt.TZ_CHARS, tonumber(ch) or 1))
          d.dirty = true
          uSt.tzPeers[carIdx] = d
        end
      end
      return true
    end
    -- حظر متبادل: من حظرني يختفي عني تلقائياً
    local bwho, btgt, bon = msg:match("^%$KB_BLK:([^|]*)|([^|]*)|([01])$")
    if bwho then
      local me2 = nil
      pcall(function() me2 = ac.getDriverName(0) end)
      if me2 ~= nil and tostring(btgt) == tostring(me2) then
        uSt.blkBy[tostring(bwho)] = (bon == "1") or nil
        uSt.visTick = 0
        pcall(function() uSt.applyVisibility() end)
      end
      return true
    end
    local pv = msg:match("^%$KB_TPPERM:(%d)$")
    if pv then
      if carIdx ~= nil then uSt.peerPerm[carIdx] = tonumber(pv) end
      return true
    end
    local tgt = msg:match("^%$KB_TPREQ:(.+)$")
    if tgt then
      local myName = ac.getDriverName(0) or ""
      if tgt == myName and carIdx and carIdx ~= 0 then
        local perm = uSt.sget("tpPerm", 0) or 0
        local who = ac.getDriverName(carIdx) or "لاعب"
        if perm == 2 then
          pcall(function() ac.sendChatMessage("$KB_TPANS:" .. who .. ":0") end)
        elseif perm == 1 then
          uSt.tpAsk = { i = carIdx, name = who, t = pulseT }
        else
          pcall(function() ac.sendChatMessage("$KB_TPANS:" .. who .. ":1") end)
        end
      end
      return true
    end
    local rn, rv = msg:match("^%$KB_TPANS:(.+):([01])$")
    if rn then
      local myName = ac.getDriverName(0) or ""
      if rn == myName then
        if rv == "1" then
          if uSt.tpWant and (pulseT - (uSt.tpWantT or 0)) < 20 then
            pcall(function() uSt.tpDo(uSt.tpWant, uSt.tpBehind) end)
          end
        else
          local who = (carIdx and ac.getDriverName(carIdx)) or "اللاعب"
          pcall(function() ac.setMessage("طلب الانتقال", who .. " رفض انتقالك إليه", nil, 4) end)
        end
        uSt.tpWant = nil
      end
      return true
    end
  end
  -- دخول/خروج من البلوقن -> رسالة شات + بانر أعلى الشاشة
  -- GIF من لاعب: [gif:الاسم] -> صورة متحركة بدل نص
  local gnm = msg:match("^%[gif:(.+)%]$")
  if gnm then
    local g = uSt.gifFind(gnm)
    if g then
      local nm = "?"; pcall(function() nm = ac.getDriverName(carIdx) or "?" end)
      chatLog[#chatLog + 1] = { name = nm, rawName = nm, text = "", gif = g, srv = false, t = pulseT }
      while #chatLog > CHAT_MAX do table.remove(chatLog, 1) end
      return true
    end
  end
  -- مزامنة تعديلات السيارة (لوحة/كتابة قزاز) من بقية اللاعبين
  -- رسالة خاصة: $KB_PM:<المستلم>|<المرسل>|<النص>
  do
    local pto, pfrom, ptxt = msg:match("^%$KB_PM:([^|]*)|([^|]*)|(.*)$")
    if pto then
      local me = ac.getDriverName(0) or ""
      if pto == me and ptxt ~= "" and not uSt.blkEff(pfrom) then
        local isAdm = (pfrom == "ADMIN" or pfrom == "الإدارة")
        local perm = uSt.sget("pmFrom", 0)
        -- 0 الجميع · 1 الإدارة فقط · 2 لا أحد
        if (perm == 2) or (perm == 1 and not isAdm) then return true end
        uSt.noteAdd(isAdm and "الإدارة" or pfrom, ptxt, isAdm and "admin" or "pm")
        if uSt.sget("pmStyle", 0) == 0 then
          uSt.barShow(isAdm and "الإدارة" or pfrom, ptxt, isAdm and "admin" or "pm", nil)
        else
          chatLog[#chatLog + 1] = { name = (isAdm and "الإدارة" or pfrom) .. " (خاص)", text = ptxt,
                                    srv = false, color = isAdm and rgbm(0.95, 0.35, 0.35, 1) or ACC,
                                    rawName = pfrom, t = pulseT }
          while #chatLog > CHAT_MAX do table.remove(chatLog, 1) end
        end
      end
      return true
    end
    -- رسالة عامة من الإدارة: $KB_ALL:<النص> — شريط ١٠ ثوانٍ للجميع
    local atxt = msg:match("^%$KB_ALL:(.*)$")
    if atxt then
      if atxt ~= "" and uSt.sget("pmPublic", true) then
        uSt.noteAdd("الإدارة", atxt, "admin")
        if uSt.sget("pmStyle", 0) == 0 then
