  end
end

-- المحرّك: يخفي لافتات اللعبة للاعبين (فيختفي أي سكربت لوحة قديم) ثم يرسم لوحاتنا
uSt.npPlates = function(sim)
  if not sim then return end
  if rulesOpen then return end   -- لا نرسم فوق شاشة الترحيب
  -- وضع التصوير يُخفي لافتات اللعبة، فلو كان خيار «لوحة اللعبة الأصلية» مفعّلاً
  -- لن يظهر أي اسم إطلاقاً. لذلك نستعمل لوحتنا دائماً أثناء التصوير.
  if uSt.sget("npVanilla", false) and not uSt.photo then
    -- لوحة اللعبة الأصلية: نُبقي لافتاتها مُعادة باستمرار لا مرّة واحدة.
    -- الإرجاع لمرّة واحدة كان يترك أي سيارة يُخفيها نظام آخر بعد التبديل
    -- (أو تدخل السيرفر لاحقاً) بلا لافتة — فتختفي من خريطة اللعبة أيضاً.
    -- كل نصف ثانية، وبتكلفة لا تُذكر. والمحظور وحده يبقى مخفياً.
    if (pulseT - (uSt.npVanAt or -99)) > 0.5 then
      uSt.npVanAt = pulseT
      uSt.npRestored = true
      for i = 0, (sim.carsCount or 1) - 1 do
        local vn = nil
        pcall(function() vn = ac.getDriverName(i) end)
        local hide = (vn ~= nil) and uSt.blkEff(vn) or false
        pcall(function() ac.hideCarLabels(i, hide) end)
      end
    end
    return
  end
  uSt.npRestored = false
  if uSt.sget("npShow", true) == false then return end   -- أُخفيت من كنترول التصوير
  -- في وضع التصوير تُخفى لافتات اللعبة، لكن لوحتنا تبقى ما لم تُطفأ من الكنترول
  local me = ac.getCar(0)
  if not me then return end
  local cam = sim.cameraPosition
  local look = sim.cameraLook
  -- وضع التصوير يمسك الكاميرا عبر ac.grabCamera، فتبقى sim.cameraPosition على
  -- الكاميرا القديمة وتُستبعد كل اللوحات كأنها خلف الكاميرا. نأخذ كاميرا التصوير.
  if uSt.photo and uSt.phCam ~= nil then
    pcall(function()
      local tr = uSt.phCam.transform
      if tr ~= nil and tr.position ~= nil and tr.look ~= nil then cam, look = tr.position, tr.look end
    end)
  end
  if not cam or not look then return end

  -- نفس صيغة Team One: (true, false) = بلا التقاط للماوس، لكنها ترسم
  ui.transparentWindow("kbNamePlates", vec2(0, 0), vec2(sim.windowWidth, sim.windowHeight), true, false, function()
    -- نجمع اللاعبين ونرتّبهم الأبعد أوّلاً فتعلو لافتات الأقرب
    -- لوحتك أنت تظهر فقط مع الكاميرا الحرّة (F7 / كام تول) — لا مع كاميرات المتابعة
    local ownOK = false
    if uSt.photo then ownOK = true end     -- وضع التصوير: أظهر لوحتك أيضاً
    pcall(function()
      local cm = sim.cameraMode
      if ac.CameraMode ~= nil and cm ~= nil then
        ownOK = (cm == ac.CameraMode.Free)
      else
        -- احتياط: إن لم يتوفّر التعداد، نعتمد ابتعاد الكاميرا كثيراً عن السيارة
        local mc = ac.getCar(0)
        if mc and mc.position then
          local ox = cam.x - mc.position.x
          local oy = cam.y - mc.position.y
          local oz = cam.z - mc.position.z
          ownOK = math.sqrt(ox * ox + oy * oy + oz * oz) > 12
        end
      end
    end)
    local list = {}
    for i = 0, (sim.carsCount or 1) - 1 do
      local c = ac.getCar(i)
      local bnm2 = nil
      pcall(function() bnm2 = ac.getDriverName(i) end)
      if c and c.isConnected and not c.isAIControlled then
        -- خريطة اللعبة تعتمد على نظام اللافتات: إخفاؤها للجميع كان يشيل
        -- السيارات منها. لذلك نُخفي لافتة اللعبة فقط للسيارات القريبة (حيث
        -- تُرسم لوحتنا فعلاً وقد تتداخل)، ونتركها للبعيدة فتبقى في الخريطة.
        local dxL, dyL, dzL = 0, 0, 0
        if c.position then
          dxL = cam.x - c.position.x; dyL = cam.y - c.position.y; dzL = cam.z - c.position.z
        end
        local dL = math.sqrt(dxL * dxL + dyL * dyL + dzL * dzL)
        -- نُخفي لافتة اللعبة على كامل المدى الذي تُرسم فيه لوحتنا، فلا تظهر
        -- اللافتة الأصلية أبداً على سيارة نرسم لها. وما بعد هذا المدى تبقى
        -- لافتته مفعّلة ليظل ظاهراً في خريطة اللعبة.
        local maxL = tonumber(uSt.sget("npHideDist", 99)) or 99
        pcall(function() ac.hideCarLabels(i, dL < maxL) end)
        if (i ~= sim.focusedCar or ownOK) and c.position then
          local dx = cam.x - c.position.x
          local dy = cam.y - c.position.y
          local dz = cam.z - c.position.z
          local d = math.sqrt(dx * dx + dy * dy + dz * dz)
          -- وضع التصوير: الكاميرا ممسوكة من نظام التصوير، فأي استبعاد بحسابات
          -- كاميرا اللعبة يحذف كل اللوحات. نترك الإسقاط وحده يقرّر.
          if uSt.photo then
            list[#list + 1] = { i = i, c = c, d = math.max(1, d) }
          elseif d > 0.6 and d <= (tonumber(stor.npMax) or 220) then
            list[#list + 1] = { i = i, c = c, d = d }
          end
        end
      end
    end
    table.sort(list, function(p, q) return p.d > q.d end)

    for k = 1, #list do
      local e = list[k]
      local wp = vec3(e.c.position.x, e.c.position.y + 1.55, e.c.position.z)
      local skip = false
      if not uSt.photo then
        if ((wp.x - cam.x) * look.x + (wp.y - cam.y) * look.y + (wp.z - cam.z) * look.z) <= 0.2 then skip = true end
      end
      if not skip then
        local sp, inPx = uSt.npProject(sim, wp)
        if sp and sp.x then
          local px, py, vis = sp.x, sp.y, false
          if inPx then
            vis = (px > -400 and px < sim.windowWidth + 400 and py > -300 and py < sim.windowHeight + 300)
          else
            vis = not (px < -0.3 or px > 1.3 or py < -0.25 or py > 1.25)
            px, py = px * sim.windowWidth, py * sim.windowHeight
          end
          if vis then
            local a = 1
            if e.d > 140 then a = math.max(0, 1 - (e.d - 140) / 80) end
            -- أصغر من قبل + تصغر مع البعد (لاحقاً نضيف إعداداً للحجم)
            local sc = 0.78 * ((tonumber(stor.npScale) or 100) / 100) * math.max(0.55, 1.0 - (e.d / math.max(40, tonumber(stor.npMax) or 220)) * 0.45)
            if a > 0.03 then pcall(function() uSt.npOne(e.i, px, py, a, sc) end) end
          end
        end
      end
    end
  end)
end


-- ═══════════ إذن الانتقال: الطلب والنافذة ═══════════
-- ينتقل مباشرة إذا كان اللاعب يسمح للجميع، وإلا يرسل طلباً وينتظر الردّ.
uSt.tpRequest = function(ci, behind)
  local c = ac.getCar(ci)
  if not c then return end
  local who = ac.getDriverName(ci)
  if not who or who == "" then pcall(function() TPS(c) end) return end

  -- إعداد الطرف الآخر من بثّه: 0 الجميع · 1 يسأل · 2 لا أحد.
  -- إن لم يصل بثّه بعد نعتبره الافتراضي (الجميع) فلا نُزعج أحداً بطلب.
  local perm = uSt.peerPerm[ci]
  if perm == nil then perm = 0 end

  if perm == 0 then
    -- يسمح للجميع: ننتقل فوراً بلا طلب ولا انتظار
    if behind then pcall(function() TPB(c) end) else pcall(function() TPS(c) end) end
    pcall(function() ac.setMessage("انتقال", "انتقلت إلى " .. who, nil, 2) end)
    return
  end

  if perm == 2 then
    pcall(function() ac.setMessage("غير مسموح", who .. " مقفل الانتقال إليه", nil, 4) end)
    return
  end

  -- يسأل أولاً (أو إعداده غير معروف بعد): نرسل طلباً وننتظر ردّه
  uSt.tpWant, uSt.tpWantT, uSt.tpBehind = ci, pulseT, (behind == true)
  pcall(function() ac.sendChatMessage("$KB_TPREQ:" .. who) end)
  pcall(function() ac.setMessage("تم إرسال الطلب", "بانتظار موافقة " .. who, nil, 3) end)
end

