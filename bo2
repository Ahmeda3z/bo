-- 🎨 تعديل السيارة (تاب 18) v3 — كتابة بلا ميشات + مزامنة أونلاين
-- لوحان ثلاثيا الأبعاد (render.quad) ملتصقان بجسم السيارة عبر bodyTransform.
-- وجه واحد فقط (خلفي) عشان ما تبان الكتابة مقلوبة من الكاميرا الأمامية.
-- المزامنة عبر الشات: كل لاعب يبث نصوصه وألوانه ومواضعه، والباقي يرسمونها
-- على سيارته عندهم. كل الحالة على uSt (حد الـ200 متغيّر).
---------------------------------------------------------------
uSt.cz = { plateTxt = "TeamKabos", glassTxt = "", gen = 0, status = "", plateOn = false, glassOn = false,
  hidden = true }    -- يبدأ مخفياً كل دخول: اللاعب هو اللي يظهر عباراته من القائمة
uSt.czStor = ac.storage({ czMap = "{}" })
uSt.czMap = {}
pcall(function() uSt.czMap = JSON.parse(uSt.czStor.czMap) or {} end)
uSt.czSave = function() pcall(function() uSt.czStor.czMap = JSON.stringify(uSt.czMap) end) end
uSt.czCarKey = function() local k = "?" pcall(function() k = ac.getCarID(0) or "?" end) return k end
uSt.czCfg = function()
  local ck = uSt.czCarKey()
  uSt.czMap[ck] = uSt.czMap[ck] or {}
  local m = uSt.czMap[ck]
  m.po = m.po or { y = 0.62, z = -2.35, w = 0.52 }
  m.go = m.go or { y = 1.05, z = -1.95, w = 0.95 }
  m.pBg = m.pBg or 1     -- لون خلفية اللوحة
  m.pFg = m.pFg or 2     -- لون خط اللوحة
  m.gFg = m.gFg or 1     -- لون خط القزاز (بلا خلفية)
  m.bright = m.bright or 3.5
  -- لوحات الصدام: القيم المشتركة في جدول، واللوحات في مصفوفة نقية.
  -- ⚠️ الخلط بينهما كان يفسد الحفظ: JSON يحوّل [1][2][3] لمفاتيح نصية فترجع nil
  -- ويموت رسم القسم كله عند أول قراءة بعد إعادة الدخول.
  -- نظّف أي bp قديم محفوظ بالصيغة المختلطة (كان يحمل مفاتيح "1","2","3" من JSON)
  if type(m.bp) == "table" and (m.bp[1] ~= nil or m.bp["1"] ~= nil) then m.bp = nil end
  m.bp = m.bp or { y = 0.40, z = -2.45, fg = 2, bg = 1 }
  m.bp.y = tonumber(m.bp.y) or 0.40
