  local czb = msg:match("^%$TeamKabos_CZ:(.+)$")
  if czb then
    if uSt.czOnMsg then pcall(function() uSt.czOnMsg(carIdx, czb) end) end
    return true
  end
  local czb2 = msg:match("^%$TeamKabos_CZB:(.+)$")
  if czb2 then
    if uSt.czOnMsgB then pcall(function() uSt.czOnMsgB(carIdx, czb2) end) end
    return true
  end
  -- Discord link code pushed by the server plugin -> show it inside the rules screen (renders Arabic), never as raw chat
  local code = msg:match("%$AS1980_CODE:([%w]+)")
  if code then
    linkCode = code
    isLinked = false
    rulesOpen = true
    return true
  end
  if msg:find("%$AS1980_LINKED") then
    isLinked = true
    linkCode = nil
    return true
  end
  if msg:find("%$AS1980_GETCODE") then return true end  -- suppress our own request echo
  if msg:find("%$TeamKabos_DRIFT:") then return true end   -- our own drift report echo
  -- Stats pushed by TeamKabosStatsPlugin:
  -- "$TeamKabos_STATS:<seconds>|<rank>|<of>|<level>|<bestDrift>|<activeSeconds>|<streak>|<bestStreak>"
  -- seconds = total time connected (shown as مجموع وقتك);
  -- activeSeconds = time driven at/above 190 km/h — this is what levels are made of.
  local ssec, srank, sof, slvl, sbest, sact, sstk, sbstk =
    msg:match("^%$TeamKabos_STATS:(%d+)|(%d+)|(%d+)|(%d+)|(%d+)|(%d+)|(%d+)|(%d+)$")
  if ssec then
    uSt.stSec = tonumber(ssec); uSt.stRank = tonumber(srank); uSt.stOf = tonumber(sof)
    uSt.stLevel = tonumber(slvl); uSt.stBest = tonumber(sbest); uSt.stAct = tonumber(sact)
    uSt.stStreak = tonumber(sstk); uSt.stBestStreak = tonumber(sbstk)
    uSt.stAt = pulseT
    return true
  end
  -- جدول أوضاع السرعة من TeamKabosSpeedModePlugin:
  -- "$TeamKabos_MODES:<رقم اللاعب>=<0/1>,<رقم>=<0/1>,..."
  local modes = msg:match("^%$TeamKabos_MODES:(.*)$")
  if modes then
    uSt.peerMode = {}
    for idx, md in modes:gmatch("(%d+)=(%d+)") do
      local i = tonumber(idx)
      if i then uSt.peerMode[i] = tonumber(md) end
    end
    uSt.visTick = 0
    return true
  end
  if msg:find("^%$TeamKabos_MODE:") then return true end
  if msg:find("^%$KB_TPPERM:") then return true end   -- صدى بثّي أنا
  if msg:find("^%$KB_BLK") then return true end   -- يشمل الطلب والقائمة
  if msg:find("^%$KB_TZ:") then return true end
  if msg:find("^%$TeamKabos_ACCT:") then return true end   -- صدى إرسالي أنا
  -- Older plugin build without the active field — never leak the raw marker into chat.
  if msg:find("^%$TeamKabos_STATS:") then return true end
  -- Tagged message from the plugin: "$AS1980_MSG:<color>|<emoji>|<tag>|<name>|<message>" -> name colored by Discord role
  local mcol, memo, mtag, mnm, mtxt = msg:match("^%$AS1980_MSG:([^|]*)|([^|]*)|([^|]*)|([^|]*)|(.*)$")
  if mnm then
    -- DiscordRolesPlugin wraps EVERY line it sees, markers included, so the payload itself can be
    -- a marker ($AS1980_DRIFT alone fires hundreds of times a day). Checking it here means the
    -- menu never renders protocol as speech no matter which plugin build the server runs.
    if mtxt:find("^%$AS1980_") or mtxt:find("^%$TeamKabos_") then return true end
    local rr, gg, bb = mcol:match("#?(%x%x)(%x%x)(%x%x)")
    local color = rr and rgbm(tonumber(rr, 16) / 255, tonumber(gg, 16) / 255, tonumber(bb, 16) / 255, 1) or nil
    local disp = mnm .. (mtag ~= "" and ("  " .. mtag) or "") .. (memo ~= "" and (" " .. memo) or "")
    -- GIF داخل رسالة ملفوفة من بلوقن Discord: [gif:الاسم] -> صورة بدل نص
    local wg = mtxt:match("^%[gif:(.+)%]$")
    local wgo = wg and uSt.gifFind(wg) or nil
    chatLog[#chatLog + 1] = { name = disp, text = wgo and "" or mtxt, gif = wgo, srv = false, color = color, rawName = mnm, t = pulseT }
    while #chatLog > CHAT_MAX do table.remove(chatLog, 1) end
    return true
  end
  -- Markers owned by the OTHER served scripts (clans_TeamKabos, voice_TeamKabos). Each script is its own Lua
  -- VM with its own ac.onChatMessage, so their returning true does nothing here — this chat would
  -- happily print them. A marker is never something a player should read.
  --
  -- It MUST sit below every real handler. When this line was above $AS1980_MSG it swallowed it,
  -- and every player with a Discord role went silent on all 11 servers without a single log line.
  if msg:find("^%$AS1980_") then return true end
  if msg:find("^%$TeamKabos_") then return true end

  -- 🧹 إخفاء ضجيج أوامر الأدمن ورسائل كشف CSP (تبقى في شات اللعبة لكن ما تدخل شاتنا)
  if msg:find("not an administrator") or msg:find("Unrecognized command")
     or msg:find("SYNTAX ERROR") or msg:find("No command found")
     or msg:find("An error occurred while executing") then return true end

  local srv = not carIdx or carIdx < 0


  local name = srv and "السيرفر" or (ac.getDriverName(carIdx) or ("لاعب " .. tostring(carIdx)))
  if not srv and uSt.blkEff(name) then return true end
  local shown = translateServer(msg)
  -- رسالة الإدارة العامة تصل كرسالة سيرفر: تُعرض بالشريط ١٠ ثوانٍ حسب إعداد اللاعب
  if srv and shown ~= "" and not msg:find("^%$") and not msg:find("^دخل") and not msg:find("^خرج") then
    if not uSt.sget("pmPublic", true) then return true end
    uSt.noteAdd("الإدارة", shown, "admin")
    if uSt.sget("pmStyle", 0) == 0 then
      uSt.barShow("الإدارة", shown, "admin", 10)
      return true
    end
  end
  chatLog[#chatLog + 1] = { name = name, text = shown, srv = srv, rawName = (not srv) and name or nil, t = pulseT }
  while #chatLog > CHAT_MAX do table.remove(chatLog, 1) end
  return true
end)
