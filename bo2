uSt.cardFx = function(x, y, w, h, acc, alpha)
  if uSt.sget("glowEdges", true) == false then return end
  alpha = alpha or 1
  local A  = math.max(52, math.min(110, math.min(w, h) * 0.42))  -- ذراع الزاوية (أطول وأوضح)
  local HL = A * 0.85                                             -- طول اللمعة المتحركة
  local I  = 2                                                    -- إزاحة للداخل حتى لا تُقصّ

  -- النواة الساطعة تبقى بلون المظهر المختار (نسخة أفتح منه) — لا أبيض، حتى يظل اللون واضحاً
  local hot = rgbm(math.min(1, acc.r * 1.35 + 0.18),
                   math.min(1, acc.g * 1.35 + 0.18),
                   math.min(1, acc.b * 1.35 + 0.18), 1)
  -- خط بأربع طبقات: هالة عريضة باهتة ← نواة ساطعة بلون المظهر
  local function glowLine(ax, ay, bx, by, k)
    local p1, p2 = vec2(ax, ay), vec2(bx, by)
    ui.drawLine(p1, p2, rgbm(acc.r, acc.g, acc.b, 0.10 * k * alpha), 9)
    ui.drawLine(p1, p2, rgbm(acc.r, acc.g, acc.b, 0.28 * k * alpha), 5.5)
    ui.drawLine(p1, p2, rgbm(acc.r, acc.g, acc.b, 0.90 * k * alpha), 2.6)
    ui.drawLine(p1, p2, rgbm(hot.r, hot.g, hot.b, 0.95 * k * alpha), 1.2)
  end

  -- قوس زاوية ثابت خافت: يوضّح الحد دائماً
  local function bracket(x1, y1, x2, y2, x3, y3)
    ui.drawLine(vec2(x1, y1), vec2(x2, y2), rgbm(acc.r, acc.g, acc.b, 0.30 * alpha), 2)
    ui.drawLine(vec2(x2, y2), vec2(x3, y3), rgbm(acc.r, acc.g, acc.b, 0.30 * alpha), 2)
  end

  -- اللمعة تسير على مسار القوس، وتخفت عند طرفيه فتبدو كأنها تدور حول الزاوية
  local function arm(x1, y1, x2, y2, x3, y3, ph)
    bracket(x1, y1, x2, y2, x3, y3)
    local total = A * 2
    local d = (ph % 1) * (total + HL) - HL
    local function seg(ax, ay, bx, by, s0, s1)
      local lo, hi = math.max(s0, d), math.min(s1, d + HL)
      if hi <= lo then return end
      local t0, t1 = (lo - s0) / (s1 - s0), (hi - s0) / (s1 - s0)
      local mid = ((lo + hi) * 0.5) / total
      local k = math.sin(math.max(0, math.min(1, mid)) * math.pi)   -- سطوع يزداد بالمنتصف
      if k <= 0.03 then return end
      glowLine(ax + (bx - ax) * t0, ay + (by - ay) * t0,
               ax + (bx - ax) * t1, ay + (by - ay) * t1, k)
    end
    seg(x1, y1, x2, y2, 0, A)
    seg(x2, y2, x3, y3, A, total)
    -- ومضة عند رأس الزاوية نفسها لحظة مرور اللمعة عليها
    local cd = math.abs((d + HL * 0.5) - A) / (HL * 0.6)
    if cd < 1 then
      local s = (1 - cd)
      ui.drawCircleFilled(vec2(x2, y2), 13 * s, rgbm(acc.r, acc.g, acc.b, 0.22 * s * alpha), 16)
      ui.drawCircleFilled(vec2(x2, y2), 6 * s,  rgbm(acc.r, acc.g, acc.b, 0.60 * s * alpha), 12)
      ui.drawCircleFilled(vec2(x2, y2), 2.6 * s, rgbm(hot.r, hot.g, hot.b, 0.98 * s * alpha), 10)
    end
  end

  local ph = pulseT * 0.20
  arm(x + w - A, y + I,     x + w - I, y + I,     x + w - I, y + A,     ph)        -- يمين فوق
  arm(x + A,     y + h - I, x + I,     y + h - I, x + I,     y + h - A, ph + 0.5)  -- يسار تحت
end


