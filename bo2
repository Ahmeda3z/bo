-- كاميرا حرّة، بلا واجهة، مع الفلاتر في متناول اليد.
uSt.photoOn = function()
  if uSt.photo then return end
  uSt.photo, uSt.photoBar, uSt.photoAt = true, false, pulseT
  pcall(function()
    local s = ac.getSim()
    uSt.photoCam = s and s.cameraMode or nil
    if ac.setCurrentCamera ~= nil and ac.CameraMode ~= nil then
      ac.setCurrentCamera(ac.CameraMode.Free)
    end
  end)
  -- لافتات الأسماء تختفي من الصورة
  pcall(function()
    local s = ac.getSim()
    for i = 0, ((s and s.carsCount) or 24) - 1 do pcall(ac.hideCarLabels, i, true) end
  end)
end

uSt.photoOff = function()
  if not uSt.photo then return end
  uSt.photo = false
  uSt.phOrbit = false
  if uSt.phCam ~= nil then
    pcall(function() uSt.phCam.ownShare = 0; uSt.phCam:dispose() end)
    uSt.phCam = nil
  end
  pcall(function()
    if ac.setCurrentCamera == nil then return end
    if uSt.photoCam ~= nil then ac.setCurrentCamera(uSt.photoCam)
    elseif ac.CameraMode ~= nil then ac.setCurrentCamera(ac.CameraMode.Cockpit) end
  end)
  -- الأسماء تعود — إلا لمن هو محجوب فيبقى محجوباً
  pcall(function()
    local s = ac.getSim()
    local set = uSt.isoSet()
    for i = 0, ((s and s.carsCount) or 24) - 1 do
      if set[uSt.realName(i) or "\1"] ~= true then pcall(ac.hideCarLabels, i, false) end
    end
  end)
end

