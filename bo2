uSt.phSlider = function(id, x, y, w, val, lo, hi, mp, down, clicked, col)
  local h = 10
  local t = math.max(0, math.min(1, (val - lo) / (hi - lo)))
  local hot = mp ~= nil and mp.x >= x - 6 and mp.x <= x + w + 6
              and mp.y >= y - 9 and mp.y <= y + h + 9
  if hot and clicked then uSt.phDrag = id end
  if not down and uSt.phDrag == id then uSt.phDrag = nil end
  if uSt.phDrag == id and mp ~= nil then
    t = math.max(0, math.min(1, (mp.x - x) / w))
    val = lo + t * (hi - lo)
  end
  -- مجرى غائر + تعبئة متوهّجة + مقبض معدني (بأسلوب لوحة التحكّم)
  ui.drawRectFilled(vec2(x, y + 1), vec2(x + w, y + h + 1), rgbm(0, 0, 0, 0.35), 6)
  ui.drawRectFilled(vec2(x, y), vec2(x + w, y + h), rgbm(1, 1, 1, 0.06), 6)
  ui.drawRect(vec2(x, y), vec2(x + w, y + h), rgbm(1, 1, 1, 0.10), 6, nil, 1)
  for q = 0, 9 do            -- تدريجات
    local gx = x + w * (q / 9)
    ui.drawRectFilled(vec2(gx, y + h + 3), vec2(gx + 1, y + h + 6), rgbm(1, 1, 1, 0.14), 0)
  end
  if t > 0.001 then
    ui.drawRectFilled(vec2(x, y), vec2(x + w * t, y + h), rgbm(col.r, col.g, col.b, 0.70), 6)
    ui.drawRectFilled(vec2(x, y + h * 0.5 - 1), vec2(x + w * t, y + h * 0.5 + 1), rgbm(1, 1, 1, 0.22), 0)
  end
  local kx, ky = x + w * t, y + h * 0.5
  ui.drawCircleFilled(vec2(kx, ky), 10, rgbm(col.r, col.g, col.b, 0.22), 20)
  ui.drawCircleFilled(vec2(kx, ky), 7.5, rgbm(0.90, 0.93, 0.97, 1), 20)
  ui.drawCircleFilled(vec2(kx, ky), 5.5, rgbm(0.16, 0.17, 0.20, 1), 18)
  ui.drawCircleFilled(vec2(kx, ky), 3,
    (hot or uSt.phDrag == id) and col or rgbm(0.62, 0.66, 0.72, 1), 12)
  return val
end

uSt.photoDraw = function(sim)
  if not uSt.photo or sim == nil then return end
  local SW, SH = sim.windowWidth, sim.windowHeight
  if type(SW) ~= "number" or SW < 16 then return end


  -- ═══ كاميرا المدار ═══
  if uSt.phOrbit then
    pcall(function()
      if uSt.phCam == nil and ac.grabCamera ~= nil then
        uSt.phCam = ac.grabCamera('T1 photo orbit')
      end
      local car = ac.getCar(0)
      if uSt.phCam ~= nil and car ~= nil and car.position ~= nil then
        local yaw = math.rad(uSt.phYaw or 180)
        local pit = math.rad(uSt.phPitch or 12)
        local d = uSt.phDist or 8
        local cp = car.position
        local tx, ty, tz = cp.x, cp.y + 0.75, cp.z
        local px2 = tx + math.sin(yaw) * math.cos(pit) * d
        local pz2 = tz + math.cos(yaw) * math.cos(pit) * d
        local py2 = ty + math.sin(pit) * d
        uSt.phCam.transform.position = vec3(px2, py2, pz2)
        uSt.phCam.transform.look = vec3(tx - px2, ty - py2, tz - pz2):normalize()
        uSt.phCam.transform.up = vec3(0, 1, 0)
        uSt.phCam.fov = tonumber(stor.pipFov) or 60
        uSt.phCam.ownShare = 1
      end
    end)
  elseif uSt.phCam ~= nil then
    pcall(function() uSt.phCam.ownShare = 0; uSt.phCam:dispose() end)
    uSt.phCam = nil
  end

  if not uSt.photoBar then return end

  -- ═══ الأبعاد: الارتفاع يتبع التبويب فلا تتداخل الأزرار ═══
  local BW = math.max(560, math.min(tonumber(stor.phW) or 880, SW - 40))
  local HEAD, FOOT = 96, 30
  local body = 132
  if uSt.phTab == 1 then body = 3 * 32 + 34            -- ٣ صفوف فلاتر + الشدّة
  elseif uSt.phTab == 2 then body = 3 * 30 + 4         -- ٣ مؤشّرات
  elseif uSt.phTab == 4 then body = 60                 -- مفتاح لوحة الاسم
  else body = 200 end                            -- مدار · أوضاع · بُعد · عدسة
  local BH = HEAD + body + FOOT + (tonumber(stor.phPad) or 0)

  local bx0 = tonumber(stor.phX) or -1
  local by0 = tonumber(stor.phY) or -1
  if bx0 < 0 then bx0 = math.floor((SW - BW) * 0.5) end
  if by0 < 0 then by0 = math.floor(SH * 0.42) end
  bx0 = math.max(0, math.min(bx0, SW - BW))
  by0 = math.max(0, math.min(by0, SH - BH))

  -- استشعار الفأرة بلا التقاط نقر
  local mpG = nil
  ui.transparentWindow("photoProbe", vec2(0, 0), vec2(SW, SH), true, false, function()
    mpG = ui.mousePos()
  end)
  if mpG ~= nil and mpG.x >= bx0 - 90 and mpG.x <= bx0 + BW + 90
     and mpG.y >= by0 - 90 and mpG.y <= by0 + BH + 90 then
    uSt.phSeen = pulseT
  end
  if uSt.phMove ~= nil then uSt.phSeen = pulseT end
  -- تبقى ظاهرة ما دامت مفتوحة (لا تحتاج تمرير الماوس ولا تختفي وحدها)
  local A = 1

  ui.transparentWindow("photoBarTeamKabos", vec2(bx0, by0), vec2(BW, BH), true, true, function()
    local mpA = ui.mousePos()
    local mp = mpA and vec2(mpA.x - bx0, mpA.y - by0) or nil
    local down = ui.mouseDown(ui.MouseButton.Left)
    local clicked = ui.mouseClicked(ui.MouseButton.Left)
    local function inR(x, y, w, h)
      return mp ~= nil and mp.x >= x and mp.x <= x + w and mp.y >= y and mp.y <= y + h
    end

    -- ═══ الجهاز: إطار معدني + شاشة زجاجية (بأسلوب لوح تحكّم) ═══
    local R = 26
    ui.drawRectFilled(vec2(5, 8), vec2(BW + 5, BH + 8), rgbm(0, 0, 0, 0.50 * A), R)
    ui.drawRectFilled(vec2(-5, -5), vec2(BW + 5, BH + 5), rgbm(ACC.r, ACC.g, ACC.b, 0.13 * A), R + 5)
    -- الإطار المعدني
    ui.drawRectFilled(vec2(0, 0), vec2(BW, BH), rgbm(0.105, 0.115, 0.135, 0.99 * A), R)
    ui.drawRect(vec2(0, 0), vec2(BW, BH), rgbm(ACC.r, ACC.g, ACC.b, 0.80 * A), R, nil, 1.8)
    ui.drawRect(vec2(3, 3), vec2(BW - 3, BH - 3), rgbm(1, 1, 1, 0.07 * A), R - 3, nil, 1)
    -- الشاشة الزجاجية بتدرّج
    local SX0, SY0, SX1, SY1 = 10, 10, BW - 10, BH - 22
    do
      local segs = 18
      for q = 0, segs - 1 do
        local f = q / segs
        local y0 = SY0 + (SY1 - SY0) * f
        local y1 = SY0 + (SY1 - SY0) * (q + 1) / segs
        local v = 0.055 - 0.022 * f
        ui.drawRectFilled(vec2(SX0, y0), vec2(SX1, y1), rgbm(v, v + 0.008, v + 0.020, 0.97 * A),
          (q == 0 or q == segs - 1) and (R - 12) or 0)
      end
      ui.drawRect(vec2(SX0, SY0), vec2(SX1, SY1), rgbm(ACC.r, ACC.g, ACC.b, 0.35 * A), R - 12, nil, 1)
      -- انعكاس زجاجي علوي
      ui.drawRectFilled(vec2(SX0 + 6, SY0 + 3), vec2(SX1 - 6, SY0 + 12), rgbm(1, 1, 1, 0.035 * A), 8)
    end
    -- كاميرا/مستشعر أعلى الإطار + مؤشّر تشغيل نابض
    do
      local p = 0.55 + 0.45 * math.abs(math.sin(pulseT * 1.8))
      ui.drawCircleFilled(vec2(BW * 0.5 - 16, 6), 2.2, rgbm(1, 1, 1, 0.18 * A), 10)
      ui.drawCircleFilled(vec2(BW * 0.5, 6), 3, rgbm(ACC.r, ACC.g, ACC.b, 0.9 * p * A), 12)
      ui.drawCircleFilled(vec2(BW * 0.5 + 16, 6), 2.2, rgbm(1, 1, 1, 0.18 * A), 10)
    end
    -- شريط الهوم أسفل الجهاز (يعمل كمقبض سحب)
    do
      local hbx, hby = BW * 0.5 - 55, BH - 15
      local hv3 = inR(hbx, hby, 110, 12)
      ui.drawRectFilled(vec2(hbx, hby + 2), vec2(hbx + 110, hby + 6),
        rgbm(1, 1, 1, (hv3 and 0.45 or 0.22) * A), 3)
      if hv3 and clicked then uSt.phMove = { mp.x, mp.y, bx0, by0 } end
    end
    -- مقبض التحجيم: الزاوية السفلية اليسرى
    do
      local gx, gy = 10, BH - 22
      local hv4 = inR(gx, gy, 20, 18)
      for q = 0, 2 do
        ui.drawLine(vec2(gx + 2 + q * 5, gy + 15), vec2(gx + 15, gy + 2 + q * 5),
          rgbm(1, 1, 1, (hv4 and 0.75 or 0.35) * A), 1.6)
      end
      if hv4 and clicked then uSt.phSize = { mp.x, BW, mp.y, tonumber(stor.phPad) or 0 } end
      if uSt.phSize ~= nil then
        if down then
          local mpA2 = ui.mousePos()
          if mpA2 then
            stor.phW = math.max(560, math.min(1400, uSt.phSize[2] + ((bx0 + uSt.phSize[1]) - mpA2.x) * 2))
            stor.phPad = math.max(0, math.min(260, uSt.phSize[4] + (mpA2.y - (by0 + uSt.phSize[3]))))
          end
        else uSt.phSize = nil end
      end
    end
    -- ═══ شريط السحب: كل الرأس عدا الأزرار ═══
    do
      local onTabs = inR(10, 8, 3 * 102, 30) or inR(BW - 114, 8, 104, 30)
                     or inR(BW - 262, 8, 142, 30)
      if inR(0, 0, BW, HEAD - 4) and not onTabs and clicked and mpA ~= nil then
        uSt.phMove = { mx = mpA.x, my = mpA.y, ox = bx0, oy = by0 }
      end
      if not down then uSt.phMove = nil end
      if uSt.phMove ~= nil and mpA ~= nil then
        stor.phX = math.floor(uSt.phMove.ox + (mpA.x - uSt.phMove.mx))
        stor.phY = math.floor(uSt.phMove.oy + (mpA.y - uSt.phMove.my))
      end
      -- مقبض السحب: ثلاث نقاط
      for q = 0, 2 do
        ui.drawCircleFilled(vec2(BW * 0.5 - 8 + q * 8, 5), 1.6, rgbm(1, 1, 1, 0.30 * A), 8)
      end
    end

    -- التبويبات
    -- ═══ شاشة LCD صغيرة بمعلومات حيّة ═══
    do
      local LX, LY, LW2, LH2 = 16, 14, math.max(150, math.min(250, BW * 0.28)), 40
      ui.drawRectFilled(vec2(LX, LY), vec2(LX + LW2, LY + LH2), rgbm(0.02, 0.05, 0.05, 0.95 * A), 8)
      ui.drawRect(vec2(LX, LY), vec2(LX + LW2, LY + LH2), rgbm(0.20, 0.85, 0.70, 0.55 * A), 8, nil, 1.2)
      for q = 0, math.floor(LH2 / 3) do        -- خطوط مسح LCD
        ui.drawRectFilled(vec2(LX + 2, LY + q * 3), vec2(LX + LW2 - 2, LY + q * 3 + 1), rgbm(0, 0, 0, 0.10 * A), 0)
      end
      local sp, gr = 0, "-"
      pcall(function()
        local c0 = ac.getCar(0)
        if c0 then sp = math.floor(c0.speedKmh or 0); gr = tostring(c0.gear or 0) end
      end)
      local fnm = "بلا فلتر"
      pcall(function() fnm = uSt.FILTERS[(tonumber(stor.fxMode) or 0) + 1][1] end)
      dwLeftBox("PHOTO MODE", 10, LX + 10, LY + 5, 120, 12, rgbm(0.25, 0.95, 0.78, 0.9 * A))
      dwLeftBox(string.format("%3d KM/H", sp), 15, LX + 10, LY + 18, 90, 16, rgbm(0.45, 1.0, 0.85, A))
      dwRightBox(fnm, 12, LX + 100, LY + 19, LW2 - 112, 16, rgbm(0.30, 0.92, 0.80, 0.95 * A))
      local p2 = 0.4 + 0.6 * math.abs(math.sin(pulseT * 2.2))
      ui.drawCircleFilled(vec2(LX + LW2 - 12, LY + 10), 3, rgbm(0.25, 0.95, 0.75, p2 * A), 10)
    end

    -- ═══ أزرار دائرية بأسلوب جهاز الدرون ═══
    local TABS = { "الفلاتر", "الألوان", "الكاميرا", "العرض" }
    -- المساحة بين شاشة الـLCD وزرّي اليمين تُقسم على الأربعة فلا تتراكب أبداً
    local LEND = 16 + math.max(150, math.min(250, BW * 0.28)) + 16
    local REND = BW - 20 - 40 - 12 - 40 - 16
    local AVAIL = math.max(120, REND - LEND)
    local DIA = math.max(30, math.min(46, AVAIL / 4 - 12))
    local GAPD = math.max(6, math.min(16, AVAIL / 4 - DIA))
    for k = 1, 4 do
      local D = DIA
      local cx2 = LEND + (k - 1) * (D + GAPD) + D * 0.5
      local cy2 = 14 + 46 * 0.5
      local on = (uSt.phTab == k)
      local hv = inR(cx2 - D * 0.5, cy2 - D * 0.5, D, D)
      -- حلقة خارجية + قرص
      ui.drawCircleFilled(vec2(cx2, cy2), D * 0.5, rgbm(0.13, 0.14, 0.17, 0.98 * A), 30)
      ui.drawCircle(vec2(cx2, cy2), D * 0.5,
        on and rgbm(ACC.r, ACC.g, ACC.b, 0.95 * A) or rgbm(1, 1, 1, (hv and 0.35 or 0.16) * A), 30, on and 2.2 or 1.3)
      if on then
        ui.drawCircleFilled(vec2(cx2, cy2), D * 0.5 - 4, rgbm(ACC.r, ACC.g, ACC.b, 0.22 * A), 28)
        for q = 0, 11 do            -- توهّج دوّار
          local an = q * math.pi / 6 + pulseT * 1.2
          ui.drawCircleFilled(vec2(cx2 + math.cos(an) * (D * 0.5 + 3), cy2 + math.sin(an) * (D * 0.5 + 3)),
            1.4, rgbm(ACC.r, ACC.g, ACC.b, 0.5 * A), 6)
        end
      end
      local ic = on and rgbm(1, 1, 1, A) or rgbm(0.80, 0.84, 0.90, A)
      if k == 1 then
        ui.drawCircle(vec2(cx2 - 4, cy2 - 2), 7, ic, 16, 1.6)
        ui.drawCircle(vec2(cx2 + 4, cy2 + 2), 7, ic, 16, 1.6)
      elseif k == 2 then
        ui.drawCircleFilled(vec2(cx2, cy2 + 3), 6, ic, 16)
        ui.drawTriangleFilled(vec2(cx2 - 5, cy2 + 1), vec2(cx2 + 5, cy2 + 1), vec2(cx2, cy2 - 8), ic)
      elseif k == 3 then
        ui.drawRect(vec2(cx2 - 9, cy2 - 6), vec2(cx2 + 9, cy2 + 7), ic, 3, nil, 1.6)
        ui.drawCircle(vec2(cx2, cy2 + 1), 4, ic, 14, 1.5)
        ui.drawRectFilled(vec2(cx2 - 3, cy2 - 9), vec2(cx2 + 3, cy2 - 6), ic, 1)
      else
        ui.drawRect(vec2(cx2 - 9, cy2 - 7), vec2(cx2 + 9, cy2 + 3), ic, 2, nil, 1.6)
        ui.drawLine(vec2(cx2 - 2, cy2 + 3), vec2(cx2 - 4, cy2 + 9), ic, 1.5)
      end
      dwBox(TABS[k], 10, cx2 - (D + GAPD) * 0.5, cy2 + D * 0.5 + 2, D + GAPD, 12,
        on and rgbm(ACC.r, ACC.g, ACC.b, A) or rgbm(0.72, 0.76, 0.82, A))
      if hv and clicked then uSt.phTab = k end
    end

    -- ═══ زرّان دائريان: استعادة الافتراضية · إغلاق ═══
    do
      local D = 40
      local bx1 = BW - 20 - D
      local by1 = 16
      local hv1 = inR(bx1, by1, D, D)
      ui.drawCircleFilled(vec2(bx1 + D * 0.5, by1 + D * 0.5), D * 0.5, rgbm(0.55, 0.13, 0.15, (hv1 and 0.98 or 0.80) * A), 26)
      ui.drawCircle(vec2(bx1 + D * 0.5, by1 + D * 0.5), D * 0.5, rgbm(1, 0.45, 0.45, 0.75 * A), 26, 1.5)
      do
        local px, py = bx1 + D * 0.5, by1 + D * 0.5
        ui.drawCircle(vec2(px, py), 8, rgbm(1, 1, 1, 0.95 * A), 20, 1.9)
        ui.drawRectFilled(vec2(px - 1.2, py - 12), vec2(px + 1.2, py - 3), rgbm(1, 1, 1, 0.95 * A), 1)
      end
      if hv1 and clicked then uSt.photoOff(); return end

      local bx2 = bx1 - D - 12
      local hv2 = inR(bx2, by1, D, D)
      ui.drawCircleFilled(vec2(bx2 + D * 0.5, by1 + D * 0.5), D * 0.5, rgbm(0.12, 0.42, 0.28, (hv2 and 0.98 or 0.80) * A), 26)
      ui.drawCircle(vec2(bx2 + D * 0.5, by1 + D * 0.5), D * 0.5, rgbm(0.45, 1, 0.70, 0.7 * A), 26, 1.5)
      do
        local px, py = bx2 + D * 0.5, by1 + D * 0.5
        ui.drawCircle(vec2(px, py), 8, rgbm(1, 1, 1, 0.95 * A), 20, 1.8)
        ui.drawTriangleFilled(vec2(px + 5, py - 10), vec2(px + 11, py - 6), vec2(px + 4, py - 3), rgbm(1, 1, 1, 0.95 * A))
      end
      if hv2 and clicked then
        stor.fxHue, stor.fxSat, stor.fxBri = 0, 100, 100
        stor.fxPower, stor.fxMode = 100, 0
        uSt.phYaw, uSt.phPitch, uSt.phDist = 180, 12, 8
        stor.pipFov = 60
        uSt.fxApply()
      end
      dwBox("إغلاق", 9, bx1 - 6, by1 + D + 2, D + 12, 12, rgbm(1, 0.6, 0.6, 0.9 * A))
      dwBox("استعادة", 9, bx2 - 6, by1 + D + 2, D + 12, 12, rgbm(0.6, 1, 0.8, 0.9 * A))
    end

    ui.drawRectFilled(vec2(12, HEAD - 4), vec2(BW - 12, HEAD - 3), rgbm(1, 1, 1, 0.10 * A), 1)

    local y = HEAD

    -- ═══════════ الفلاتر ═══════════
    if uSt.phTab == 1 then
      local per = 4
      local gw = (BW - 24 - (per - 1) * 6) / per
      local cur = tonumber(stor.fxMode) or 0
      for k = 1, #uSt.FILTERS do
        local row = math.floor((k - 1) / per)
        local cl2 = (k - 1) % per
        local cx = 12 + cl2 * (gw + 6)
        local cy = y + row * 32
        local on = (cur == k - 1)
        local c = uSt.FILTERS[k][2]
        local hv = inR(cx, cy, gw, 28)
        ui.drawRectFilled(vec2(cx, cy), vec2(cx + gw, cy + 28),
          on and rgbm(c.r, c.g, c.b, 0.34 * A)
               or (hv and rgbm(c.r, c.g, c.b, 0.18 * A) or rgbm(1, 1, 1, 0.05 * A)), 7)
        ui.drawRect(vec2(cx, cy), vec2(cx + gw, cy + 28),
          rgbm(c.r, c.g, c.b, (on and 0.95 or 0.30) * A), 7, nil, on and 1.6 or 1)
        ui.drawCircleFilled(vec2(cx + 12, cy + 14), 4.5, uSt.FILTERS[k][2], 12)
        dwBox(uSt.FILTERS[k][1], 10, cx + 8, cy, gw - 8, 28,
          on and rgbm(1, 1, 1, A) or rgbm(0.76, 0.80, 0.86, A))
        if hv and clicked then stor.fxMode = k - 1; uSt.fxApply() end
      end
      local sy = y + 3 * 32 + 6
      dwRightBox(uSt.rtl("الشدّة  " .. math.floor(tonumber(stor.fxPower) or 100) .. "٪"),
        11, 12, sy - 2, 96, 14, rgbm(0.80, 0.84, 0.90, A))
      local nv = uSt.phSlider("pw", 116, sy, BW - 128,
        tonumber(stor.fxPower) or 100, 10, 100, mp, down, clicked, ACC)
      if math.floor(nv) ~= math.floor(tonumber(stor.fxPower) or 100) then
        stor.fxPower = math.floor(nv); uSt.fxApply()
      end

    -- ═══════════ الألوان ═══════════
    elseif uSt.phTab == 2 then
      local hu = math.floor(tonumber(stor.fxHue) or 0)
      dwRightBox(uSt.rtl("درجة اللون  " .. hu .. "°"), 11, 12, y - 2, 96, 14,
        rgbm(0.80, 0.84, 0.90, A))
      do
        local x, yy2, w, h = 116, y, BW - 128, 10
        for k = 0, 47 do
          ui.drawRectFilled(vec2(x + w * k / 48, yy2), vec2(x + w * (k + 1) / 48, yy2 + h),
            uSt.hueCol(k / 48 * 359), 0)
        end
        local hot = mp ~= nil and mp.x >= x - 6 and mp.x <= x + w + 6
                    and mp.y >= yy2 - 9 and mp.y <= yy2 + h + 9
        if hot and clicked then uSt.phDrag = "hue" end
        if not down and uSt.phDrag == "hue" then uSt.phDrag = nil end
        if uSt.phDrag == "hue" and mp ~= nil then
          stor.fxHue = math.floor(math.max(0, math.min(1, (mp.x - x) / w)) * 359)
          uSt.fxApply()
        end
        local t = hu / 359
        ui.drawCircleFilled(vec2(x + w * t, yy2 + h * 0.5), 7, rgbm(1, 1, 1, A), 16)
        ui.drawCircleFilled(vec2(x + w * t, yy2 + h * 0.5), 4, uSt.hueCol(hu), 12)
      end
      dwRightBox(uSt.rtl("الإشباع  " .. math.floor(tonumber(stor.fxSat) or 100) .. "٪"),
        11, 12, y + 28, 96, 14, rgbm(0.80, 0.84, 0.90, A))
      local ns = uSt.phSlider("sat", 116, y + 30, BW - 128,
        tonumber(stor.fxSat) or 100, 0, 200, mp, down, clicked, ACC)
      if math.floor(ns) ~= math.floor(tonumber(stor.fxSat) or 100) then
        stor.fxSat = math.floor(ns); uSt.fxApply()
      end
      dwRightBox(uSt.rtl("السطوع  " .. math.floor(tonumber(stor.fxBri) or 100) .. "٪"),
        11, 12, y + 122, 96, 14, rgbm(0.80, 0.84, 0.90, A))
      local nb = uSt.phSlider("bri", 116, y + 60, BW - 128,
        tonumber(stor.fxBri) or 100, 20, 200, mp, down, clicked, ACC)
      if math.floor(nb) ~= math.floor(tonumber(stor.fxBri) or 100) then
        stor.fxBri = math.floor(nb); uSt.fxApply()
      end

    -- ═══════════ الكاميرا ═══════════
    elseif uSt.phTab == 4 then
      -- إظهار/إخفاء لوحة الاسم أثناء التصوير
      local on4 = (uSt.sget("npShow", true) ~= false)
      local hv4 = inR(12, y, BW - 24, 44)
      ui.drawRectFilled(vec2(12, y), vec2(BW - 12, y + 44), hv4 and rgbm(1, 1, 1, 0.10 * A) or rgbm(1, 1, 1, 0.05 * A), 12)
      ui.drawRect(vec2(12, y), vec2(BW - 12, y + 44), rgbm(1, 1, 1, 0.10 * A), 12, nil, 1)
      dwRightBox(uSt.rtl("إظهار لوحة الاسم فوق السيارات"), 14, 24, y + 12, BW - 200, 20, rgbm(0.93, 0.95, 0.98, A))
      dwBox(on4 and "مُفعّل" or "مُطفأ", 12, BW - 190, y + 13, 84, 18,
        on4 and rgbm(0.45, 1, 0.72, A) or rgbm(1, 0.6, 0.6, A))
      local sx4 = BW - 86
      ui.drawRectFilled(vec2(sx4, y + 12), vec2(sx4 + 50, y + 32), on4 and rgbm(0.20, 0.72, 0.42, A) or rgbm(0.32, 0.34, 0.40, A), 10)
      ui.drawCircleFilled(vec2(on4 and (sx4 + 39) or (sx4 + 11), y + 22), 8, rgbm(1, 1, 1, 0.97 * A), 18)
      if hv4 and clicked then uSt.sset("npShow", not on4) end
      y = y + 52
    elseif uSt.phTab == 4 then
      -- لوحة الاسم أثناء التصوير
      local function swRow(lbl, val, yy2, id2)
        local hv2 = inR(12, yy2, BW - 24, 36)
        ui.drawRectFilled(vec2(12, yy2), vec2(BW - 12, yy2 + 36), hv2 and rgbm(1, 1, 1, 0.10 * A) or rgbm(1, 1, 1, 0.05 * A), 9)
        dwRightBox(uSt.rtl(lbl), 13, 22, yy2 + 8, BW - 120, 20, rgbm(0.92, 0.94, 0.97, A))
        local sx2 = BW - 78
        ui.drawRectFilled(vec2(sx2, yy2 + 9), vec2(sx2 + 44, yy2 + 27), val and rgbm(0.20, 0.72, 0.42, A) or rgbm(0.34, 0.36, 0.42, A), 9)
        ui.drawCircleFilled(vec2(val and (sx2 + 34) or (sx2 + 10), yy2 + 18), 7, rgbm(1, 1, 1, 0.96 * A), 16)
        return hv2 and clicked
      end
      -- إظهار/إخفاء لوحة الاسم (لوحتنا)
      if swRow("إظهار لوحة الاسم", uSt.sget("npVanilla", false) == false and uSt.sget("npShow", true) ~= false, y, "a") then
        uSt.sset("npShow", not (uSt.sget("npShow", true) ~= false))
      end
      y = y + 44
      -- استعمال لوحة اللعبة الأصلية
      if swRow("لوحة اللعبة الأصلية", uSt.sget("npVanilla", false) == true, y, "b") then
        uSt.sset("npVanilla", not (uSt.sget("npVanilla", false) == true))
        local s2 = ac.getSim()
        for i2 = 0, ((s2 and s2.carsCount) or 24) - 1 do
          pcall(ac.hideCarLabels, i2, uSt.sget("npVanilla", false) and false or true)
        end
      end
      y = y + 44
    else
      -- صفّ ١: مفتاح المدار + الأسهم
      do
        local on = (uSt.phOrbit == true)
        local hv = inR(12, y, 132, 26)
        ui.drawRectFilled(vec2(12, y), vec2(144, y + 26),
          on and rgbm(0.18, 0.62, 0.38, 0.90 * A)
               or rgbm(1, 1, 1, (hv and 0.15 or 0.06) * A), 7)
        ui.drawRect(vec2(12, y), vec2(144, y + 26),
          on and rgbm(0.30, 0.85, 0.52, 0.95 * A) or rgbm(1, 1, 1, 0.18 * A), 7, nil, 1.2)
        dwBox(uSt.rtl(on and "المدار يعمل ✓" or "شغّل كاميرا ٣٦٠"), 11, 12, y, 132, 26,
          rgbm(1, 1, 1, A))
        if hv and clicked then uSt.phOrbit = not on end

        -- لوح اتجاهات دائري (D-Pad) بأسلوب جهاز الدرون
        do
          local A4 = { { -1, 0 }, { 1, 0 }, { 0, 1 }, { 0, -1 } }
          local ox, oy, rr = 154 + 60, y + 30, 34
          ui.drawCircleFilled(vec2(ox, oy + 2), rr + 12, rgbm(0, 0, 0, 0.40 * A), 34)
          ui.drawCircleFilled(vec2(ox, oy), rr + 12, rgbm(0.085, 0.095, 0.115, 0.98 * A), 34)
          ui.drawCircle(vec2(ox, oy), rr + 12, rgbm(1, 1, 1, 0.14 * A), 34, 1.4)
          ui.drawCircle(vec2(ox, oy), rr + 4, rgbm(1, 1, 1, 0.06 * A), 30, 1)
          for q = 1, 4 do
            local dx, dy = A4[q][1], -A4[q][2]
            local px, py = ox + dx * rr * 0.72, oy + dy * rr * 0.72
            local hv2 = mp ~= nil and (mp.x - px) * (mp.x - px) + (mp.y - py) * (mp.y - py) < 256
            -- زرّ محدّب: ظلّ + قرص + حافة مضيئة
            ui.drawCircleFilled(vec2(px, py + 1.5), 15, rgbm(0, 0, 0, 0.45 * A), 22)
            ui.drawCircleFilled(vec2(px, py), 15,
              hv2 and rgbm(ACC.r, ACC.g, ACC.b, 0.92 * A) or rgbm(0.20, 0.21, 0.25, 0.98 * A), 22)
            ui.drawCircle(vec2(px, py), 15, rgbm(1, 1, 1, (hv2 and 0.55 or 0.16) * A), 22, 1.3)
            ui.drawCircleFilled(vec2(px, py - 3), 9, rgbm(1, 1, 1, 0.05 * A), 18)
            local ic = hv2 and DK or rgbm(0.92, 0.94, 0.98, A)
            local s2 = 6.0
            if dx ~= 0 then
              ui.drawTriangleFilled(vec2(px - dx * s2, py - s2), vec2(px - dx * s2, py + s2), vec2(px + dx * s2 * 1.3, py), ic)
            else
              ui.drawTriangleFilled(vec2(px - s2, py - dy * s2), vec2(px + s2, py - dy * s2), vec2(px, py + dy * s2 * 1.3), ic)
            end
            if hv2 and down then
              uSt.phOrbit = true
              uSt.phYaw = ((uSt.phYaw or 180) + A4[q][1] * 2.4) % 360
              uSt.phPitch = math.max(-30, math.min(85, (uSt.phPitch or 12) + A4[q][2] * 1.4))
            end
          end
          ui.drawCircleFilled(vec2(ox, oy), 9, rgbm(0.16, 0.17, 0.21, A), 18)
          ui.drawCircle(vec2(ox, oy), 9, rgbm(1, 1, 1, 0.12 * A), 18, 1)
          ui.drawCircleFilled(vec2(ox, oy), 3, rgbm(ACC.r, ACC.g, ACC.b, 0.7 * A), 10)
        end
        dwLeftBox(uSt.rtl("الزاوية " .. math.floor(uSt.phYaw or 180) .. "°  ·  الميل "
          .. math.floor(uSt.phPitch or 12) .. "°"), 10, 300, y + 24, BW - 312, 16,
          rgbm(0.66, 0.70, 0.78, A))
      end
      -- صفّ ٢: أوضاع سريعة
      do
        local P4 = { { "خلف", 180, 12 }, { "أمام", 0, 12 }, { "يمين", 90, 12 },
                     { "يسار", 270, 12 }, { "علوي", 180, 78 } }
        for q = 1, 5 do
          local bw2 = (BW - 24 - 4 * 8) / 5
          local bx = 12 + (q - 1) * (bw2 + 8)
          local by2 = y + 76
          local hv = inR(bx, by2, bw2, 34)
          local on = (math.abs((uSt.phYaw or 180) - P4[q][2]) < 1 and math.abs((uSt.phPitch or 12) - P4[q][3]) < 1)
          ui.drawRectFilled(vec2(bx, by2 + 1), vec2(bx + bw2, by2 + 35), rgbm(0, 0, 0, 0.35 * A), 9)
          ui.drawRectFilled(vec2(bx, by2), vec2(bx + bw2, by2 + 34),
            on and rgbm(ACC.r, ACC.g, ACC.b, 0.32 * A) or rgbm(1, 1, 1, (hv and 0.15 or 0.06) * A), 9)
          ui.drawRect(vec2(bx, by2), vec2(bx + bw2, by2 + 34),
            on and rgbm(ACC.r, ACC.g, ACC.b, 0.9 * A) or rgbm(1, 1, 1, 0.16 * A), 9, nil, on and 1.6 or 1)
          -- أيقونة: سيارة صغيرة + سهم الاتجاه
          do
            local ic = on and rgbm(1, 1, 1, A) or rgbm(0.86, 0.89, 0.94, A)
            local cx3, cy3 = bx + 18, by2 + 17
            ui.drawRectFilled(vec2(cx3 - 7, cy3 - 4), vec2(cx3 + 7, cy3 + 4), rgbm(ic.r, ic.g, ic.b, 0.55 * A), 2)
            ui.drawRectFilled(vec2(cx3 - 4, cy3 - 7), vec2(cx3 + 4, cy3 - 3), rgbm(ic.r, ic.g, ic.b, 0.35 * A), 1)
            local ax2, ay2 = cx3, cy3
            if q == 1 then      ui.drawTriangleFilled(vec2(ax2 - 3, cy3 + 10), vec2(ax2 + 3, cy3 + 10), vec2(ax2, cy3 + 15), ic)
            elseif q == 2 then  ui.drawTriangleFilled(vec2(ax2 - 3, cy3 - 10), vec2(ax2 + 3, cy3 - 10), vec2(ax2, cy3 - 15), ic)
            elseif q == 3 then  ui.drawTriangleFilled(vec2(cx3 + 10, ay2 - 3), vec2(cx3 + 10, ay2 + 3), vec2(cx3 + 15, ay2), ic)
            elseif q == 4 then  ui.drawTriangleFilled(vec2(cx3 - 10, ay2 - 3), vec2(cx3 - 10, ay2 + 3), vec2(cx3 - 15, ay2), ic)
            else                ui.drawCircle(vec2(cx3, cy3 - 11), 4, ic, 12, 1.4)
                                ui.drawLine(vec2(cx3, cy3 - 7), vec2(cx3, cy3 - 5), ic, 1.4) end
          end
          dwBox(P4[q][1], 11, bx + 30, by2 + 8, bw2 - 38, 18,
            on and rgbm(1, 1, 1, A) or rgbm(0.86, 0.89, 0.94, A))
          if hv and clicked then
            uSt.phOrbit = true
            uSt.phYaw, uSt.phPitch = P4[q][2], P4[q][3]
          end
        end
      end
      -- صفّ ٣: البُعد (حتى السماء)
      dwRightBox(uSt.rtl("البُعد  " .. math.floor(uSt.phDist or 8) .. " م"),
        11, 12, y + 58, 96, 14, rgbm(0.80, 0.84, 0.90, A))
      uSt.phDist = uSt.phSlider("dist", 116, y + 124, BW - 128,
        uSt.phDist or 8, 2, 300, mp, down, clicked, ACC)
      -- صفّ ٤: زاوية العدسة
      dwRightBox(uSt.rtl("زاوية العدسة  " .. math.floor(tonumber(stor.pipFov) or 60) .. "°"),
        11, 12, y + 152, 96, 14, rgbm(0.80, 0.84, 0.90, A))
      local nf = uSt.phSlider("fov", 116, y + 154, BW - 128,
        tonumber(stor.pipFov) or 60, 10, 140, mp, down, clicked, ACC)
      if math.floor(nf) ~= math.floor(tonumber(stor.pipFov) or 60) then
        stor.pipFov = math.floor(nf)
        pcall(function() ac.setCameraFOV(stor.pipFov) end)
      end
    end

    dwLeftBox(uSt.rtl("اسحب من الأعلى لنقلها  ·  تختفي بعد ١٠ ثوانٍ"), 9,
      12, BH - 16, 280, 12, rgbm(0.48, 0.52, 0.58, A))
  end)
end


-- ═══ أزرار وضع التصوير (ريموت كنترول + إغلاق) ═══
uSt.photoUI = function(sim)
  if not uSt.photo then return end
  if uSt.photoBar then return end
  local sw = sim.windowWidth

  -- ريموت كنترول أعلى الشاشة، وتحته زرّ إغلاق وضع التصوير
  local RW, RH = 210, 46
  local rx = math.floor((sw - RW) * 0.5)
  local ry = 84
  ui.transparentWindow("kbPhotoRemote", vec2(rx, ry), vec2(RW, RH + 46), true, true, function()
    -- ── زرّ الريموت ──
    ui.setCursor(vec2(0, 0))
    local cl = ui.invisibleButton("##phremote", vec2(RW, RH))
    local hov = ui.itemHovered()
    ui.drawRectFilled(vec2(-3, -3), vec2(RW + 3, RH + 3), rgbm(ACC.r, ACC.g, ACC.b, 0.12), 14)
    ui.drawRectFilled(vec2(0, 0), vec2(RW, RH), hov and rgbm(ACC.r, ACC.g, ACC.b, 0.92) or rgbm(0.05, 0.06, 0.09, 0.9), 12)
    ui.drawRect(vec2(0.5, 0.5), vec2(RW - 0.5, RH - 0.5), rgbm(ACC.r, ACC.g, ACC.b, 0.75), 12, nil, 1.4)
    pcall(function() uSt.cardFx(0, 0, RW, RH, ACC, 1) end)
    local c = hov and DK or CW
    ui.drawRect(vec2(14, 10), vec2(36, 36), c, 5, nil, 1.7)
    ui.drawCircleFilled(vec2(25, 18), 2.6, c, 8)
    ui.drawCircleFilled(vec2(20, 27), 2.1, c, 8)
    ui.drawCircleFilled(vec2(30, 27), 2.1, c, 8)
    dwBox("ريموت كنترول", 15, 42, 13, RW - 54, 20, c)
    if cl then uSt.photoBar = true; uSt.photoAt = pulseT end

    -- ── زرّ إغلاق وضع التصوير: تحته، بعلامة زرّ التشغيل ──
    local by = RH + 8
    ui.setCursor(vec2(18, by))
    local cl2 = ui.invisibleButton("##phclose", vec2(RW - 36, 34))
    local h2 = ui.itemHovered()
    ui.drawRectFilled(vec2(18, by), vec2(RW - 18, by + 34), h2 and rgbm(0.85, 0.22, 0.24, 0.95) or rgbm(0.05, 0.06, 0.09, 0.86), 10)
    ui.drawRect(vec2(18, by), vec2(RW - 18, by + 34), rgbm(0.9, 0.3, 0.32, 0.7), 10, nil, 1.2)
    do  -- أيقونة زرّ التشغيل/الإطفاء
      local px, py = 36, by + 17
      local cc = h2 and CW or rgbm(0.95, 0.45, 0.45, 1)
      ui.drawCircle(vec2(px, py), 8, cc, 20, 1.7)
      ui.drawRectFilled(vec2(px - 1, py - 11), vec2(px + 1, py - 3), cc, 1)
    end
    dwBox("إغلاق وضع التصوير", 13, 50, by + 8, RW - 70, 18, h2 and CW or rgbm(0.95, 0.6, 0.6, 1))
    if cl2 then uSt.photoOff() end
  end)
end

