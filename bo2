        ui.drawRectFilled(vec2(66, ry + 9), vec2(112, ry + 27), rgbm(0, 0, 0, 0.35), 6)
        dwBox(math.floor(c.speedKmh or 0) .. " كم", 10, 66, ry + 10, 46, 16, CY)
        dwRightBox(n, 13, 118, ry, (axr - 26) - 124, 36, sel and CW or rgbm(0.82, 0.85, 0.9, 1))
        if cl then selI = i end
        k = k + 1
      end
    end
    if k == 0 then dwBox("لا يوجد لاعبين متصلين", 12, 0, 14, ww, 20, CDm) end
    ui.dummy(vec2(1, k * 40 + 8))
  end)
  -- how far behind the target you land (your call)
  dwRightBox("المسافة بينك وبينه: " .. math.floor(stor.tpDist) .. " متر", 12, X, togY - 44, W, 16, CY)
  ui.setCursor(vec2(X, togY - 26)); ui.setNextItemWidth(W)
  -- 5m floor: closer than that and you land on top of him, which is a collision, not a teleport.
  stor.tpDist = math.max(5, math.floor(ui.slider("##tpdist", math.max(5, stor.tpDist), 5, 40, "%.0f m")))
  tpM = segToggle(X, togY, W, togH, { "فوري", "بنفس السرعة" }, tpM)
  local can = selI >= 1 and tmr.r <= 0
  if bigButton(X, btnY, W, btnH, "انتقال", can and ACC or rgbm(0.28, 0.30, 0.36, 1), "##tpgo") and can then
    local c = ac.getCar(selI)
    if c and c.isConnected then
      -- كان يُمرَّر i (متغيّر من حلقة سابقة) فينتقل اللاعب إلى نفسه
      uSt.tpRequest(selI, tpM ~= 2)
      tmr.r = tmr.l
    end
  end
end

local function drawGrip(X, Y, W, H)
  sectionTitle("تحكّم السيارة", X, Y, W)
  ui.setCursor(vec2(X, Y + 32))
  ui.childWindow("##ctrlwin", vec2(W, H - 32), function()
    local ww = ui.windowWidth() - 20
    local yy = 2
    local function divider() ui.drawLine(vec2(0, yy), vec2(ww, yy), rgbm(1, 1, 1, 0.08), 1); yy = yy + 12 end
    local function subTitle(t) dwRightBox(t, 12, 0, yy, ww, 16, ACC); yy = yy + 22 end
    local function cell(bx, by, bw2, hgt, label, sub, on)
      ui.setCursor(vec2(bx, by))
      local cl = ui.invisibleButton("##c" .. label .. math.floor(by) .. math.floor(bx), vec2(bw2, hgt))
      local hov = ui.itemHovered()
      ui.drawRectFilled(vec2(bx, by), vec2(bx + bw2, by + hgt), on and rgbm(ACC.r, ACC.g, ACC.b, 0.85) or (hov and rgbm(1, 1, 1, 0.1) or rgbm(1, 1, 1, 0.05)), 8)
      if sub then
        dwBox(label, 13, bx, by + 4, bw2, 18, on and DK or CW)
        dwBox(sub, 10, bx, by + 23, bw2, 14, on and rgbm(0, 0, 0, 0.6) or CDm)
      else
        dwBox(label, 13, bx, by, bw2, hgt, on and DK or CW)
      end
      return cl
    end
    local a3 = (ww - 12) / 3

    subTitle("التماسك (زلق ← → خشن)")
    dwBox(string.format("%.2f×", grp), 15, 0, yy - 22, 90, 18, CY)
    dwBox(grp >= 1.4 and "خشن" or (grp <= 0.85 and "زلق" or "عادي"), 12, 94, yy - 22, 90, 18, CDm)
    ui.setCursor(vec2(0, yy)); ui.setNextItemWidth(ww)
    local ng = ui.slider("##grp", grp, 0.75, 1.80, "")
    if math.abs(ng - grp) > 0.001 then grp = ng; applyGrip() end
    yy = yy + 30
    local g3 = (ww - 12) / 3
    if cell(0, yy, g3, 34, "زلق", nil, grp <= 0.85) then grp = 0.75; applyGrip() end
    if cell(g3 + 6, yy, g3, 34, "عادي", nil, grp > 0.85 and grp < 1.4) then grp = 1.0; applyGrip() end
    if cell(2 * (g3 + 6), yy, g3, 34, "خشن", nil, grp >= 1.4) then grp = 1.8; applyGrip() end
    yy = yy + 40
    divider()

    subTitle("المساعدات (للهجوله أطفئها)")
    if cell(0, yy, a3, 44, "TC", tcOn and "تشغيل" or "إطفاء", tcOn) then tcOn = not tcOn; pcall(function() physics.setAssists({ tractionControl = tcOn and 'factory' or 'off' }) end) end
    if cell(a3 + 6, yy, a3, 44, "ABS", absOn and "تشغيل" or "إطفاء", absOn) then absOn = not absOn; pcall(function() physics.setAssists({ abs = absOn and 'factory' or 'off' }) end) end
    if cell(2 * (a3 + 6), yy, a3, 44, "قير أوتو", autoShiftOn and "تشغيل" or "إطفاء", autoShiftOn) then autoShiftOn = not autoShiftOn; pcall(function() physics.setCarAutoShifter(0, autoShiftOn) end) end
    yy = yy + 50

    local adj = false; pcall(function() adj = ac.isTurboWastegateAdjustable(0) end)
    if adj then
      divider()
      subTitle("التيربو")
      dwBox(string.format("%d/10", math.floor(turboLvl + 0.5)), 14, 0, yy - 22, 60, 16, CY)
      ui.setCursor(vec2(0, yy)); ui.setNextItemWidth(ww)
      local nt = ui.slider("##turbo", turboLvl, 0, 10, "")
      if math.abs(nt - turboLvl) > 0.02 then turboLvl = nt; pcall(function() ac.setTurboWastegate(turboLvl / 10) end) end
      yy = yy + 34
    end
    divider()

    subTitle("الأضواء")
    local h2 = (ww - 6) / 2
    if cell(0, yy, h2, 44, "النور", headlightsOn and "تشغيل" or "إطفاء", headlightsOn) then headlightsOn = not headlightsOn; pcall(function() ac.setHeadlights(headlightsOn) end) end
    if cell(h2 + 6, yy, h2, 44, "العالي", highBeamsOn and "تشغيل" or "إطفاء", highBeamsOn) then highBeamsOn = not highBeamsOn; pcall(function() ac.setHighBeams(highBeamsOn) end) end
    yy = yy + 50
    divider()

    subTitle("الإشارات")
    local a4 = (ww - 18) / 4
    local function sig(idx, mode, kind)
      local bx = idx * (a4 + 6)
      ui.setCursor(vec2(bx, yy))
      local cl = ui.invisibleButton("##sig" .. mode, vec2(a4, 40))
      local on = selTurn == mode
      local hov = ui.itemHovered()
      local col = on and DK or CW
      ui.drawRectFilled(vec2(bx, yy), vec2(bx + a4, yy + 40), on and rgbm(ACC.r, ACC.g, ACC.b, 0.85) or (hov and rgbm(1, 1, 1, 0.1) or rgbm(1, 1, 1, 0.05)), 8)
      local cx, cy = bx + a4 * 0.5, yy + 20
      if kind == "left" then
        ui.drawTriangleFilled(vec2(cx - 10, cy), vec2(cx + 6, cy - 10), vec2(cx + 6, cy + 10), col)
      elseif kind == "right" then
        ui.drawTriangleFilled(vec2(cx + 10, cy), vec2(cx - 6, cy - 10), vec2(cx - 6, cy + 10), col)
      elseif kind == "haz" then
        ui.drawLine(vec2(cx, cy - 11), vec2(cx - 12, cy + 9), col, 2)
        ui.drawLine(vec2(cx, cy - 11), vec2(cx + 12, cy + 9), col, 2)
        ui.drawLine(vec2(cx - 12, cy + 9), vec2(cx + 12, cy + 9), col, 2)
        ui.drawLine(vec2(cx, cy - 3), vec2(cx, cy + 3), col, 2)
        ui.drawCircleFilled(vec2(cx, cy + 6), 1.5, col, 6)
      else
        dwBox("إطفاء", 13, bx, yy, a4, 40, col)
      end
      if cl then selTurn = mode; pcall(function() ac.setTurningLights(mode) end) end
    end
    sig(0, 1, "left")
    sig(1, 2, "right")
    sig(2, 3, "haz")
    sig(3, 0, "off")
    yy = yy + 46
    -- (car extras moved to their own dedicated "الاكسترات" tab)

    ui.dummy(vec2(1, yy))
  end)
end

local function drawBoost(X, Y, W, H)
  local car = ac.getCar(0)
  local spd = car and math.floor(car.speedKmh) or 0
  local cardH = 78
  local R = 50
  local stackH = cardH + 28 + R * 2 + 34
  local sy = Y + math.max(0, (H - stackH) * 0.5)
  ui.drawRectFilled(vec2(X, sy), vec2(X + W, sy + cardH), rgbm(1, 1, 1, 0.05), 12)
  ui.drawRect(vec2(X, sy), vec2(X + W, sy + cardH), rgbm(ACC.r, ACC.g, ACC.b, 0.25), 12, nil, 1)
  dwBox("سرعتك الحالية", 10, X, sy + 8, W, 12, CDm)
  dwBox(tostring(spd), 38, X, sy + 20, W, 40, CC)
  dwBox("كم / س", 10, X, sy + 58, W, 12, CDm)
  local pct = math.min(spd / stor.boostTarget, 1)
  local by = sy + cardH - 8
  ui.drawRectFilled(vec2(X + 14, by), vec2(X + W - 14, by + 3), rgbm(0, 0, 0, 0.4), 2)
  if pct > 0 then ui.drawRectFilled(vec2(X + 14, by), vec2(X + 14 + (W - 28) * pct, by + 3), pct >= 1 and CGR or COR, 2) end
  local bcx = X + W * 0.5
  local bcy = sy + cardH + 28 + R
  ui.setCursor(vec2(bcx - R, bcy - R))
  local cl = ui.invisibleButton("##bst", vec2(R * 2, R * 2))
  local hov = ui.itemHovered()
  ui.drawCircle(vec2(bcx, bcy), R + 6, rgbm(1, 1, 1, 0.08), 52, 2)
  if boostTimer > 0 then
    ui.drawCircleFilled(vec2(bcx, bcy), R, rgbm(1, 1, 1, 0.06), 52)
    drawArcProgress(bcx, bcy, R + 6, 1 - boostTimer / BOOST_CD, CPU, 2.4)
    dwBox(string.format("%.1f", boostTimer), 28, bcx - R, bcy - 20, R * 2, 30, CW)
    dwBox("ثانية", 11, bcx - R, bcy + 14, R * 2, 12, CDm)
  else
    local pulse = 0.88 + 0.12 * math.sin(pulseT * 4)
    for s = 4, 1, -1 do ui.drawCircleFilled(vec2(bcx, bcy), R + s * 3, rgbm(COR.r, COR.g, COR.b, 0.06 / s), 52) end
    local col = hov and rgbm(1, 0.72, 0.24, 1) or rgbm(COR.r * pulse, COR.g * pulse, COR.b * pulse, 1)
    ui.drawCircleFilled(vec2(bcx, bcy), R, col, 52)
    ui.drawCircle(vec2(bcx, bcy), R, rgbm(1, 1, 1, 0.28), 52, 2)
    dwBox("BOOST", 16, bcx - R, bcy - 8, R * 2, 18, DK)
    if cl then doBoost() end
  end
  -- Say what this button will actually do: the player's own target, and the right verb for the
  -- mode. It used to always read "انطلق فوراً إلى 250" while the line below it said 120.
  dwBox(string.format(stor.boostMode == 2 and "تسارع إلى %d كم/س  ·  زر B" or "انطلق فوراً إلى %d كم/س  ·  زر B",
    math.min(stor.boostTarget, BOOST_TARGET)), 12, X, bcy + R + 14, W, 16, CC)
  -- ⚙️ your boost, your rules
  -- The block below is ~132px tall (label+toggle+2×(label+slider)). Anchor it so the last
  -- slider lands inside the content area — at H-108 it ran 20px past the bottom and sat on
  -- top of the footer's "اضغط M للإغلاق".
  local cy2 = Y + H - 140
  dwRightBox("نوع البوست:", 12, X, cy2, W, 16, CY)
  stor.boostMode = segToggle(X, cy2 + 20, W, 28, { "فوري", "واقعي (تسارع)" }, stor.boostMode)
  -- hard ceiling at BOOST_TARGET (250): above that the car just spins out / hits things.
  dwRightBox("أقصى سرعة: " .. math.floor(stor.boostTarget) .. " كم/س  (الحد " .. BOOST_TARGET .. ")", 11, X, cy2 + 54, W, 14, CDm)
  ui.setCursor(vec2(X, cy2 + 70)); ui.setNextItemWidth(W)
  stor.boostTarget = math.min(math.floor(ui.slider("##btgt", math.min(stor.boostTarget, BOOST_TARGET), 80, BOOST_TARGET, "%.0f")), BOOST_TARGET)
  if stor.boostMode == 2 then
    dwRightBox("قوة التسارع: " .. math.floor(stor.boostAccel) .. " كم/س بالثانية", 11, X, cy2 + 92, W, 14, CDm)
    ui.setCursor(vec2(X, cy2 + 108)); ui.setNextItemWidth(W)
    stor.boostAccel = math.floor(ui.slider("##bacc", stor.boostAccel, 15, 200, "%.0f"))
  end

end

local function drawSkin(X, Y, W, H)
  sectionTitle("سكنات السيارة", X, Y, W)
  local byH = 30
  local byY = Y + H - byH
  local gridY = Y + 34
  local gridH = (byY - 8) - gridY
  ui.setCursor(vec2(X, gridY))
  ui.childWindow("##skg", vec2(W, gridH), function()
    local ww = ui.windowWidth() - 14
    if #_carSkins == 0 then dwBox("لا توجد سكنات", 13, 0, 14, ww, 20, CY); return end
    local cols = 2
    local cw = (ww - 8 - (cols - 1) * 6) / cols
    local ch = cw * 0.5
    for i, skin in ipairs(_carSkins) do
      local col = (i - 1) % cols
      local row = math.floor((i - 1) / cols)
      local cx = 3 + col * (cw + 6)
      local cyy = row * (ch + 20)
      local sel = _currentSkin == skin.name
      ui.setCursor(vec2(cx, cyy))
      local cl = ui.invisibleButton("##sk" .. i, vec2(cw, ch + 16))
      local hov = ui.itemHovered()
      local pp = _carDir .. '/skins/' .. skin.name .. '/preview.jpg'
      if ui.isImageReady(pp) then
        ui.setCursor(vec2(cx, cyy)); ui.image(pp, vec2(cw, ch))
      else
        ui.decodeImage(pp)
        ui.drawRectFilled(vec2(cx, cyy), vec2(cx + cw, cyy + ch), rgbm(1, 1, 1, 0.05), 8)
        dwBox("...", 12, cx, cyy, cw, ch, CDm)
      end
      if sel then ui.drawRect(vec2(cx, cyy), vec2(cx + cw, cyy + ch), ACC, 8, nil, 2.5)
      elseif hov then ui.drawRect(vec2(cx, cyy), vec2(cx + cw, cyy + ch), rgbm(1, 1, 1, 0.4), 8, nil, 1.5)
      else ui.drawRect(vec2(cx, cyy), vec2(cx + cw, cyy + ch), rgbm(1, 1, 1, 0.12), 8, nil, 1) end
      if hov and ui.isImageReady(pp) then                       -- big preview while hovering
        pcall(function() ui.tooltip(function() ui.image(pp, vec2(320, 180)) end) end)
      end
      dwBox(skin.name, 9, cx, cyy + ch + 1, cw, 14, sel and ACC or CDm)
      if cl and skin.name ~= _currentSkin then
        doApplySkin(skin.name, 0)
        pcall(function() _syncSkin({ skin = skin.name, oldSkin = _currentSkin }, true) end)
        -- تحميل نسيج السكن غير متزامن: نُعيد تطبيقه لثانيتين حتى يلتقط
        -- النسيج بعد اكتمال تحميله، وإلا بقي اللون القديم ظاهراً تحته.
        uSt.skinRetryName, uSt.skinRetryUntil, uSt.skinRetryAt = skin.name, pulseT + 2.0, 0
        _currentSkin = skin.name
      end
    end
    ui.dummy(vec2(1, math.ceil(#_carSkins / 2) * (ch + 20) + 4))
  end)
  local bw = (W - 8) / 2
  if bigButton(X, byY, bw, byH, "الأصلي", rgbm(0.28, 0.30, 0.34, 1), "##skdef") then
    doApplySkin(_originalSkin, 0)
    pcall(function() _syncSkin({ skin = _originalSkin, oldSkin = _currentSkin }, true) end)
    uSt.skinRetryName, uSt.skinRetryUntil, uSt.skinRetryAt = _originalSkin, pulseT + 2.0, 0
    _currentSkin = _originalSkin
  end
  if bigButton(X + bw + 8, byY, bw, byH, "عشوائي", ACC, "##skrnd") then
    local r = _carSkins[math.random(#_carSkins)]
    if r then
      doApplySkin(r.name, 0)
      pcall(function() _syncSkin({ skin = r.name, oldSkin = _currentSkin }, true) end)
      _currentSkin = r.name
    end
  end
end

local function drawMap(X, Y, W, H)
  sectionTitle("الخريطة الحية", X, Y, W)
  dwRightBox("سحب: تحريك · عجلة: تكبير · دبل كلك: انتقال (لاعب أو أرض)", 10, X, Y + 24, W - 40, 12, CDm)
  local mY = Y + 40
  local mH = H - 40
  ui.setCursor(vec2(X, mY))
  ui.childWindow("##mapc", vec2(W, mH), function()
    local ww, wh = ui.windowWidth(), ui.windowHeight()
    -- تهيئة لقطة الهندسة مرة واحدة: تصوير مسار الحلبة الفعلي من الأعلى = خريطة حية بشكل الشوارع الحقيقي
    if not uSt.lmInit then
      uSt.lmInit = true
      pcall(function()
        uSt.lmShot = ac.GeometryShot(ac.findNodes('trackRoot:yes'), vec2(1024, 1024), 1, false)
        uSt.lmShot:setClippingPlanes(10, 30000)
        uSt.lmShot:setShadersType(render.ShadersType.Simplest)
      end)
      local me0 = ac.getCar(0)
      uSt.lmCam = me0 and vec3(me0.position.x, 0, me0.position.z) or vec3(0, 0, 0)
      uSt.lmZoom, uSt.lmZoomT = 700, 700
      uSt.lmFollow = true
    end
    if not uSt.lmShot then dwBox("الخريطة الحية غير مدعومة بنسختك", 13, 0, 10, ww, 20, CR); return end

    local me = ac.getCar(0)
    if uSt.lmFollow and me then uSt.lmCam.x, uSt.lmCam.z = me.position.x, me.position.z end
    uSt.lmZoom = uSt.lmZoom + (uSt.lmZoomT - uSt.lmZoom) * 0.2
    local gy = me and me.position.y or 0
    local camPos = vec3(uSt.lmCam.x, gy + uSt.lmZoom, uSt.lmCam.z)
    pcall(function() uSt.lmShot:update(camPos, vec3(0, -1, 0), vec3(0, 0, -1), 90) end)

    -- منطقة تفاعلية تغطي الخريطة (سحب/عجلة/دبل كلك)
    ui.setCursor(vec2(0, 0))
    ui.invisibleButton("##lmarea", vec2(ww, wh))
    local hov = ui.itemHovered()
    local dbl = hov and ui.mouseDoubleClicked(ui.MouseButton.Left)
    ui.drawImage(uSt.lmShot, vec2(0, 0), vec2(ww, wh))
    ui.drawRect(vec2(0.5, 0.5), vec2(ww - 0.5, wh - 0.5), rgbm(ACC.r, ACC.g, ACC.b, 0.4), 8, nil, 1.2)

    -- إسقاط عالم → شاشة (مربّع اللقطة يُرسم مشدوداً على نافذة قد لا تكون مربعة)
    local view = mat4x4.look(camPos, vec3(0, -1, 0), vec3(0, 0, -1))
    local proj = mat4x4.perspective(math.rad(90), 1.0, 10, 30000)
    local vp = view:mul(proj)
    local function toScr(wpos)
      local o = vp:transform(vec4(wpos.x, wpos.y, wpos.z, 1))
      local u = vec2(o.x, -o.y) / o.w / 2 + 0.5
      return vec2(u.x * ww, u.y * wh), (u.x >= 0 and u.x <= 1 and u.y >= 0 and u.y <= 1)
    end

    -- سحب لتحريك الخريطة (يوقف التتبّع)
    local mp = ui.mouseLocalPos()
    if hov and ui.mouseDown(ui.MouseButton.Left) then
      if uSt.lmLast then
        local sc = uSt.lmZoom / wh * 2
        uSt.lmCam.x = uSt.lmCam.x - (mp.x - uSt.lmLast.x) * sc
        uSt.lmCam.z = uSt.lmCam.z - (mp.y - uSt.lmLast.y) * sc
        if (mp - uSt.lmLast):length() > 1 then uSt.lmFollow = false end
      end
      uSt.lmLast = vec2(mp.x, mp.y)
    else uSt.lmLast = nil end
    -- عجلة: تكبير نحو الماوس
    local w = hov and ac.getUI().mouseWheel or 0
    if w ~= 0 then
      local prev = uSt.lmZoomT
      uSt.lmZoomT = math.max(80, math.min(9000, uSt.lmZoomT * (w > 0 and 1 / 1.3 or 1.3)))
      local ds = (uSt.lmZoomT - prev) / wh * 2
      uSt.lmCam.x = uSt.lmCam.x - (mp.x - ww * 0.5) * ds
      uSt.lmCam.z = uSt.lmCam.z - (mp.y - wh * 0.5) * ds
      uSt.lmFollow = false
    end

    -- اللاعبون: سهم لي (بلون الأكسنت) ونقاط للبقية + اسم عند التمرير + دبل كلك انتقال
    local sim2 = ac.getSim()
    local hovCar, hovP = nil, nil
    if sim2 then
      for i = 0, sim2.carsCount - 1 do
        local c = ac.getCar(i)
        -- لا نستبعد بسبب إخفاء اللافتة: نحن نخفيها عمداً للوحتنا،
        -- وكان هذا يخفي بوتات التطويف عن الخريطة.
        if c and (c.isConnected or c.isAIControlled) then
          local p, vis = toScr(c.position)
          if vis then
            local mine = (i == 0)
            local col = mine and ACC or CW
            local d = vec2(c.look.x, c.look.z)
            if d:length() > 1e-3 then d = d / d:length() else d = vec2(0, -1) end
            local sz2 = mine and 9 or 6
            local pr = vec2(-d.y, d.x)
            ui.drawTriangleFilled(p + d * sz2, p - d * sz2 * 0.6 + pr * sz2 * 0.6, p - d * sz2 * 0.6 - pr * sz2 * 0.6, col)
            if not mine and (mp - p):length() < 14 then hovCar, hovP = i, p end
          end
        end
      end
    end
    if hovCar then
      local nm = ac.getDriverName(hovCar) or "?"
      local tw = 12 + #nm * 8
      ui.drawRectFilled(vec2(hovP.x + 10, hovP.y - 26), vec2(hovP.x + 10 + tw, hovP.y - 4), rgbm(0, 0, 0, 0.9), 5)
      dwBox(nm, 12, hovP.x + 10, hovP.y - 24, tw, 18, CW)
      if dbl then pcall(function() uSt.tpRequest(hovCar) end) end
    elseif dbl then
      -- دبل كلك على الأرض: شعاع من كاميرا الخريطة لنقطة الضغط ثم انتقال
      pcall(function()
        local u, v = mp.x / ww, mp.y / wh
        local p1 = proj:inverse():transformPoint(vec3(2 * u - 1, 1 - 2 * v, 0.5))
        local dir = view:inverse():transformVector(p1):normalize()
        local hitD = physics.raycastTrack(camPos, dir, 30000)
        if hitD and hitD > 0 and hitD < 30000 then
          local wp = camPos + dir * hitD
          physics.setCarVelocity(0, vec3(0, 0, 0))
          physics.setCarPosition(0, wp + vec3(0, 0.4, 0), vec3(-(me and me.look.x or 0), 0, -(me and me.look.z or 1)))
          ghostStart()
        end
      end)
    end
    -- زر توسيط عليّ (يرجّع التتبّع)
    if bigButton(8, wh - 34, 110, 26, uSt.lmFollow and "● يتبعك" or "توسيط عليّ", uSt.lmFollow and rgbm(0.2, 0.5, 0.36, 1) or rgbm(0.28, 0.30, 0.36, 1), "##lmfollow") then
      uSt.lmFollow = true
    end
    dwLeftBox(string.format("زوم %d", math.floor(uSt.lmZoom)), 11, ww - 90, wh - 30, 80, 16, CDm)
  end)
end
local function drawTime(X, Y, W, H)
  local stackH = 40 + 60 + 40 + 46 + 36
  local sy = Y + math.max(0, (H - stackH) * 0.5)
  sectionTitle("وقتك الخاص", X, sy, W); sy = sy + 40
  local hh = math.floor(timeHour) % 24
  local mm = math.floor((timeHour % 1) * 60)
  -- ساعة كبيرة + وصف الوقت
  dwBox(string.format("%02d:%02d", hh, mm), 46, X, sy, W, 52, timeSynced and CDm or CC)
  do
    local lbl = "ليل"
    if hh >= 5 and hh < 7 then lbl = "فجر" elseif hh >= 7 and hh < 11 then lbl = "صباح"
    elseif hh >= 11 and hh < 15 then lbl = "ظهر" elseif hh >= 15 and hh < 18 then lbl = "عصر"
    elseif hh >= 18 and hh < 20 then lbl = "مغرب" end
    dwBox(lbl, 13, X, sy + 50, W, 16, CY)
  end
  sy = sy + 74

  -- شريط زمني متدرّج: ليل ← فجر ← نهار ← مغرب ← ليل
  do
    local BH = 26
    local segs = 96
    for k = 0, segs - 1 do
      local t0 = k / segs
      local hx = t0 * 24
      local r, g, b
      if hx < 5 then r, g, b = 0.05, 0.07, 0.16
      elseif hx < 7 then local f = (hx - 5) / 2; r, g, b = 0.05 + f * 0.85, 0.07 + f * 0.38, 0.16 + f * 0.18
      elseif hx < 9 then local f = (hx - 7) / 2; r, g, b = 0.90 - f * 0.20, 0.45 + f * 0.30, 0.34 + f * 0.40
      elseif hx < 16 then r, g, b = 0.36, 0.68, 0.98
      elseif hx < 18 then local f = (hx - 16) / 2; r, g, b = 0.36 + f * 0.56, 0.68 - f * 0.22, 0.98 - f * 0.62
      elseif hx < 20 then local f = (hx - 18) / 2; r, g, b = 0.92 - f * 0.62, 0.46 - f * 0.30, 0.36 - f * 0.16
      else local f = (hx - 20) / 4; r, g, b = 0.30 - f * 0.25, 0.16 - f * 0.09, 0.20 - f * 0.04 end
      local x0 = X + (W * k) / segs
      local x1 = X + (W * (k + 1)) / segs + 1
      ui.drawRectFilled(vec2(x0, sy), vec2(x1, sy + BH), rgbm(r, g, b, 1), 0)
    end
    ui.drawRect(vec2(X, sy), vec2(X + W, sy + BH), rgbm(1, 1, 1, 0.14), 7, nil, 1)
    -- علامات الساعات
    for k = 0, 24, 3 do
      local px = X + W * (k / 24)
      ui.drawLine(vec2(px, sy + BH - 7), vec2(px, sy + BH), rgbm(1, 1, 1, 0.35), 1)
      if k > 0 and k < 24 then dwBox(tostring(k), 9, px - 10, sy + 3, 20, 12, rgbm(1, 1, 1, 0.55)) end
    end
    -- مؤشّر الوقت الحالي
    local mx = X + W * (math.max(0, math.min(24, timeHour)) / 24)
    ui.drawRectFilled(vec2(mx - 2, sy - 4), vec2(mx + 2, sy + BH + 4), rgbm(1, 1, 1, 0.95), 2)
    ui.drawCircleFilled(vec2(mx, sy - 6), 5, CY, 14)
    -- شريط تحكّم شفاف فوق التدرّج
    ui.setCursor(vec2(X, sy)); ui.setNextItemWidth(W)
    -- نجعل شريط التحكّم شفافاً فوق التدرّج (إن دعمت النسخة تلوين الأنماط)
    local styled = false
    if ui.pushStyleColor and ui.StyleColor and ui.StyleColor.FrameBg then
      styled = pcall(function()
        ui.pushStyleColor(ui.StyleColor.FrameBg, rgbm(0, 0, 0, 0))
        ui.pushStyleColor(ui.StyleColor.FrameBgHovered, rgbm(1, 1, 1, 0.06))
        ui.pushStyleColor(ui.StyleColor.FrameBgActive, rgbm(1, 1, 1, 0.10))
        ui.pushStyleColor(ui.StyleColor.SliderGrab, rgbm(1, 1, 1, 0.85))
        ui.pushStyleColor(ui.StyleColor.SliderGrabActive, rgbm(1, 1, 1, 1))
      end)
    end
    local nt = ui.slider("##tmsl", timeHour, 0, 24, "")
    if styled then pcall(function() ui.popStyleColor(5) end) end
    if math.abs(nt - timeHour) > 0.001 then timeHour = nt; timePending = true end
    if timePending and not ui.itemActive() then sendTime(); timePending = false end
    sy = sy + BH + 18
  end
  local presets = { { "ليل", 1.0 }, { "شروق", 6.5 }, { "نهار", 13.0 }, { "غروب", 18.5 } }
  local bw = (W - 18) / 4
  for i = 1, 4 do
    local bx = X + (i - 1) * (bw + 6)
    ui.setCursor(vec2(bx, sy))
    local cl = ui.invisibleButton("##tp" .. i, vec2(bw, 34))
    local hov = ui.itemHovered()
    ui.drawRectFilled(vec2(bx, sy), vec2(bx + bw, sy + 34), hov and rgbm(1, 1, 1, 0.12) or rgbm(1, 1, 1, 0.05), 8)
    dwBox(presets[i][1], 13, bx, sy, bw, 34, CW)
    if cl then timeHour = presets[i][2]; sendTime() end
  end
  sy = sy + 46
  if bigButton(X, sy, W, 36, "مزامنة مع السيرفر", timeSynced and rgbm(0.28, 0.30, 0.36, 1) or ACC, "##tsync") then
    syncTime()
  end
end

-- أيقونات الطقس — منقولة حرفياً من Team One (uSt.wxIcon)
uSt.wxIconTO = function(id, cx, cy, s, col)
  local function sun(ox, oy, r, rays)
    ui.drawCircleFilled(vec2(ox, oy), r, col, 18)
    if rays then
      for k = 0, 7 do
        local a = k * math.pi / 4
        ui.drawLine(vec2(ox + math.cos(a) * (r + 2), oy + math.sin(a) * (r + 2)),
                    vec2(ox + math.cos(a) * (r + 5), oy + math.sin(a) * (r + 5)), col, 1.4)
      end
    end
  end
  local function cloud(ox, oy, w, a)
    local c = rgbm(col.r, col.g, col.b, a or 1)
    ui.drawCircleFilled(vec2(ox - w * 0.28, oy), w * 0.30, c, 16)
    ui.drawCircleFilled(vec2(ox + w * 0.05, oy - w * 0.16), w * 0.36, c, 16)
    ui.drawCircleFilled(vec2(ox + w * 0.34, oy + w * 0.02), w * 0.26, c, 16)
    ui.drawRectFilled(vec2(ox - w * 0.52, oy), vec2(ox + w * 0.55, oy + w * 0.30), c, w * 0.15)
  end
  local function bands(ox, oy, w, count, alpha)
    for k = 0, count - 1 do
      local ly = oy + k * (s * 0.34)
      ui.drawLine(vec2(ox - w * (k % 2 == 0 and 0.55 or 0.40), ly),
                  vec2(ox + w * (k % 2 == 0 and 0.50 or 0.62), ly),
                  rgbm(col.r, col.g, col.b, alpha), 1.8)
    end
  end
  local function dots(ox, oy, w, count)
    for k = 0, count - 1 do
      local a = k * 2.399
      ui.drawCircleFilled(vec2(ox + math.cos(a) * w * 0.42 * ((k % 3) + 1) / 3,
                               oy + math.sin(a) * w * 0.34 * ((k % 3) + 1) / 3),
                          1.6, col, 8)
    end
  end

  if id == 15 then                    -- صافي
    sun(cx, cy, s * 0.42, true)
  elseif id == 16 then                -- غيوم قليلة
    sun(cx + s * 0.30, cy - s * 0.26, s * 0.30, true)
    cloud(cx - s * 0.16, cy + s * 0.16, s * 0.86)
  elseif id == 17 then                -- غيوم متفرقة
    sun(cx + s * 0.36, cy - s * 0.30, s * 0.26, false)
    cloud(cx - s * 0.10, cy + s * 0.10, s * 1.02)
  elseif id == 18 then                -- غيوم كثيفة
    cloud(cx + s * 0.22, cy - s * 0.18, s * 0.80, 0.55)
    cloud(cx - s * 0.14, cy + s * 0.16, s * 1.00)
  elseif id == 19 then                -- غائم
    cloud(cx, cy, s * 1.15)
  elseif id == 20 or id == 21 then    -- ضباب · ضباب خفيف
    cloud(cx, cy - s * 0.32, s * 0.95, id == 21 and 0.55 or 0.85)
    bands(cx, cy + s * 0.34, s, id == 21 and 2 or 3, id == 21 and 0.45 or 0.80)
  elseif id == 22 then                -- دخان
    for k = 0, 2 do
      local ly = cy - s * 0.40 + k * (s * 0.40)
      ui.drawLine(vec2(cx - s * 0.50, ly), vec2(cx - s * 0.10, ly - s * 0.14), col, 1.9)
      ui.drawLine(vec2(cx - s * 0.10, ly - s * 0.14), vec2(cx + s * 0.30, ly + s * 0.10), col, 1.9)
      ui.drawLine(vec2(cx + s * 0.30, ly + s * 0.10), vec2(cx + s * 0.56, ly - s * 0.04), col, 1.9)
    end
  elseif id == 23 then                -- غبش
    sun(cx, cy - s * 0.10, s * 0.30, false)
    bands(cx, cy + s * 0.30, s, 3, 0.55)
  elseif id >= 1 and id <= 8 then     -- رذاذ · مطر · رعد
    cloud(cx, cy - s * 0.28, s * 1.00, 0.95)
    local nd = (id <= 5) and 3 or 5
    for k = 0, nd - 1 do
      local dx2 = cx - s * 0.44 + k * (s * 0.88 / math.max(1, nd - 1))
      ui.drawLine(vec2(dx2, cy + s * 0.22), vec2(dx2 - s * 0.10, cy + s * 0.58), col, 1.8)
    end
    if id <= 2 then                   -- رعد: صاعقة صفراء
      ui.drawTriangleFilled(vec2(cx + s * 0.10, cy + s * 0.14), vec2(cx - s * 0.14, cy + s * 0.62),
                            vec2(cx + s * 0.04, cy + s * 0.40), rgbm(1, 0.84, 0.28, 1))
    end
  elseif id == 24 then                -- غبار
    bands(cx, cy - s * 0.10, s, 2, 0.40)
    dots(cx, cy + s * 0.18, s, 9)
  else                                -- رمال
    ui.drawTriangleFilled(vec2(cx - s * 0.62, cy + s * 0.46), vec2(cx - s * 0.12, cy - s * 0.10),
                          vec2(cx + s * 0.36, cy + s * 0.46), col)
    ui.drawTriangleFilled(vec2(cx - s * 0.06, cy + s * 0.46), vec2(cx + s * 0.34, cy + s * 0.06),
                          vec2(cx + s * 0.66, cy + s * 0.46), rgbm(col.r, col.g, col.b, 0.70))
    dots(cx, cy - s * 0.26, s, 6)
  end
end

