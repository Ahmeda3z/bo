-- لوحة واحدة للاعب i عند إحداثيات الشاشة (sx, sy) بمقياس sc
uSt.npOne = function(i, sx, sy, a, sc)
  local car = ac.getCar(i)
  if not car then return end
  sc = sc or 1
  local name = ""
  pcall(function() name = ac.getDriverName(i) or "" end)
  name = tostring(name):gsub("0x[%x]+", ""):gsub("[^%w%s*%-%.%@]", ""):gsub("^%s*(.-)%s*$", "%1")
  if name == "" or name == "function" then name = "Driver" end

  local ping = car.ping or 0
  if type(ping) ~= "number" then ping = 0 end
  local pcol = rgbm(0.25, 1, 0.35, 1)
  if ping > 250 then pcol = rgbm(1, 0.28, 0.28, 1) elseif ping > 120 then pcol = rgbm(1, 0.85, 0.25, 1) end

  -- كود الدولة (قد يرجع CSP دالّة بدل نصّ)
  local nat = nil
  pcall(function()
    local v = ac.getDriverNationCode and ac.getDriverNationCode(i) or nil
    if type(v) == "function" then local ok, r = pcall(v); v = ok and r or nil end
    if type(v) ~= "string" or v == "" then
      v = car.driverNationCode
      if type(v) == "function" then local ok, r = pcall(v); v = ok and r or nil end
    end
    if type(v) ~= "string" or v == "" then v = car.nationCode end
    if type(v) == "string" then nat = v end
  end)
  nat = tostring(nat or ""):gsub("[^%a]", ""):upper()
  local flagURL = (uSt.sget("npFlag", true) ~= false) and uSt.npFlagURL(nat) or nil

  local speed = car.speedKmh or 0
  if type(speed) ~= "number" then speed = 0 end
  local av, im = nil, nil
  pcall(function() if uSt.avInpOf then av, im = uSt.avInpOf(i) end end)
  if uSt.sget("npDev", true) == false then im = nil end
  if uSt.sget("npImg", true) == false then av = nil end
  local showPing = (uSt.sget("npPing", true) ~= false)
  local showSpd  = (uSt.sget("npSpd", true) ~= false)
  local showName = (uSt.sget("npName", true) ~= false)
  local showAv   = (uSt.sget("npImg", true) ~= false)
  local distTxt = nil
  if uSt.sget("npDist", false) == true then
    local mc = ac.getCar(0)
    if mc and mc.position and car.position then
      local ddx, ddy, ddz = mc.position.x - car.position.x, mc.position.y - car.position.y, mc.position.z - car.position.z
      distTxt = string.format("%dم", math.floor(math.sqrt(ddx * ddx + ddy * ddy + ddz * ddz) + 0.5))
    end
  end

  -- أبعاد بالمقياس
  local FS = math.max(9, math.floor(14 * sc + 0.5))
  local FS2 = math.max(8, math.floor(11 * sc + 0.5))
  local AVs = math.floor(19 * sc + 0.5)
  local FLW = math.floor(17 * sc + 0.5)
  local FLH = math.floor(12 * sc + 0.5)
  local INPs = math.floor(17 * sc + 0.5)
  local BARw = math.floor(4 * sc + 0.5)
  local BARg = math.floor(2 * sc + 0.5)
  local BARS = 4 * (BARw + BARg)
  local PAD = math.max(3, math.floor(4 * sc + 0.5))
  local GAP = math.max(3, math.floor(5 * sc + 0.5))
  local H = math.floor(30 * sc + 0.5)
  local rowH = math.floor(21 * sc + 0.5)

  local msTxt = tostring(math.floor(ping)) .. "ms"
  local nameW = 40
  pcall(function() nameW = ui.measureDWriteText(name, FS).x end)
  if not showName then nameW = 0 end
  local dW = 0
  if distTxt then pcall(function() dW = ui.measureDWriteText(distTxt, FS2).x end) end
  local msW = 28
  pcall(function() msW = ui.measureDWriteText(msTxt, FS2).x end)

  local W = PAD + (showAv and (AVs + GAP) or 0) + (showName and (nameW + GAP) or 0) + (flagURL and (FLW + GAP) or 0) + ((im ~= nil) and (INPs + GAP) or 0) + (showPing and (BARS + GAP + msW + GAP) or 0) + (distTxt and (dW + GAP) or 0) + PAD
  local L = math.floor(sx - W / 2)
  local T = math.floor(sy - H)
  local rad = math.max(5, math.floor(9 * sc))

  ui.drawRectFilled(vec2(L - 2, T - 2), vec2(L + W + 2, T + H + 2), rgbm(ACC.r, ACC.g, ACC.b, 0.08 * a), rad + 2)
  ui.drawRectFilled(vec2(L, T), vec2(L + W, T + H), rgbm(0.05, 0.055, 0.08, 0.88 * a), rad)
  ui.drawRect(vec2(L, T), vec2(L + W, T + H), rgbm(ACC.r, ACC.g, ACC.b, 0.55 * a), rad, nil, math.max(1, 1.2 * sc))

  -- علامة الحظر: قرص أحمر بشرطة، يمين اللوحة، بلا أي تغيير في تخطيطها
  pcall(function()
    if uSt.blkEff ~= nil and uSt.blkEff(name) then
      local br = math.max(5, 7 * sc)
      local bx = L + W + br + 3 * sc
      local by = T + H * 0.5
      ui.drawCircleFilled(vec2(bx, by), br, rgbm(0.85, 0.16, 0.18, 0.95 * a), 20)
      ui.drawCircle(vec2(bx, by), br, rgbm(1, 1, 1, 0.85 * a), 20, math.max(1, 1.1 * sc))
      ui.drawRectFilled(vec2(bx - br * 0.55, by - br * 0.16), vec2(bx + br * 0.55, by + br * 0.16),
        rgbm(1, 1, 1, 0.95 * a), 1)
    end
  end)

  local x = L + PAD
  local cyM = T + rowH * 0.5
  -- الصورة الدائرية
  local drew = false
  if showAv then
  if av then
    if ui.drawImageRounded then drew = pcall(ui.drawImageRounded, av, vec2(x, cyM - AVs / 2), vec2(x + AVs, cyM + AVs / 2), AVs / 2)
