-- تُرسم بهدف عرض 1920×1080 لتخرج صافية، وتُصغَّر للحجم الذي تختاره.
uSt.drawCam = function(sim)
  if not uSt.sget("camOn", false) then return end
  if not uSt.camShot then
    pcall(function()
      -- sceneRoot يشمل السيارات والسماء والإضاءة، فتظهر الصورة بالوقت والجو الفعلي
      -- (trackRoot وحده كان يعطي مشهداً بلا سيارات ومظلماً كأنه ليل)
      -- نختار جذر المشهد الذي يحوي فعلاً عقداً (سيارات + سماء + إضاءة).
      -- ac.findNodes قد ترجع مجموعة فارغة، فنتحقّق من العدد لا من nil.
      local root, way = nil, "-"
      local function tryRoot(expr, label)
        if root ~= nil then return end
        local ok, n = pcall(expr)
        if not ok or n == nil then return end
        local c = 0
        pcall(function() c = n:size() end)
        if (c or 0) > 0 then root, way = n, label .. "(" .. tostring(c) .. ")" end
      end
      tryRoot(function() return ac.findNodes('sceneRoot:yes') end, 'sceneRoot:yes')
      tryRoot(function() return ac.findNodes('sceneRoot') end, 'sceneRoot')
      tryRoot(function() return ac.findNodes('carsRoot') end, 'carsRoot')
      tryRoot(function() return ac.findNodes('trackRoot:yes') end, 'trackRoot')
      if root == nil then return end
      uSt.camShot = ac.GeometryShot(root, vec2(1920, 1080), 1, true)
      uSt.camShot:setClippingPlanes(0.15, 8000)
      -- الإضاءة/السماء تحتاج شيدرات كاملة؛ Simplest كان يعطي مشهداً مظلماً
      local st = "default"
      pcall(function()
        if render and render.ShadersType then
          if render.ShadersType.Main ~= nil then uSt.camShot:setShadersType(render.ShadersType.Main); st = "Main"
          elseif render.ShadersType.SimplestWithLights ~= nil then uSt.camShot:setShadersType(render.ShadersType.SimplestWithLights); st = "SimpleLights" end
        end
      end)
    end)
    if not uSt.camShot then return end
  end
  local me = ac.getCar(0)
  if not me or not me.position then return end

  local W = math.max(240, math.min(900, tonumber(uSt.sget("camW", 420)) or 420))
  local H = math.floor(W * 9 / 16)
  local sw, sh = sim.windowWidth, sim.windowHeight
  local x = math.floor(sw * 0.5 - W * 0.5) + (tonumber(uSt.sget("camX", 0)) or 0)
  local y = 40 + (tonumber(uSt.sget("camY", 0)) or 0)
  x = math.max(0, math.min(sw - W, x))
  y = math.max(0, math.min(sh - H - 10, y))

  -- اتجاه الكاميرا بالنسبة للسيارة
  local dir = uSt.sget("camDir", 0)
  local fwd = me.look or vec3(0, 0, 1)
  local up  = me.up or vec3(0, 1, 0)
  local rgt = vec3(fwd.z * up.y - fwd.y * up.z, fwd.x * up.z - fwd.z * up.x, fwd.y * up.x - fwd.x * up.y)
  local look, off
  if dir == 1 then
    look = vec3(fwd.x, fwd.y, fwd.z);        off = vec3(fwd.x * 2.2, 1.05, fwd.z * 2.2)
  elseif dir == 2 then
    look = vec3(rgt.x, rgt.y, rgt.z);        off = vec3(rgt.x * 1.2, 1.05, rgt.z * 1.2)
  elseif dir == 3 then
    look = vec3(-rgt.x, -rgt.y, -rgt.z);     off = vec3(-rgt.x * 1.2, 1.05, -rgt.z * 1.2)
  else
    look = vec3(-fwd.x, -fwd.y, -fwd.z);     off = vec3(-fwd.x * 2.4, 1.15, -fwd.z * 2.4)
  end
  -- منظور السيارة من الخارج: الكاميرا تبتعد وتنظر إلى سيارتك
  if uSt.sget("camOut", false) then
    local d = tonumber(uSt.sget("camDist", 7)) or 7
    if dir == 1 then      off = vec3(fwd.x * d, 1.6, fwd.z * d)
    elseif dir == 2 then  off = vec3(rgt.x * d, 1.6, rgt.z * d)
    elseif dir == 3 then  off = vec3(-rgt.x * d, 1.6, -rgt.z * d)
    else                  off = vec3(-fwd.x * d, 1.6, -fwd.z * d) end
    look = vec3(-off.x, -off.y + 0.7, -off.z)
  end
  local camPos = vec3(me.position.x + off.x, me.position.y + off.y, me.position.z + off.z)
  local fov = tonumber(uSt.sget("camFov", 62)) or 62
  pcall(function() uSt.camShot:update(camPos, look, vec3(0, 1, 0), fov) end)

  ui.transparentWindow("kbCam", vec2(x, y), vec2(W, H + 22), true, true, function()
    ui.drawRectFilled(vec2(-3, -3), vec2(W + 3, H + 3), rgbm(ACC.r, ACC.g, ACC.b, 0.10), 12)
    -- GeometryShot لا يرسم السماء، فكانت المنطقة العلوية سوداء.
    -- نرسم تدرّج سماء بلون الوقت الحالي خلف الصورة.
    do
      local hh2 = 12
      pcall(function() hh2 = (ac.getSim().timeHours) or 12 end)
      local day = math.max(0, math.min(1, 1 - math.abs(hh2 - 13) / 7))
      local top = rgbm(0.10 + 0.28 * day, 0.16 + 0.42 * day, 0.30 + 0.60 * day, 1)
      local bot = rgbm(0.18 + 0.55 * day, 0.24 + 0.55 * day, 0.32 + 0.55 * day, 1)
      local segs = 14
      for q = 0, segs - 1 do
        local f0 = q / segs
        local yy0 = H * f0
        local yy1 = H * (q + 1) / segs
        ui.drawRectFilled(vec2(0, yy0), vec2(W, yy1),
          rgbm(top.r + (bot.r - top.r) * f0, top.g + (bot.g - top.g) * f0, top.b + (bot.b - top.b) * f0, 1), 0)
      end
    end
    -- سطوع الصورة: GeometryShot يخرج أفتح من المشهد، فنخفّضه بمقدار قابل للضبط
    do
      local br = (tonumber(uSt.sget("camBright", 78)) or 78) / 100
      pcall(function() ui.drawImage(uSt.camShot, vec2(0, 0), vec2(W, H), rgbm(br, br, br, 1)) end)
    end
    ui.drawRect(vec2(0.5, 0.5), vec2(W - 0.5, H - 0.5), rgbm(ACC.r, ACC.g, ACC.b, 0.6), 10, nil, 1.4)
    local nm = ({ [0] = "خلفية", [1] = "أمامية", [2] = "يمين", [3] = "يسار" })[dir] or "خلفية"
    ui.drawRectFilled(vec2(8, 8), vec2(78, 28), rgbm(0, 0, 0, 0.55), 6)
    dwBox("● " .. nm, 12, 8, 11, 70, 16, CW)
    -- سحب من أي مكان على الصورة لتحريكها، والزاوية السفلية اليمنى للتحجيم
    ui.setCursor(vec2(0, 0))
    ui.invisibleButton("##camdragimg", vec2(W, H - 16))
    if ui.itemHovered() and ui.mouseClicked(ui.MouseButton.Left) then
      local mp = ui.mousePos()
      uSt.camDrag = true; uSt.camMX, uSt.camMY = mp.x, mp.y
      uSt.cam0X, uSt.cam0Y = tonumber(uSt.sget("camX", 0)) or 0, tonumber(uSt.sget("camY", 0)) or 0
    end
    ui.setCursor(vec2(W - 22, H - 22))
    ui.invisibleButton("##camsize", vec2(22, 22))
    local rh = ui.itemHovered()
    ui.drawLine(vec2(W - 18, H - 4), vec2(W - 4, H - 18), rh and CW or rgbm(1, 1, 1, 0.5), 2)
    ui.drawLine(vec2(W - 11, H - 4), vec2(W - 4, H - 11), rh and CW or rgbm(1, 1, 1, 0.5), 2)
    if rh and ui.mouseClicked(ui.MouseButton.Left) then
      local mp = ui.mousePos()
      uSt.camSize = true; uSt.camSX = mp.x; uSt.camSW = W
    end
    if uSt.camSize then
      if ui.mouseDown(ui.MouseButton.Left) then
        local mp = ui.mousePos()
        uSt.sset("camW", math.max(240, math.min(1200, math.floor(uSt.camSW + (mp.x - uSt.camSX)))))
      else uSt.camSize = false end
    end
    ui.setCursor(vec2(0, H))
    ui.invisibleButton("##camdrag", vec2(W, 20))
    if ui.itemHovered() and ui.mouseClicked(ui.MouseButton.Left) then
      local mp = ui.mousePos()
      uSt.camDrag = true; uSt.camMX, uSt.camMY = mp.x, mp.y
      uSt.cam0X, uSt.cam0Y = tonumber(uSt.sget("camX", 0)) or 0, tonumber(uSt.sget("camY", 0)) or 0
    end
    if uSt.camDrag then
      if ui.mouseDown(ui.MouseButton.Left) then
        local mp = ui.mousePos()
        uSt.sset("camX", uSt.cam0X + (mp.x - uSt.camMX))
        uSt.sset("camY", uSt.cam0Y + (mp.y - uSt.camMY))
      else uSt.camDrag = false end
    end
    dwBox("اسحب من هنا لتحريك الكاميرا", 10, 0, H + 3, W, 14, CDm)
  end)
end


