-- رسم نص على كانفس: bgCol = nil يعني خلفية شفافة (القزاز)
-- كانفس نصي يقبل عدة أسطر: افصل بين الأسطر بعلامة |
-- يرجّع (الكانفس، النسبة) — النسبة تحدد ارتفاع اللوح ثلاثي الأبعاد
uSt.czMakeCanvas = function(text, bgCol, fgCol)
  local lines = {}
  for s in tostring(text or ""):gmatch("[^%-]+") do
    lines[#lines + 1] = s
    if #lines >= 4 then break end
  end
  if #lines == 0 then lines = { "" } end
  local n = #lines
  local H = 300 * n
  local cv = nil
  pcall(function()
    cv = ui.ExtraCanvas(vec2(1024, H), 4)
    cv:clear(bgCol or rgbm(0, 0, 0, 0))
    cv:update(function()
      ui.pushDWriteFont('Segoe UI;Weight=Bold')
      for k = 1, n do
        local sz = 190
        local ms = ui.measureDWriteText(lines[k], sz)
        if ms.x > 960 then sz = math.max(40, math.floor(sz * 960 / ms.x)) end
        for ox = -2, 2, 2 do for oy = -2, 2, 2 do
          ui.setCursor(vec2(ox, (k - 1) * 300 + oy))
          ui.dwriteTextAligned(lines[k], sz, ui.Alignment.Center, ui.Alignment.Center, vec2(1024, 300), false, fgCol)
        end end
      end
      ui.popDWriteFont()
    end)
  end)
  return cv, (H / 1024) * 0.9945
end

uSt.czRefresh = function()
  local c = uSt.czCfg()
  -- لوحات الصدام: كانفس لكل لوحة فيها نص
  uSt.czCanvB = uSt.czCanvB or {}
  for k = 1, 3 do
    local bp = c.bpl[k]
    if bp and bp.t ~= "" then
      uSt.czCanvB[k], uSt.czAspB = uSt.czMakeCanvas(bp.t, uSt.czPal[c.bp.bg][2], uSt.czPal[c.bp.fg][2])
    else
      uSt.czCanvB[k] = nil
    end
  end
  if uSt.cz.plateOn and uSt.cz.plateTxt ~= "" then
    uSt.czCanvP, uSt.czAspP = uSt.czMakeCanvas(uSt.cz.plateTxt, uSt.czPal[c.pBg][2], uSt.czPal[c.pFg][2])
  end
  if uSt.cz.glassOn and uSt.cz.glassTxt ~= "" then
    uSt.czCanvG, uSt.czAspG = uSt.czMakeCanvas(uSt.cz.glassTxt, nil, uSt.czPal[c.gFg][2])   -- بلا خلفية
  end
end
-- بث تعديلاتي لبقية اللاعبين عبر الشات (القناة المُثبتة بسيرفرك)
-- طابور إرسال: سطر واحد كل ثانية. إرسال سطرين متلاصقين يجعل السيرفر يسقط
-- الثاني بحماية الإغراق — وهذا سبب تأخّر ظهور لوحات الصدام عند بقية اللاعبين.
uSt.czQ = {}
uSt.czQNext = 0
uSt.czPush = function(line)
  for _, v in ipairs(uSt.czQ) do if v == line then return end end   -- لا نكرر نفس السطر
  uSt.czQ[#uSt.czQ + 1] = line
end
uSt.czPump = function()
  if #uSt.czQ == 0 or pulseT < uSt.czQNext then return end
  local line = table.remove(uSt.czQ, 1)
  uSt.czQNext = pulseT + 1.0
  pcall(function() ac.sendChatMessage(line) end)
end

uSt.czBroadcast = function()
  local c = uSt.czCfg()
  local hid = uSt.cz.hidden
  uSt.czPush(string.format("$TeamKabos_CZ:%s~%s~%d~%d~%d~%.2f~%.2f~%.2f~%.2f~%.2f~%.2f~%.1f",
    (uSt.cz.plateOn and not hid) and uSt.cz.plateTxt or "", (uSt.cz.glassOn and not hid) and uSt.cz.glassTxt or "",
    c.pBg, c.pFg, c.gFg, c.po.y, c.po.z, c.po.w, c.go.y, c.go.z, c.go.w, c.bright))
  local b, L = c.bp, c.bpl
  uSt.czPush(string.format("$TeamKabos_CZB:%d~%d~%.2f~%.2f~%s~%.2f~%.2f~%s~%.2f~%.2f~%s~%.2f~%.2f",
    b.bg, b.fg, b.y, b.z,
    hid and "" or L[1].t, L[1].x, L[1].w, hid and "" or L[2].t, L[2].x, L[2].w,
    hid and "" or L[3].t, L[3].x, L[3].w))
  uSt.czLastBc = pulseT
end

-- استقبال تعديلات لاعب آخر
uSt.czOnMsg = function(ci, body)
  if ci == nil or ci == 0 then return end
  local pt, gt, pbg, pfg, gfg, py, pz, pw, gy, gz, gw, br =
    body:match("^([^~]*)~([^~]*)~(%d+)~(%d+)~(%d+)~([%-%d%.]+)~([%-%d%.]+)~([%-%d%.]+)~([%-%d%.]+)~([%-%d%.]+)~([%-%d%.]+)~([%-%d%.]+)$")
  if not pbg then return end
  local r = uSt.czRemote[ci] or {}
  local np, ng = tonumber(pbg), tonumber(pfg)
  if pt ~= "" and (r.pt ~= pt or r.pbg ~= np or r.pfg ~= ng) then
    r.canvP, r.pAsp = uSt.czMakeCanvas(pt, uSt.czPal[np] and uSt.czPal[np][2] or rgbm(1,1,1,1),
                                           uSt.czPal[ng] and uSt.czPal[ng][2] or rgbm(0,0,0,1))
  elseif pt == "" then r.canvP = nil end
  local ngf = tonumber(gfg)
  if gt ~= "" and (r.gt ~= gt or r.gfg ~= ngf) then
    r.canvG, r.gAsp = uSt.czMakeCanvas(gt, nil, uSt.czPal[ngf] and uSt.czPal[ngf][2] or rgbm(1,1,1,1))
  elseif gt == "" then r.canvG = nil end
  r.pt, r.gt, r.pbg, r.pfg, r.gfg = pt, gt, np, ng, ngf
  r.po = { y = tonumber(py), z = tonumber(pz), w = tonumber(pw) }
  r.go = { y = tonumber(gy), z = tonumber(gz), w = tonumber(gw) }
  r.bright = tonumber(br) or 3.5
  uSt.czRemote[ci] = r
  -- مصافحة: لو أحد بثّ تعديلاته، أبثّ تعديلاتي بعدها بلحظة عشان الداخل الجديد
  -- يشوف عباراتي فوراً بدل ما ينتظر الدورة. (تأخير عشوائي بسيط يمنع التزاحم)
  if (pulseT - (uSt.czLastBc or -99)) > 3 then
    uSt.czHandshakeAt = pulseT + 0.6 + math.random() * 0.8
  end
end

-- استقبال لوحات الصدام من لاعب آخر
uSt.czOnMsgB = function(ci, body)
  if ci == nil or ci == 0 then return end
  local bg, fg, by, bz, t1, x1, w1, t2, x2, w2, t3, x3, w3 =
    body:match("^(%d+)~(%d+)~([%-%d%.]+)~([%-%d%.]+)~([^~]*)~([%-%d%.]+)~([%-%d%.]+)~([^~]*)~([%-%d%.]+)~([%-%d%.]+)~([^~]*)~([%-%d%.]+)~([%-%d%.]+)$")
  if not bg then return end
  local r = uSt.czRemote[ci] or {}
  local nbg, nfg = tonumber(bg), tonumber(fg)
  local txts = { t1, t2, t3 }
  local xs, ws = { tonumber(x1), tonumber(x2), tonumber(x3) }, { tonumber(w1), tonumber(w2), tonumber(w3) }
  r.canvB = r.canvB or {}
  r.bpTxt = r.bpTxt or {}
  for k = 1, 3 do
    if txts[k] ~= "" and (r.bpTxt[k] ~= txts[k] or r.bpBg ~= nbg or r.bpFg ~= nfg) then
      r.canvB[k], r.bAsp = uSt.czMakeCanvas(txts[k], uSt.czPal[nbg] and uSt.czPal[nbg][2] or rgbm(1,1,1,1),
                                                     uSt.czPal[nfg] and uSt.czPal[nfg][2] or rgbm(0,0,0,1))
    elseif txts[k] == "" then r.canvB[k] = nil end
    r.bpTxt[k] = txts[k]
  end
  r.bpBg, r.bpFg = nbg, nfg
  r.bp = { y = tonumber(by), z = tonumber(bz) }
  r.bpl = { { x = xs[1], w = ws[1] }, { x = xs[2], w = ws[2] }, { x = xs[3], w = ws[3] } }
  uSt.czRemote[ci] = r
end
-- لوح نصي ملتصق بالسيارة.
-- (١) الشفافية: نفعّل مزج ألفا قبل الرسم — بدونه الكانفس الشفاف يطلع بخلفية سوداء.
-- (٢) الإخفاء من الأمام: render.quad ما يستبعد الوجه الخلفي، فنحسب موقع الكاميرا
--     بالنسبة للسيارة ونرسم فقط إذا كانت الكاميرا خلفها — أضمن من الاعتماد على الاستبعاد.
uSt.czCamBehind = function(car, thr)
  local cam = nil
  pcall(function() cam = ac.getSim().cameraPosition end)
  if not cam then pcall(function() cam = ac.getCameraPosition() end) end
  if not cam or not car.look then return true end
  local d = cam - car.position
  local L = math.sqrt(d.x * d.x + d.y * d.y + d.z * d.z)
  if L < 0.01 then return true end
  -- مخروط خلفي: تظهر فقط لما تكون الكاميرا خلف السيارة فعلاً (مو من الجنب)،
  -- عشان ما تبان كلوح طايف بالزوايا الجانبية وقت التصوير.
  local dot = (d.x * car.look.x + d.y * car.look.y + d.z * car.look.z) / L
  return dot < (thr or -0.35)
end
uSt.czQuad = function(bt, o, canv)
  if not canv or not o then return end
  local w = o.w
  local h = w * (o.asp or 0.29)
  local b = uSt.czCfg().bright or 3.5
  pcall(function()
    -- وجه واحد فقط، وبترتيب رؤوس يجعل النص يُقرأ صحيحاً من الخلف.
    -- (رسم وجهين كان يضع نصاً معكوساً فوق النص الصحيح = «مخربش»)
    local ox = o.x or 0
    local p1 = bt:transformPoint(vec3(ox + w/2, o.y + h/2, o.z))
    local p2 = bt:transformPoint(vec3(ox - w/2, o.y + h/2, o.z))
    local p3 = bt:transformPoint(vec3(ox - w/2, o.y - h/2, o.z))
    local p4 = bt:transformPoint(vec3(ox + w/2, o.y - h/2, o.z))
    if render.setBlendMode and render.BlendMode then
      pcall(function() render.setBlendMode(render.BlendMode.AlphaBlend) end)
    end
    -- ⚠️ اختبار العمق: بدونه اللوح يُرسم فوق بدن السيارة، فيبان مطبوعاً على الجناح
    -- من الزوايا الجانبية. مع تفعيله، بدن السيارة يحجبه تماماً كأنه ملصوق فعلاً.
    -- تعويض التظليل: اللوح يتأثر بإضاءة المشهد فيطلع اللون غامق (أبيض يصير رصاصي).
    -- معامل السطوع يرجّع اللون لواقعيته — قابل للضبط من شريط «السطوع».
    render.quad(p1, p2, p3, p4, rgbm(b, b, b, 1), canv)
  end)
end

uSt.czDraw3D = function()
  local me = ac.getCar(0)
  if me and me.bodyTransform and (not uSt.cz.hidden) and uSt.czCamBehind(me) then
    local c = uSt.czMap[uSt.czCarKey()]
    if c then
      if uSt.cz.plateOn and uSt.czCanvP then
        uSt.czQuad(me.bodyTransform, { y = c.po.y, z = c.po.z, w = c.po.w, asp = uSt.czAspP }, uSt.czCanvP)
      end
      if uSt.cz.glassOn and uSt.czCanvG then
        uSt.czQuad(me.bodyTransform, { y = c.go.y, z = c.go.z, w = c.go.w, asp = uSt.czAspG }, uSt.czCanvG)
      end
      if uSt.czCanvB then
        for k = 1, 3 do
          local bp = c.bpl[k]
          if uSt.czCanvB[k] and bp then
            uSt.czQuad(me.bodyTransform, { x = bp.x, y = c.bp.y, z = c.bp.z, w = bp.w, asp = uSt.czAspB }, uSt.czCanvB[k])
          end
        end
      end
    end
  end
  for ci, r in pairs(uSt.czRemote) do
    local car = ac.getCar(ci)
    if car and car.isConnected and car.bodyTransform and uSt.czCamBehind(car, -0.08) then
      if r.canvP then uSt.czQuad(car.bodyTransform, { y = r.po.y, z = r.po.z, w = r.po.w, asp = r.pAsp }, r.canvP) end
      if r.canvG then uSt.czQuad(car.bodyTransform, { y = r.go.y, z = r.go.z, w = r.go.w, asp = r.gAsp }, r.canvG) end
      if r.canvB and r.bp and r.bpl then
        for k = 1, 3 do
          if r.canvB[k] and r.bpl[k] then
            uSt.czQuad(car.bodyTransform,
              { x = r.bpl[k].x, y = r.bp.y, z = r.bp.z, w = r.bpl[k].w, asp = r.bAsp }, r.canvB[k])
          end
        end
      end
    end
  end
end
uSt.czSwatches = function(idbase, X, y, W, sel)
  local n = #uSt.czPal
  local cols = 12
  local sw = math.min(26, math.floor((W - (cols - 1) * 4) / cols))
  local pick = nil
  for i = 1, n do
    local r = math.floor((i - 1) / cols)
    local c = (i - 1) % cols
    local x = X + c * (sw + 4)
    local yy = y + r * (sw + 4)
    ui.setCursor(vec2(x, yy))
    if ui.invisibleButton(idbase .. i, vec2(sw, sw)) then pick = i end
    ui.drawCircleFilled(vec2(x + sw / 2, yy + sw / 2), sw / 2 - 1, uSt.czPal[i][2], 18)
    if sel == i then ui.drawCircle(vec2(x + sw / 2, yy + sw / 2), sw / 2, ACC, 18, 2.5)
    elseif ui.itemHovered() then
      ui.drawCircle(vec2(x + sw / 2, yy + sw / 2), sw / 2, CW, 18, 1.5)
      pcall(function() ui.tooltip(function() ui.text(uSt.czPal[i][1]) end) end)
    end
  end
  return pick
end
-- ارتفاع شبكة الألوان (صفّان)
uSt.czSwH = function(W)
  local sw = math.min(26, math.floor((W - 11 * 4) / 12))
  return (sw + 4) * 2
end
-- محتوى التاب داخل نافذة قابلة للتمرير: الأقسام صارت أطول من ارتفاع اللوحة،
-- فكانت لوحات الصدام تُرسم خارج المساحة المرئية ولا تظهر إطلاقاً.
uSt.czBody = function(X, Y, W)
  local c = uSt.czCfg()
  -- استرجاع تلقائي لعباراتك المحفوظة عند أول فتح بعد الدخول
  if not uSt.czLoaded then
    uSt.czLoaded = true
    if c.pTxt ~= "" then uSt.cz.plateTxt = c.pTxt end
    if c.gTxt ~= "" then uSt.cz.glassTxt = c.gTxt end
    if c.pOn or c.gOn then
      uSt.cz.plateOn = c.pOn; uSt.cz.glassOn = c.gOn
      uSt.czRefresh()                      -- نجهّزها بس ما نبثّها: مخفية لين يظهرها بنفسه
      uSt.cz.status = "رجعت عباراتك المحفوظة — اضغط زر الإظهار فوق"
    end
  end
  local y = Y
  -- زر رئيسي: يخفي/يظهر كل شي (اللوحة + كتابة القزاز + لوحات الصدام) لك وللاعبين
