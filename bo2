            row = row .. ',"av":"'..S.esc(av)..'"'
          elseif not uSt.isBot(n, i) then
            row = row .. ',"av":"'..S.esc(LOGO_URL)..'"'
          end
          nm[#nm+1] = row .. '}'
          end
        end
      end
      local pj = table.concat(nm, ',')
      if pj ~= S.pl then S.pl = pj; S.tx('players', '['..pj..']') end
      local st = {}
      for i = 0, math.min(ac.getSim().carsCount - 1, 40) do
        local c = ac.getCar(i)
        if c and (c.isConnected or i == 0) then
          local _, im = uSt.avInpOf(i)
          local imn = (im == 'wheel' and 'دركسون') or (im == 'gamepad' and 'يد تحكم')
                      or (im == 'keyboard' and 'كيبورد') or '—'
          st[#st+1] = '{"i":'..i..',"p":'..math.floor(c.ping or 0)
            ..',"s":'..math.floor(c.speedKmh or 0)..',"m":"'..imn..'"}'
        end
      end
      S.tx('stats', '['..table.concat(st, ',')..']')
      S.pushTypers()
    end

    ui.transparentWindow("kbchathtml", vec2(x, y), vec2(w, h), true, true, function()
      local oki, live = pcall(function() return b:interactive() end)
      if oki and live and S.ready and (pulseT - S.shown) >= 5 then S.warmed = true end

      if oki and live then
        if not S.sized then
          S.sized = true
          local dens = 1
          pcall(function() dens = b:pixelDensity() or 1 end)
          pcall(function() b:resize(vec2(math.max(4, math.floor(w*dens)), math.max(4, math.floor(h*dens)))) end)
          -- المحتوى يتناسب مع حجم النافذة: 860 هو المقاس المرجعي
          pcall(function() b:zoom(math.max(0.8, math.min(1.8, w / 640))) end)
        end
        ui.beginPremultipliedAlphaTexture()
        pcall(function() b:draw(vec2(0,0), vec2(w,h), true) end)
        ui.endPremultipliedAlphaTexture()
        -- إطار متحرّك على الحواف (نفس رسالة الترحيب)
        pcall(function() uSt.cardFx(0, 0, w, h, ACC, 1) end)
      end

      if not S.warmed then
        ui.drawRectFilled(vec2(0,0), vec2(w,h), rgbm(0.04,0.05,0.08,0.94), 12)
        ui.drawRect(vec2(0.5,0.5), vec2(w-0.5,h-0.5), rgbm(ACC.r,ACC.g,ACC.b,0.5), 12, nil, 1.4)
        pcall(function() uSt.cardFx(0, 0, w, h, ACC, 1) end)
        dwBox("جاري تحميل الشات "..string.rep("·", 1 + math.floor(pulseT*2)%4), 17, 0, h*0.5-32, w, 24, CW)
        local bx = w*0.5 - 90
        ui.drawRectFilled(vec2(bx, h*0.5+18), vec2(bx+180, h*0.5+24), rgbm(0,0,0,0.5), 3)
        ui.drawRectFilled(vec2(bx, h*0.5+18), vec2(bx+180*math.min(1,(pulseT-S.shown)/5), h*0.5+24), ACC, 3)
        return
      end

      -- الفأرة: الموضع مُطبَّع 0→1، والأزرار مصفوفة {يسار,يمين,أوسط}
      local sz = vec2(w, h)
      local lp = ui.mouseLocalPos()
      -- السحب من الشريط العلوي: يُعالَج في Lua ولا يُمرَّر للصفحة
      if not ui.mouseDown(ui.MouseButton.Left) then S.mdown = false end
      if S.drag then
        if ui.mouseDown(ui.MouseButton.Left) then
          local mp = ui.mousePos()
          stor.chatOfsX = S.d0x + (mp.x - S.dmx)
          stor.chatOfsY = S.d0y + (mp.y - S.dmy)
        else S.drag = false end
      elseif ui.windowHovered() and lp.y < 30 and lp.x < 150
             and ui.mouseClicked(ui.MouseButton.Left) then
        local mp = ui.mousePos()
        S.drag, S.dmx, S.dmy = true, mp.x, mp.y
        S.d0x, S.d0y = stor.chatOfsX or 0, stor.chatOfsY or 0
      elseif (ui.windowHovered() or S.mdown) and not S.rez then
        if ui.windowHovered() and ui.mouseClicked(ui.MouseButton.Left) then S.mdown = true end
        if not ui.mouseDown(ui.MouseButton.Left) then S.mdown = false end
        local uis = ac.getUI()
        S.btn[1] = uis.isMouseLeftKeyDown
        S.btn[2] = uis.isMouseRightKeyDown
        S.btn[3] = uis.isMouseMiddleKeyDown
        pcall(function()
          b:mouseInput(ui.mouseLocalPos():div(sz), S.btn, uis.mouseWheel, uis.ctrlDown)
          ui.setMouseCursor(b:mouseCursor())
        end)
        uSt.chatBarIdle = pulseT
      end

      -- رمز التحريك: ست نقاط أعلى يسار الشات، وكل الشريط العلوي قابل للسحب
      local gc = (S.drag or (lp.y < 30 and lp.x < (w - 360) and ui.windowHovered()))
                 and ACC or rgbm(1, 1, 1, 0.32)
      for r = 0, 1 do for cdot = 0, 2 do
        ui.drawCircleFilled(vec2(12 + cdot * 5, 11 + r * 6), 1.6, gc, 8)
      end end

      -- مقبض تغيير المقاس: الزاوية السفلية اليسرى (٢٠×٢٠)
      local gx, gy = 0, h - 20
      ui.drawLine(vec2(gx+4, h-4), vec2(gx+16, h-4), rgbm(1,1,1,0.30), 1.6)
      ui.drawLine(vec2(gx+4, h-4), vec2(gx+4, h-16), rgbm(1,1,1,0.30), 1.6)
      if S.rez then
        if ui.mouseDown(ui.MouseButton.Left) then
          local mp = ui.mousePos()
          stor.chatW = math.max(460, math.min(1500, S.r0w - (mp.x - S.rmx)))
          stor.chatHistH = math.max(110, math.min(700, S.r0h + (mp.y - S.rmy)))
          S.sized = false
        else S.rez = false end
      elseif ui.windowHovered() and lp.x < 22 and lp.y > h - 22
             and ui.mouseClicked(ui.MouseButton.Left) then
        local mp = ui.mousePos()
        S.rez, S.rmx, S.rmy = true, mp.x, mp.y
        S.r0w, S.r0h = stor.chatW, stor.chatHistH
      end

      -- interactiveArea أداة فورية: تُستدعى كل فريم، وترجع مقبضاً فقط
      -- بعد ما يضغط اللاعب داخلها. استدعاؤها بشرط كان يعني أنها لا
      -- تُسجَّل أصلاً، فلا مقبض ولا تركيز ولا كتابة.
      local over = ui.windowHovered()
      local kb = nil
      if over or S.kbOn then kb = ui.interactiveArea('kbChatArea', sz) end
      if over then
        pcall(function() b:focus(true) end)
        if ui.mouseClicked(ui.MouseButton.Left) and lp.y > h - 72 then
          S.kbOn = true
        end
      end
      if kb and S.kbOn then
        S.lastUse = pulseT
        pcall(function() b:keyboard(kb) end)
      else
        pcall(function() b:keyboard(nil) end)
        if not over then
          S.kbOn = false
          pcall(function() b:focus(false) end)
        end
      end

      -- بعد دقيقة بلا استخدام يتحوّل إلى زر صغير بدل ما يختفي
      if ui.windowHovered() then S.lastUse = pulseT end
      if (pulseT - math.max(S.lastUse or 0, uSt.chatBarIdle or 0)) > 15 then
        S.min = true
      end
    end)
  end
end

local function drawChatLog(sim)
  if #chatLog == 0 then return end
  if chatBarOpen and not uSt.chatMin then return end
  local recent = {}
  for i = #chatLog, math.max(1, #chatLog - 7), -1 do
    if pulseT - chatLog[i].t < 16 then table.insert(recent, 1, chatLog[i]) end
  end
  if #recent == 0 then return end
  local w = 640
  local nameW = 224
  local textW = w - nameW - 24
  local hs, total = {}, 8
  for i, m in ipairs(recent) do
    local sz = ui.measureDWriteText(m.text, 15, textW)
    hs[i] = m.gif and 104 or math.max(22, math.ceil(sz.y) + 4)
    total = total + hs[i]
  end
  local cy0 = sim.windowHeight - total - 200
  ui.transparentWindow("chatlogTeamKabos", vec2(16, cy0), vec2(w, total), function()
    local lp = ui.mouseLocalPos()
    local over = lp.x >= -6 and lp.x <= (w + 6) and lp.y >= -6 and lp.y <= (total + 6)
    local target = (over or (pulseT - chatLog[#chatLog].t < 4)) and 1 or 0
    uSt.chatReveal = (uSt.chatReveal or 1) + (target - (uSt.chatReveal or 1)) * 0.14
    local rv = uSt.chatReveal
    ui.drawRectFilled(vec2(0, 0), vec2(w, total), rgbm(0, 0, 0, 0.32 * rv), 10)
    local yy = 4
    for i, m in ipairs(recent) do
      local age = pulseT - m.t
      local a = (age > 13 and math.max(0, 1 - (age - 13) / 3) or 1) * rv
      local nc = m.join and rgbm(CGR.r,CGR.g,CGR.b,a) or (m.leave and rgbm(0.85,0.4,0.4,a)) or (m.color and rgbm(m.color.r, m.color.g, m.color.b, a)) or (m.srv and rgbm(CY.r, CY.g, CY.b, a) or rgbm(ACC.r, ACC.g, ACC.b, a))
      local avX = w - 8 - 20
      local hasAv = false
      if not m.srv then pcall(function()
        local ci = carByName(m.rawName)
        local av = ci and uSt.avInpOf(ci) or nil
        if av then
          hasAv = true
          ui.drawRectFilled(vec2(avX, yy + 2), vec2(avX + 20, yy + 22), rgbm(0, 0, 0, 0.35 * a), 6)
          pcall(function() ui.drawImage(av, vec2(avX, yy + 2), vec2(avX + 20, yy + 22), rgbm(1, 1, 1, a)) end)
          ui.drawCircle(vec2(avX + 10, yy + 12), 10, rgbm(ACC.r, ACC.g, ACC.b, 0.5 * a), 16, 1)
        elseif m.rawName and m.rawName ~= "" then
          hasAv = true
          ui.drawCircleFilled(vec2(avX + 10, yy + 12), 10, rgbm(ACC.r, ACC.g, ACC.b, a), 16)
          dwBox(m.rawName:sub(1, 1):upper(), 12, avX, yy + 2, 20, 20, rgbm(0.05, 0.05, 0.07, a))
        end
      end) end
      local rnw = 16
      pcall(function() rnw = ui.measureDWriteText(m.name, 14).x end)
      rnw = math.min(math.max(rnw, 14), nameW - 40)
      local chipR = hasAv and (avX - 6) or (w - 8)
      local chipW = rnw + 16
      local chipL = chipR - chipW
      ui.drawRectFilled(vec2(chipL, yy + 1), vec2(chipR, yy + 21), rgbm(nc.r, nc.g, nc.b, 0.14 * a), 7)
      ui.drawRect(vec2(chipL, yy + 1), vec2(chipR, yy + 21), rgbm(nc.r, nc.g, nc.b, 0.45 * a), 7, nil, 1)
      ui.setCursor(vec2(chipL + 8, yy + 1))
      ui.dwriteTextAligned(m.name, 14, ui.Alignment.End, ui.Alignment.Center, vec2(chipW - 16, 20), false, nc)
      if m.gif then
        uSt.gifDraw(m.gif, vec2(10, yy + 20), vec2(10 + 140, yy + 98), rgbm(1, 1, 1, a))
      else
        ui.setCursor(vec2(8, yy))
        ui.dwriteTextAligned(m.text, 15, ui.Alignment.End, ui.Alignment.Start, vec2(textW, hs[i]), true, rgbm(1, 1, 1, a))
      end
      yy = yy + hs[i]
    end
  end)
end

