uSt.tzMine = function()
  return tonumber(uSt.sget("tzX", 0.36)) or 0.36, tonumber(uSt.sget("tzY", 0.62)) or 0.62,
         tonumber(uSt.sget("tzZ", -0.10)) or -0.10, tonumber(uSt.sget("tzYaw", 0)) or 0,
         tonumber(uSt.sget("tzPitch", 0)) or 0, tonumber(uSt.sget("tzRoll", 0)) or 0,
         tonumber(uSt.sget("tzScale", 100)) or 100, math.floor(tonumber(uSt.sget("tzChar", 1)) or 1)
