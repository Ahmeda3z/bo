  local age = pulseT - notifStart
  if age > uSt.NOTIF_DUR then return end
  local a = math.max(0, math.min(1, math.min(age / 0.5, (uSt.NOTIF_DUR - age) / 0.7)))
  if a <= 0.02 then return end
  local rule = notifIdx <= #RULES_BAN and RULES_BAN[notifIdx] or RULES_ORG[notifIdx - #RULES_BAN]
