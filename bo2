-- ═══ محرّك الفلاتر (منقول من Team One) ═══
-- لون درجة ما على عجلة الألوان (إشباع وسطوع كاملان)
uSt.hueCol = function(h)
  h = (h % 360) / 60
  local x = 1 - math.abs((h % 2) - 1)
  if h < 1 then return rgbm(1, x, 0, 1)
  elseif h < 2 then return rgbm(x, 1, 0, 1)
  elseif h < 3 then return rgbm(0, 1, x, 1)
  elseif h < 4 then return rgbm(0, x, 1, 1)
  elseif h < 5 then return rgbm(x, 0, 1, 1)
  else return rgbm(1, 0, x, 1) end
end

uSt.rgbOf = function(r, g, b)
  local m = rgbm(r, g, b, 1)
  local ok, v = pcall(function() return m.rgb end)
  if ok and v ~= nil then return v end
  return m
end

-- الطريق القديم: كائنات تصحيح تُضاف وتُزال. يُستعمل إن غابت
-- ac.setColorCorrection عن هذا الإصدار من CSP.
uSt.fxDrop = function()
  if uSt.fxObjs == nil then return end
  for i = 1, #uSt.fxObjs do pcall(ac.removeColorCorrection, uSt.fxObjs[i]) end
  uSt.fxObjs = nil
end

uSt.fxApply = function()
  local id = tonumber(stor.fxMode) or 0
  local k = math.max(0, math.min(1, (tonumber(stor.fxPower) or 100) / 100))
  local hu = tonumber(stor.fxHue) or 0
  local sa = (tonumber(stor.fxSat) or 100) / 100
  local br = (tonumber(stor.fxBri) or 100) / 100
  uSt.fxAt = pulseT
  if id == 0 or k < 0.005 then k = 0 end

  if ac.setColorCorrection ~= nil then
    uSt.fxErr = nil
    local ok = pcall(function()
      local cc = ac.setColorCorrection(true, 0)     -- true = الصورة النهائية
      if k > 0 then
        if id == 1 or id == 2 or id == 3 then
          -- ═══ رمادي + لون بأي درجة ═══
          -- مصفوفة الألوان لا تعرف إلا المحاور الثلاثة، فندير عجلة الألوان
          -- حتى تقع الدرجة المطلوبة على محور الأحمر، ثم نُصفّر إشباع
          -- المحورين الآخرين، ثم نُعيد الدوران. فتنجو تلك الدرجة وحدها.
          local base = (id == 1) and 0 or ((id == 2) and 120 or 240)
          local H = (base + hu) % 360
          cc:hue(-H, true):saturation(rgbm(1.9, 0.0, 0.0, k)):hue(H, true)
            :contrast(1 + 0.08 * k)
        elseif id == 4 then
          cc:saturation(1 + 0.50 * k):contrast(1 + 0.18 * k)
            :monotone(uSt.rgbOf(1.00, 0.60, 0.96), 1 - 0.30 * k, 1)
            :bias(rgbm(0.014, 0.000, 0.042, k))
        elseif id == 5 then
          cc:contrast(1 + 0.15 * k):saturation(1 - 0.18 * k)
            :monotone(uSt.rgbOf(0.70, 0.86, 1.00), 1 - 0.24 * k, 1)
            :bias(rgbm(0.022, 0.011, 0.000, k))
        elseif id == 6 then
          cc:saturation(1 - k):contrast(1 + 0.10 * k)
        elseif id == 7 then
          cc:sepia(k):contrast(1 + 0.06 * k)
        elseif id == 8 then
          -- تلفاز قديم: فوسفور مائل للأخضر، ألوان باهتة، وأسود مرفوع
          -- (bias) لأن أنبوب الأشعة لم يكن يعرف الأسود التامّ.
          cc:saturation(1 - 0.38 * k):contrast(1 - 0.10 * k)
            :monotone(uSt.rgbOf(0.88, 0.97, 0.86), 1 - 0.22 * k, 1)
            :bias(rgbm(0.030, 0.038, 0.022, k))
        elseif id == 9 then
          cc:saturation(1 - 0.55 * k):contrast(1 - 0.14 * k)
            :monotone(uSt.rgbOf(0.90, 0.96, 0.90), 1 - 0.15 * k, 1)
            :bias(rgbm(0.040, 0.046, 0.032, k))
        end
      end
      -- ═══ التخصيص اليدوي: يعمل مع أي فلتر وبلا فلتر أيضاً ═══
      -- درجة اللون للفلاتر الثلاثة الأولى استُهلكت في الدوران أعلاه.
      if hu ~= 0 and not (k > 0 and id >= 1 and id <= 3) then cc:hue(hu, true) end
      if math.abs(sa - 1) > 0.005 then cc:saturation(sa) end
      if math.abs(br - 1) > 0.005 then cc:brightness(br) end
    end)
    if not ok then uSt.fxErr = true end
    return
  end

  -- بديل الإصدارات الأقدم
  if ac.addColorCorrection == nil then uSt.fxErr = true; return end
  uSt.fxErr = nil
  uSt.fxDrop()
  local L = {}
  local okb = pcall(function()
    if k > 0 and (id == 1 or id == 2 or id == 3) then
      local base = (id == 1) and 0 or ((id == 2) and 120 or 240)
      local H = (base + hu) % 360
      L[#L + 1] = ac.ColorCorrectionHue({ hue = -H, keepLuminance = true })
      L[#L + 1] = ac.ColorCorrectionSaturationRgb(
        { color = uSt.rgbOf(1 + 0.9 * k, 1 - k, 1 - k) })
      L[#L + 1] = ac.ColorCorrectionHue({ hue = H, keepLuminance = true })
    elseif k > 0 and id == 4 then
      L[#L + 1] = ac.ColorCorrectionMonotoneRgbSatMod(
        { color = uSt.rgbOf(1.00, 0.60, 0.96), saturation = 1 - 0.30 * k, modulation = 1 })
      L[#L + 1] = ac.ColorCorrectionContrast({ value = 1 + 0.18 * k })
    elseif k > 0 and id == 5 then
      L[#L + 1] = ac.ColorCorrectionMonotoneRgbSatMod(
        { color = uSt.rgbOf(0.70, 0.86, 1.00), saturation = 1 - 0.24 * k, modulation = 1 })
      L[#L + 1] = ac.ColorCorrectionContrast({ value = 1 + 0.15 * k })
    elseif k > 0 and id == 6 then
      L[#L + 1] = ac.ColorCorrectionSaturation({ value = 1 - k })
    elseif k > 0 and id == 7 then
      L[#L + 1] = ac.ColorCorrectionSepiaTone({ value = k })
    elseif k > 0 and (id == 8 or id == 9) then
      local d = (id == 8) and 0.22 or 0.15
      L[#L + 1] = ac.ColorCorrectionMonotoneRgbSatMod(
        { color = uSt.rgbOf(0.88, 0.97, 0.86), saturation = 1 - d * k, modulation = 1 })
      L[#L + 1] = ac.ColorCorrectionBiasRgb(
        { color = uSt.rgbOf(0.030 * k, 0.038 * k, 0.022 * k) })
    end
    if hu ~= 0 and not (k > 0 and id >= 1 and id <= 3) then
      L[#L + 1] = ac.ColorCorrectionHue({ hue = hu, keepLuminance = true })
    end
    if math.abs(sa - 1) > 0.005 then L[#L + 1] = ac.ColorCorrectionSaturation({ value = sa }) end
    if math.abs(br - 1) > 0.005 then L[#L + 1] = ac.ColorCorrectionBrightness({ value = br }) end
    for i = 1, #L do ac.addColorCorrection(L[i]) end
  end)
  if okb and #L > 0 then uSt.fxObjs = L else uSt.fxErr = not okb end
end

