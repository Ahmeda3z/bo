uSt.NOTIF_INTERVAL = 600
uSt.NOTIF_DUR = 8
local notifNextAt = 45
local notifStart = -100
local notifIdx = 0
local function drawRulesNotification(sim)
  if pulseT >= notifNextAt then
    notifNextAt = pulseT + uSt.NOTIF_INTERVAL
    notifStart = pulseT
    notifIdx = notifIdx % (#RULES_BAN + #RULES_ORG) + 1
