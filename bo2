uSt.drawBlocked = function(sim)
  if not uSt.blkOpen then return end
  local W, H = 420, 380
  local x = math.floor((sim.windowWidth - W) * 0.5)
  local y = math.floor((sim.windowHeight - H) * 0.5)
  ui.transparentWindow("kbBlocked", vec2(x, y), vec2(W, H), true, true, function()
    ui.drawRectFilled(vec2(0, 0), vec2(W, H), rgbm(0.05, 0.06, 0.09, 0.97), 14)
    ui.drawRect(vec2(0.5, 0.5), vec2(W - 0.5, H - 0.5), rgbm(0.9, 0.32, 0.34, 0.6), 14, nil, 1.4)
    pcall(function() uSt.cardFx(0, 0, W, H, rgbm(0.9, 0.35, 0.36, 1), 1) end)
    dwBox("⛔ المحظورون", 18, 0, 12, W, 24, CW)
    ui.setCursor(vec2(W - 36, 10))
    if ui.invisibleButton("##blkx", vec2(28, 28)) then uSt.blkOpen = false end
    dwBox("✕", 16, W - 36, 13, 28, 22, ui.itemHovered() and CR or CDm)
    local list = {}
    for nm2, v in pairs(uSt.blkLoad()) do if v then list[#list + 1] = nm2 end end
    table.sort(list)
    ui.setCursor(vec2(14, 46))
    ui.childWindow("##blklist", vec2(W - 28, H - 60), function()
      if #list == 0 then dwBox("لا يوجد محظورون", 13, 0, 24, W - 44, 20, CDm); return end
      local yy = 0
      for i = 1, #list do
        local nm2 = list[i]
        local tw = W - 46
        ui.drawRectFilled(vec2(0, yy), vec2(tw, yy + 40), rgbm(1, 1, 1, 0.05), 9)
        ui.drawRectFilled(vec2(0, yy), vec2(4, yy + 40), rgbm(0.9, 0.32, 0.34, 1), 2)
        dwRightBox(nm2, 14, 12, yy + 10, tw - 130, 20, CW)
        ui.setCursor(vec2(tw - 112, yy + 6))
        local cl = ui.invisibleButton("##unblk" .. i, vec2(104, 28))
        local hov = ui.itemHovered()
        ui.drawRectFilled(vec2(tw - 112, yy + 6), vec2(tw - 8, yy + 34),
          hov and rgbm(0.20, 0.72, 0.42, 1) or rgbm(1, 1, 1, 0.08), 8)
        dwBox("إلغاء الحظر", 12, tw - 112, yy + 11, 104, 18, hov and DK or CW)
        if cl then uSt.blkToggle(nm2); break end
        yy = yy + 46
      end
      ui.dummy(vec2(1, yy + 6))
    end)
  end)
end

-- ═══════════ شاشة «تركيب تعزيز» ═══════════
uSt.drawTz = function(X, Y, W, H)
  sectionTitle("تركيب تعزيز", X, Y, W)
  local y = Y + 40
  local on = (uSt.sget("tzOn", false) == true)

  if bigButton(X, y, W, 44, on and "إيقاف التعزيز" or "تركيب التعزيز",
               on and rgbm(0.75, 0.24, 0.26, 1) or ACC, "##tzon") then
    uSt.sset("tzOn", not on)
    pcall(uSt.tzSend)
  end
  y = y + 54
  if not on then
    dwRightBox("اختر راكباً يجلس معك، ويراه بقية اللاعبين.", 13, X, y, W, 20, CDm)
    return
  end

  -- اختيار الشخصية
  dwRightBox("الشخصية", 13, X, y, W, 18, CY); y = y + 24
  do
    local cur = math.floor(tonumber(uSt.sget("tzChar", 1)) or 1)
    local n = #uSt.TZ_CHARS
    local bw = (W - (n - 1) * 8) / n
    for k = 1, n do
      local bx = X + (k - 1) * (bw + 8)
      local sel = (cur == k)
      ui.setCursor(vec2(bx, y))
      local cl = ui.invisibleButton("##tzc" .. k, vec2(bw, 64))
      local hv = ui.itemHovered()
      ui.drawRectFilled(vec2(bx, y), vec2(bx + bw, y + 64),
        sel and rgbm(ACC.r, ACC.g, ACC.b, 0.30) or (hv and rgbm(1, 1, 1, 0.10) or rgbm(1, 1, 1, 0.05)), 10)
      ui.drawRect(vec2(bx, y), vec2(bx + bw, y + 64),
        sel and ACC or rgbm(1, 1, 1, 0.14), 10, nil, sel and 1.8 or 1)
      local t = uSt.tzTex(k)
      if t then pcall(function() ui.drawImage(t, vec2(bx + bw / 2 - 16, y + 6), vec2(bx + bw / 2 + 16, y + 40)) end) end
      dwBox(uSt.TZ_CHARS[k].n, 12, bx, y + 42, bw, 18, sel and CW or CDm)
      if cl then uSt.sset("tzChar", k); pcall(uSt.tzSend) end
    end
    y = y + 74
  end

  local function row(lbl, key, def, mn, mx, fmt)
    dwRightBox(lbl, 13, X, y, W - 120, 18, CY)
    ui.setCursor(vec2(X, y + 20)); ui.setNextItemWidth(W)
    local v = ui.slider("##tz" .. key, tonumber(uSt.sget(key, def)) or def, mn, mx, fmt)
    if v ~= (tonumber(uSt.sget(key, def)) or def) then
      uSt.sset(key, v)
      if (pulseT - (uSt.tzSentAt or -99)) > 0.6 then pcall(uSt.tzSend) end
    end
    y = y + 46
  end

  row("يمين / يسار", "tzX", 0.36, -1.2, 1.2, "%.2f م")
  row("أعلى / أسفل", "tzY", 0.62, -0.5, 1.8, "%.2f م")
  row("أمام / خلف", "tzZ", -0.10, -2.5, 2.5, "%.2f م")
  row("الحجم", "tzScale", 100, 40, 220, "%.0f%%")

  if bigButton(X, y, W, 36, "إعادة الضبط", rgbm(0.30, 0.32, 0.38, 1), "##tzrst") then
    uSt.sset("tzX", 0.36); uSt.sset("tzY", 0.62); uSt.sset("tzZ", -0.10); uSt.sset("tzScale", 100)
    pcall(uSt.tzSend)
  end
  y = y + 44
  dwRightBox("إعداداتك محفوظة ويراها بقية اللاعبين تلقائياً.", 12, X, y, W, 18, CDm)
end
