-- تعطيل تصادم سيارة الآخر لا يعمل في هذي النسخة من CSP، لكن تعطيل تصادم
-- سيارتي أنا يعمل. فحين يقترب محظور نجعل سيارتك «شبحاً» فلا يستطيع صدمك،
-- ونعيدها فور ابتعاده. هذا أقصى ما يمكن فعله من طرف اللاعب بلا سيرفر.
uSt.enforceHidden = function()
  for i, h in pairs(uSt.hidden) do
    if h then
      uSt.hideCar(i, true)
      if physics.disableCarCollisions then
        pcall(function() physics.disableCarCollisions(i, true) end)
      end
    end
  end
end
uSt.applyVisibility = function()
  local anyBlk = false
  pcall(function()
    anyBlk = (next(uSt.blkLoad()) ~= nil) or (uSt.blkBy ~= nil and next(uSt.blkBy) ~= nil)
  end)
  if uSt.speedMode == nil and not anyBlk then return end
  local sim = ac.getSim()
  if not sim then return end
  local known, same = 0, 0
  local me = sim.focusedCar or 0
  for i = 0, sim.carsCount - 1 do
    if i ~= me and i ~= 0 then
      local pm = uSt.peerMode[i]
      local vis = (uSt.speedMode == nil) or (pm == nil) or (pm == uSt.speedMode)
      -- الحظر يمرّ من نفس مسار وضع اللعب: نفس الإخفاء ونفس تعطيل التصادم.
      -- محميّ بالكامل حتى لا يوقف أي خطأ دورة الرسم.
      if vis then
        pcall(function()
          local vn = ac.getDriverName(i)
          if vn ~= nil then
            local k2 = tostring(vn)
            if (uSt.blk ~= nil and uSt.blk[k2]) or (uSt.blkBy ~= nil and uSt.blkBy[k2]) then
              vis = false
            end
          end
        end)
      end
      if pm ~= nil then
        known = known + 1
        if pm == uSt.speedMode then same = same + 1 end
      end
      uSt.hidden[i] = not vis
      uSt.hideCar(i, not vis)
      pcall(function() ac.setDriverVisible(i, vis) end)
      -- في وضع اللوحة الأصلية لا نُخفي اللافتات إطلاقاً (إخفاؤها يشيل
      -- السيارة من خريطة اللعبة)، إلا للمخفيّ فعلاً بوضع اللعب أو الحظر.
      if uSt.sget("npVanilla", false) and vis then
        pcall(function() ac.hideCarLabels(i, false) end)
      else
        pcall(function() ac.hideCarLabels(i, not vis) end)
      end
      if physics.disableCarCollisions then
        pcall(function() physics.disableCarCollisions(i, not vis) end)
      end
    end
  end
  uSt.peersKnown, uSt.peersSame = known, same
end
